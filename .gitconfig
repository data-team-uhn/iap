# Definitions for the custom diff drivers referenced from .gitattributes.
# Git never loads configuration committed inside a repository on its own (it
# could define commands to execute), so enable this file once per clone with:
#   git config --local include.path ../.gitconfig

# TypeScript/JavaScript: show the enclosing declaration in hunk headers
# (exported/top-level declarations, class members, arrow-function constants),
# and split word-diffs on identifiers, numbers and operators instead of
# whitespace runs.
[diff "ts"]
	# Quoted because `;` would otherwise start a config comment mid-pattern
	xfuncname = "^([ \t]*((export|default|declare|abstract|async)[ \t]+)*(function|class|interface|enum|namespace|type)[ \t]+[$A-Za-z_].*|((export|declare)[ \t]+)*(const|let|var)[ \t]+[$A-Za-z_].*|[ \t]+((public|private|protected|static|readonly|override|abstract|get|set|async)[ \t]+)+[$A-Za-z_][$0-9A-Za-z_]*[ \t]*[(<:=].*|[ \t]+[$A-Za-z_][$0-9A-Za-z_]*[(][^;]*[)][ \t]*[:{][ \t]*$)"
	wordRegex = "[$A-Za-z_][$0-9A-Za-z_]*|[0-9][0-9.]*|=>|[?][?]=?|[?][.]|[.][.][.]|[!=]=+|[-+*/%&|^<>]=?|&&|[|][|]|--|[+][+]|[^[:space:]]"

# JCR node type definitions: label hunks with the node type (or namespace
# declaration) they belong to.
[diff "cnd"]
	xfuncname = ^(<[a-zA-Z].*|[[][^]]+[]].*)$
