#
# Copy this file to `.env` in the same folder and fill in KEYCLOAK_CLIENT_SECRET; docker compose
# auto-loads `.env` for both docker-compose.*.yml files. The real `.env` is gitignored (it holds
# the secret) -- keep this template committed. See docs/keycloak-oidc.md.

# Back-channel: IAP (inside the Docker network) reaches Keycloak on its CONTAINER port 8080.
# NOT the host-published 8084 -- that port only exists on the host, not in-network.
BACKEND_KEYCLOAK_REALM_URL=http://keycloak:8080/realms/iap

# Front-channel: the browser on the host reaches Keycloak's published port. This matches
# Keycloak's KC_HOSTNAME, so it is also the issuer the ID token carries.
FRONTEND_KEYCLOAK_REALM_URL=http://localhost:8084/realms/iap

# Defaults to iap-sling when left blank.
KEYCLOAK_CLIENT_ID=

# REQUIRED, no default. Copy from Keycloak -- keycloak_setup.sh prints it at the end.
KEYCLOAK_CLIENT_SECRET=

# Optional -- shown with their built-in defaults; override only if needed.
IAP_PUBLIC_URL=http://localhost:8080
IAP_OAUTH_ENCRYPTION_PASSWORD=devpassword
