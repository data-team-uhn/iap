<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.uhndata.iap</groupId>
    <artifactId>iap-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>iap-build-checks</artifactId>
  <packaging>jar</packaging>
  <name>IAP - Build checks</name>
  <description>Checks over the whole source tree that no single module can make on its own.</description>

  <properties>
    <!-- This module is build tooling: it ships no product code, and the coverage gate is about product code -->
    <jacoco.skip>true</jacoco.skip>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <!--
              A verification, not a test, so it runs in `verify` whether or not tests are enabled. Skipping it
              with -DskipTests would defeat the point: the failure it catches has no earlier symptom, and a build
              that produces an artifact whose content cannot be loaded is worse than one that stops here.
            -->
            <id>check-initial-content</id>
            <phase>verify</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>io.uhndata.iap.build.InitialContentCheckMain</mainClass>
              <arguments>
                <!-- The check reads other modules' sources, so it has to be told where the tree starts -->
                <argument>${maven.multiModuleProjectDirectory}</argument>
              </arguments>
              <!-- `compile` rather than the default `runtime`, which leaves out provided dependencies: the
                   reader needs its JSON-P implementation and its OSGi types to be there as it runs -->
              <classpathScope>compile</classpathScope>
              <skip>${contentcheck.skip}</skip>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- The check's own negative controls read the same tree the check does -->
            <iap.root>${maven.multiModuleProjectDirectory}</iap.root>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <!--
      The content loader itself, and the JSON-P implementation the platform ships with it. Both are
      deliberately the real thing: the point of these checks is to ask the code that will read this
      content whether it can, rather than to describe its rules a second time. Johnzon in particular
      cannot be swapped for another provider - the loader switches on comment support through a
      Johnzon-specific property, which parsson silently ignores.
    -->
    <dependency>
      <groupId>org.apache.sling</groupId>
      <artifactId>org.apache.sling.jcr.contentloader</artifactId>
      <version>3.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.apache.sling</groupId>
      <artifactId>org.apache.sling.commons.johnzon</artifactId>
      <version>2.0.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.json</groupId>
      <artifactId>jakarta.json-api</artifactId>
    </dependency>
    <dependency>
      <groupId>javax.jcr</groupId>
      <artifactId>jcr</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      The reader is a real OSGi component, loaded here on a plain classpath: javac must be able to read its
      @Component annotation, and it reaches for framework types as it runs. Neither is used by these checks; both
      are the cost of asking the actual loader instead of describing it.
    -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.framework</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
    </dependency>
  </dependencies>
</project>
