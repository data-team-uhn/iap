{
  "name": "iap-integration-tests",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end tests driving a real IAP instance through a browser.",
  "license": "Apache-2.0",
  "scripts": {
    "test": "playwright test",
    "check-results": "node support/check-results.mjs",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report ../../../target/e2e-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.5",
    "eslint": "9.24.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
