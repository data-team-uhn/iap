// Keycloak / OIDC sign-in.
//
// Delegates authentication to an external Keycloak instance (an OIDC provider) via the Apache
// Sling OAuth client. That bundle ships an Oak ExternalIdentityProvider (OidcIdentityProvider),
// so a user who signs in through Keycloak is provisioned into Oak by Oak's own DefaultSyncHandler
// and their Keycloak realm roles become Oak group principals that content ACLs can reference.
//
// There are three independent names wired across the configs below; keep them consistent:
//   * connection name "keycloak" -- the OIDC provider connection (OidcConnectionImpl.name,
//     OidcAuthenticationHandler.defaultConnectionName, SlingUserInfoProcessorImpl.connection,
//     and the entry-point query parameter ?c=keycloak).
//   * idp name "keycloak" -- the ExternalIdentityProvider the auth handler registers
//     (OidcAuthenticationHandler.idp == ExternalLoginModuleFactory.idp.name == SlingLoginCookieManager.idpName).
//   * sync handler name "keycloak" -- links the JAAS login module to the sync handler
//     (ExternalLoginModuleFactory.sync.handlerName == DefaultSyncHandler.handler.name).
//
// Bundle versions and the dependency set are taken verbatim from the module's published
// main.slingosgifeature (org.apache.sling.auth.oauth-client 0.1.6), EXCEPT oak-auth-external:
// the published feature pins an older 1.70.0, but IAP already ships a newer one via oak/oak_base.json.
//
// Runtime environment variables (resolved by the configadmin interpolation plugin declared in
// boot.json): KEYCLOAK_BASE_URL, KEYCLOAK_CLIENT_ID, KEYCLOAK_CLIENT_SECRET, IAP_PUBLIC_URL,
// and IAP_OAUTH_ENCRYPTION_PASSWORD. See docs/keycloak-oidc.md.
{
    "bundles":[
        { "id":"com.nimbusds:oauth2-oidc-sdk:11.23.1", "start-order":"24" },
        { "id":"com.nimbusds:nimbus-jose-jwt:10.0.2", "start-order":"24" },
        { "id":"com.nimbusds:content-type:2.3", "start-order":"24" },
        { "id":"com.nimbusds:lang-tag:1.7", "start-order":"24" },
        { "id":"org.apache.servicemix.bundles:org.apache.servicemix.bundles.jcip-annotations:1.0_2", "start-order":"24" },
        { "id":"net.minidev:json-smart:2.5.1", "start-order":"24" },
        { "id":"net.minidev:accessors-smart:2.5.1", "start-order":"24" },
        { "id":"org.ow2.asm:asm:9.7.1", "start-order":"24" },
        { "id":"org.apache.sling:org.apache.sling.commons.crypto:1.1.0", "start-order":"24" },
        { "id":"org.apache.servicemix.bundles:org.apache.servicemix.bundles.jasypt:1.9.3_1", "start-order":"24" },
        { "id":"org.apache.sling:org.apache.sling.auth.oauth-client:0.1.6", "start-order":"25" }
    ],
    "configurations":{
        // --- Token encryption (Sling Commons Crypto) -----------------------------------------
        // The OAuth client encrypts any token it stores in the user's home, and its UserInfo
        // processor holds a mandatory reference to a CryptoService -- so a crypto service must
        // exist even when token storage is disabled. The password is read from an environment
        // variable (its NAME is given here, not its value).
        "org.apache.sling.commons.crypto.jasypt.internal.JasyptRandomIvGeneratorRegistrar~iapoauth":{
            "algorithm":"DRBG"
        },
        "org.apache.sling.commons.crypto.internal.EnvironmentVariablePasswordProvider~iapoauth":{
            "name":"IAP_OAUTH_ENCRYPTION_PASSWORD"
        },
        "org.apache.sling.commons.crypto.jasypt.internal.JasyptStandardPbeStringCryptoService~iapoauth":{
            "algorithm":"PBEWITHHMACSHA512ANDAES_256",
            "names":["iap-oauth"]
        },

        // --- OAuth client token store + login cookie ------------------------------------------
        // Persist tokens in the signed-in user's JCR home. idpName must match the idp name above.
        "org.apache.sling.auth.oauth_client.impl.JcrUserHomeOAuthTokenStore":{
        },
        "org.apache.sling.auth.oauth_client.impl.SlingLoginCookieManager":{
            "idpName":"keycloak"
        },

        // --- The Keycloak connection ----------------------------------------------------------
        // baseUrl points at the realm root; the client derives the authorization/token/userinfo
        // and JWKS endpoints from the realm's OIDC discovery document.
        "org.apache.sling.auth.oauth_client.impl.OidcConnectionImpl~keycloak": {
            "name": "keycloak",
            // frontend for the user:
            "authorizationEndpoint": "$[env:FRONTEND_KEYCLOAK_REALM_URL]/protocol/openid-connect/auth",
            "issuer":                "$[env:FRONTEND_KEYCLOAK_REALM_URL]",
            // backend for IAP<->Keycloak:
            "tokenEndpoint": "$[env:BACKEND_KEYCLOAK_REALM_URL]/protocol/openid-connect/token",
            "jwkSetURL":     "$[env:BACKEND_KEYCLOAK_REALM_URL]/protocol/openid-connect/certs",
            "userInfoUrl":   "$[env:BACKEND_KEYCLOAK_REALM_URL]/protocol/openid-connect/userinfo",
            "clientId": "$[env:KEYCLOAK_CLIENT_ID]",
            "clientSecret": "$[env:KEYCLOAK_CLIENT_SECRET]",
            "scopes": ["openid","profile","email"]
        },

        // --- Claim -> user/group mapping ------------------------------------------------------
        // groupsClaimName must match the Keycloak protocol mapper that projects realm roles into
        // a flat top-level "groups" claim (see docs/keycloak-oidc.md). idpNameInPrincipals=false
        // keeps group principals as the plain role name (e.g. "reader"), which is what the
        // content ACLs are written against; flipping it later would invalidate every ACL.
        "org.apache.sling.auth.oauth_client.impl.SlingUserInfoProcessorImpl":{
            "connection":"keycloak",
            "groupsClaimName":"groups",
            "groupsInIdToken":true,
            "idpNameInPrincipals":false,
            "storeAccessToken":false,
            "storeRefreshToken":false
        },

        // --- The Sling authentication handler -------------------------------------------------
        // path "/" makes it eligible everywhere; idp is the ExternalIdentityProvider name it
        // registers (matched by the external login module below). callbackUri must exactly match
        // a Valid Redirect URI registered on the Keycloak client.
        // path "/" lets extractCredentials validate the sling.oidcauth session cookie on every
        // request (so an OIDC login is recognised app-wide), while the low service.ranking keeps
        // the form handler ahead of this one for requestCredentials -- so unauthenticated users
        // still get the /login gate. The more-specific "/oidc-login" holder wins requestCredentials
        // for the sign-in button regardless of ranking, which is what starts the Keycloak flow.
        "org.apache.sling.auth.oauth_client.impl.OidcAuthenticationHandler~keycloak":{
            "path":["/","/oidc-login"],
            "service.ranking:Integer":"-1000",
            "idp":"keycloak",
            "defaultConnectionName":"keycloak",
            "callbackUri":"$[env:IAP_PUBLIC_URL]/system/sling/oauth/callback",
            "pkceEnabled":true,
            "userInfoEnabled":true
        },

        // --- Oak provisioning: sync handler ---------------------------------------------------
        // Provisions the user on login. Dynamic membership stores the Keycloak roles as
        // rep:externalPrincipalNames instead of creating a local group node per role; those
        // principals are exposed by the ExternalPrincipalConfiguration registered below (and
        // required in oak/oak_base.json's SecurityProviderRegistration). To fall back to full
        // synchronisation (local group nodes), set user.dynamicMembership to false and drop the
        // ExternalPrincipalConfiguration wiring. Synced users live under /home/users/oidc.
        // NOTE: user.propertyMapping keys are Keycloak claim names; verify against a real token.
        "org.apache.jackrabbit.oak.spi.security.authentication.external.impl.DefaultSyncHandler~keycloak":{
            "handler.name":"keycloak",
            "user.dynamicMembership":true,
            "user.expirationTime":"1h",
            "user.membershipExpTime":"1h",
            "user.membershipNestingDepth:Integer":"1",
            "user.pathPrefix":"oidc",
            "user.propertyMapping":["rep:fullname=name","profile/email=email"]
        },

        // --- Oak provisioning: external login module ------------------------------------------
        // Registers the OidcIdentityProvider (idp.name) into the JAAS stack and binds it to the
        // sync handler above (sync.handlerName == DefaultSyncHandler.handler.name). The factory
        // defaults to jaas.controlFlag=SUFFICIENT / jaas.ranking=150, so a local username/password
        // login that this IdP cannot handle simply falls through to Oak's LoginModuleImpl -- i.e.
        // the existing form login keeps working as a fallback during the transition.
        "org.apache.jackrabbit.oak.spi.security.authentication.external.impl.ExternalLoginModuleFactory~keycloak":{
            "idp.name":"keycloak",
            "sync.handlerName":"keycloak"
        },

        // --- Oak provisioning: external principal configuration -------------------------------
        // Exposes the dynamic external role-principals (rep:externalPrincipalNames) to the
        // principal manager so ACLs can reference them. Must also be listed in the
        // SecurityProviderRegistration.requiredServicePids in oak/oak_base.json.
        "org.apache.jackrabbit.oak.spi.security.authentication.external.impl.principal.ExternalPrincipalConfiguration":{
        }
    },

    // Dedicated OIDC trigger. The sign-in button navigates here; because only the OIDC handler
    // covers this path (see its `path` above) while the form handler stays the default elsewhere,
    // hitting it starts the Keycloak round trip without disturbing the /login gate. The oauth
    // client returns the user to this same path afterwards, where this sling:redirect bounces the
    // now-authenticated session on to the app.
    "repoinit:TEXT|true": "@file"
}
