// Files what would have been sent into /CaughtMail instead of delivering it, so that email can be
// exercised without a mail server. It outranks Sling's own mail service rather than replacing it.
//
// This lives in `dev` because that group is included only by the test and demo aggregates: the
// production ones take `core` and nothing else, so a distribution that could be deployed has no
// bundle registering a mail service that swallows mail. That composition IS the safeguard — the
// bundle itself cannot tell what it was deployed into.
{
    "prototype":{
        "id": "${project.groupId}:iap-email-catcher:slingosgifeature:${project.version}"
    }
}
