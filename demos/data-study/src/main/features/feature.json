{
  "bundles": [
    {
      "id": "${project.groupId}:${project.artifactId}:${project.version}",
      // After schemas (27), submissions and the data requirement (28), whose trees this content is loaded into
      "start-order": "30"
    }
  ],
  "configurations": {
    "org.apache.sling.jcr.repoinit.RepositoryInitializer~demo-data-study": {
      "service.ranking:Integer": 400,
      "scripts": [
        // The two people the demo is about. Passwords match the names because this is a demo: it is reached
        // through --demo or the demo integration-test suite, never a real deployment.
        "create group data-requesters \n create group data-stewards",
        "create user demo-researcher with password demo-researcher \n create user demo-steward with password demo-steward",
        "add demo-researcher to group data-requesters \n add demo-steward to group data-stewards"
      ]
    }
  }
}
