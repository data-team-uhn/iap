<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:iap="https://iap.uhndata.io/bpmn"
                  xmlns:sv="http://www.jcp.org/jcr/sv/1.0"
                  id="timeOffRequestDefinitions"
                  targetNamespace="https://iap.uhndata.io/demos/timeOffRequest">
  <bpmn:process id="timeOffRequest" name="Time off request" isExecutable="true">
    <bpmn:startEvent id="requestSubmitted" name="Request submitted">
      <bpmn:outgoing>toBudget</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toBudget" sourceRef="requestSubmitted" targetRef="checkBudget" />
    <bpmn:serviceTask id="checkBudget" iap:handler="checkTimeOffBudget" name="Check the time off budget">
      <bpmn:incoming>toBudget</bpmn:incoming>
      <bpmn:outgoing>toFillIn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toFillIn" sourceRef="checkBudget" targetRef="fillIn" />
    <bpmn:userTask id="fillIn" iap:performers="@creator" iap:hostTag="draft" name="Say when you want to be away">
      <bpmn:incoming>toFillIn</bpmn:incoming>
      <bpmn:outgoing>toApproval</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="toApproval" sourceRef="fillIn" targetRef="approveRequest" />
    <bpmn:userTask id="approveRequest" iap:performers="time-off-approvers" iap:outcomeOptions="approved, rejected" iap:hostTag="submitted" name="Approve the request">
      <bpmn:incoming>toApproval</bpmn:incoming>
      <bpmn:outgoing>toDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="toDecision" sourceRef="approveRequest" targetRef="decision" />
    <!-- Two deadlines on the same task, and the only thing that tells them apart is cancelActivity. This one
         nudges: at two days the request is marked overdue and stays exactly where it is, on the same person's
         desk. The one below gives up. -->
    <bpmn:boundaryEvent id="approvalReminder" name="Waiting too long" attachedToRef="approveRequest"
        cancelActivity="false" iap:hostTag="overdue">
      <bpmn:outgoing>toReminded</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="toReminded" sourceRef="approvalReminder" targetRef="reminded" />
    <bpmn:boundaryEvent id="approvalOverdue" name="Not decided in time" attachedToRef="approveRequest"
        cancelActivity="true">
      <bpmn:outgoing>toExpired</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="toExpired" sourceRef="approvalOverdue" targetRef="requestExpired" />
    <bpmn:exclusiveGateway id="decision" name="Approved?" default="toRejected">
      <bpmn:incoming>toDecision</bpmn:incoming>
      <bpmn:outgoing>toApproved</bpmn:outgoing>
      <bpmn:outgoing>toRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="toApproved" sourceRef="decision" targetRef="requestApproved">
      <!-- extensionElements comes first: tBaseElement declares it ahead of anything tSequenceFlow adds. The
           expression below stays as the human-readable form a BPMN tool shows; the subtree here is what the
           engine evaluates, written as JCR System View so the node names, types and the multi-valued operand
           value all survive. -->
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name">
            <sv:value>cond:SingleCondition</sv:value>
          </sv:property>
          <sv:property sv:name="comparator" sv:type="String">
            <sv:value>equals</sv:value>
          </sv:property>
          <sv:node sv:name="operandA">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="source" sv:type="String">
              <sv:value>variable</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>outcome</sv:value>
            </sv:property>
          </sv:node>
          <sv:node sv:name="operandB">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>approved</sv:value>
            </sv:property>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == 'approved'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toRejected" sourceRef="decision" targetRef="requestRejected" />
    <bpmn:endEvent id="requestApproved" iap:hostTag="approved" name="Time off approved">
      <bpmn:incoming>toApproved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="requestRejected" iap:hostTag="rejected" name="Time off refused">
      <bpmn:incoming>toRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="reminded" name="Reminder sent">
      <bpmn:incoming>toReminded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="requestExpired" iap:hostTag="expired" name="Nobody decided in time">
      <bpmn:incoming>toExpired</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="timeOffRequestDiagram">
    <bpmndi:BPMNPlane id="timeOffRequestPlane" bpmnElement="timeOffRequest">
      <bpmndi:BPMNShape id="requestSubmittedShape" bpmnElement="requestSubmitted">
        <dc:Bounds x="160" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="139" y="223" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="checkBudgetShape" bpmnElement="checkBudget">
        <dc:Bounds x="250" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fillInShape" bpmnElement="fillIn">
        <dc:Bounds x="400" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approveRequestShape" bpmnElement="approveRequest">
        <dc:Bounds x="550" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approvalOverdueShape" bpmnElement="approvalOverdue">
        <dc:Bounds x="582" y="220" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="560" y="263" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approvalReminderShape" bpmnElement="approvalReminder">
        <dc:Bounds x="712" y="240" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="690" y="283" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="remindedShape" bpmnElement="reminded">
        <dc:Bounds x="812" y="240" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="795" y="283" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toRemindedEdge" bpmnElement="toReminded">
        <di:waypoint x="748" y="258" />
        <di:waypoint x="812" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="requestExpiredShape" bpmnElement="requestExpired">
        <dc:Bounds x="582" y="380" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="556" y="423" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decisionShape" bpmnElement="decision" isMarkerVisible="true">
        <dc:Bounds x="705" y="173" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="704" y="143" width="53" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="requestApprovedShape" bpmnElement="requestApproved">
        <dc:Bounds x="822" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="800" y="143" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="requestRejectedShape" bpmnElement="requestRejected">
        <dc:Bounds x="822" y="260" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="802" y="303" width="77" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toExpiredEdge" bpmnElement="toExpired">
        <di:waypoint x="600" y="256" />
        <di:waypoint x="600" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toBudgetEdge" bpmnElement="toBudget">
        <di:waypoint x="196" y="198" />
        <di:waypoint x="250" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toFillInEdge" bpmnElement="toFillIn">
        <di:waypoint x="350" y="198" />
        <di:waypoint x="400" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toApprovalEdge" bpmnElement="toApproval">
        <di:waypoint x="500" y="198" />
        <di:waypoint x="550" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDecisionEdge" bpmnElement="toDecision">
        <di:waypoint x="650" y="198" />
        <di:waypoint x="705" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toApprovedEdge" bpmnElement="toApproved">
        <di:waypoint x="730" y="173" />
        <di:waypoint x="730" y="118" />
        <di:waypoint x="822" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toRejectedEdge" bpmnElement="toRejected">
        <di:waypoint x="730" y="223" />
        <di:waypoint x="730" y="278" />
        <di:waypoint x="822" y="278" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
