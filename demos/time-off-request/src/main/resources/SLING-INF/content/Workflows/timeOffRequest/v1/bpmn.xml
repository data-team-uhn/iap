<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:iap="https://iap.uhndata.io/bpmn"
                  xmlns:sv="http://www.jcp.org/jcr/sv/1.0"
                  id="timeOffRequestDefinitions"
                  targetNamespace="https://iap.uhndata.io/demos/timeOffRequest">
  <bpmn:process id="timeOffRequest" name="Time off request" isExecutable="true">
    <bpmn:startEvent id="requestSubmitted" name="Request raised">
      <bpmn:outgoing>toBudget</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toBudget" sourceRef="requestSubmitted" targetRef="checkBudget" />
    <bpmn:serviceTask id="checkBudget" iap:handler="checkTimeOffBudget" name="Check the time off budget">
      <bpmn:incoming>toBudget</bpmn:incoming>
      <bpmn:outgoing>toFillIn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toFillIn" sourceRef="checkBudget" targetRef="fillIn" />
    <bpmn:userTask id="fillIn" iap:performers="@creator" name="Say when you want to be away">
      <bpmn:incoming>toFillIn</bpmn:incoming>
      <bpmn:outgoing>toApproval</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="toApproval" sourceRef="fillIn" targetRef="markSubmitted" />
    <bpmn:serviceTask id="markSubmitted" iap:handler="addTag" iap:replaceExisting="true" iap:tag="submitted"
        name="Mark it as submitted">
      <bpmn:incoming>toApproval</bpmn:incoming>
      <bpmn:outgoing>toUrgency</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toUrgency" sourceRef="markSubmitted" targetRef="markUrgency" />
    <!-- The answers are final once the request is sent, so it is judged now. The nightly sweep would only
         judge it tonight, and a request sent this morning for tomorrow needs to be seen today. -->
    <bpmn:serviceTask id="markUrgency" name="Note how soon this starts" iap:handler="markTimeOffUrgency">
      <bpmn:incoming>toUrgency</bpmn:incoming>
      <bpmn:outgoing>toApprovalTask</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toApprovalTask" sourceRef="markUrgency" targetRef="approveRequest" />
    <bpmn:userTask id="approveRequest" iap:performers="time-off-approvers" iap:outcomeOptions="approved, rejected" name="Approve the request">
      <bpmn:incoming>toApprovalTask</bpmn:incoming>
      <bpmn:outgoing>toRecordReview</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="toRecordReview" sourceRef="approveRequest" targetRef="recordReview" />
    <!-- The decision is written down before the gateway routes on it, so that it is recorded whichever way the
         request goes. iap:requirement names the approval it answers, since a schema may ask for several. -->
    <bpmn:serviceTask id="recordReview" name="Write the decision down" iap:handler="recordReview"
        iap:requirement="approval">
      <bpmn:incoming>toRecordReview</bpmn:incoming>
      <bpmn:outgoing>toDecision</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toDecision" sourceRef="recordReview" targetRef="decision" />
    <!-- Two deadlines on the same task, and cancelActivity decides what each does. This one nudges: at two
         days the request is marked overdue, and the task stays open for the approvers. The one below gives
         up. -->
    <bpmn:boundaryEvent id="approvalReminder" name="Waiting too long" attachedToRef="approveRequest"
        cancelActivity="false">
      <bpmn:outgoing>toReminded</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="toReminded" sourceRef="approvalReminder" targetRef="reminded" />
    <bpmn:boundaryEvent id="approvalOverdue" name="Not decided in time" attachedToRef="approveRequest"
        cancelActivity="true">
      <bpmn:outgoing>toExpired</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="toExpired" sourceRef="approvalOverdue" targetRef="requestExpired" />
    <bpmn:exclusiveGateway id="decision" name="Approved?" default="toRejected">
      <bpmn:incoming>toDecision</bpmn:incoming>
      <bpmn:outgoing>toApproved</bpmn:outgoing>
      <bpmn:outgoing>toRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="toApproved" sourceRef="decision" targetRef="notifyApproved">
      <!-- The guard the engine evaluates, written as JCR System View so the node names, types and the
           multi-valued operand value all survive -->
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name">
            <sv:value>cond:SingleCondition</sv:value>
          </sv:property>
          <sv:property sv:name="comparator" sv:type="String">
            <sv:value>equals</sv:value>
          </sv:property>
          <sv:node sv:name="operandA">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="source" sv:type="String">
              <sv:value>variable</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>outcome</sv:value>
            </sv:property>
          </sv:node>
          <sv:node sv:name="operandB">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>approved</sv:value>
            </sv:property>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toRejected" sourceRef="decision" targetRef="notifyRejected" />
    <!-- Telling the requester is a step on the diagram, so whoever draws it can move or remove it. Both tasks
         use the same handler, each with its own template. -->
    <bpmn:serviceTask id="notifyApproved" name="Tell them it was approved" iap:handler="notify"
        iap:event="approved" iap:template="/libs/iap/notificationTemplates/timeOffApproved" iap:recipients="@creator"
        iap:urgency="immediate">
      <bpmn:incoming>toApproved</bpmn:incoming>
      <bpmn:outgoing>toApprovedEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toApprovedEnd" sourceRef="notifyApproved" targetRef="requestApproved" />
    <bpmn:serviceTask id="notifyRejected" name="Tell them it was refused" iap:handler="notify"
        iap:event="rejected" iap:template="/libs/iap/notificationTemplates/timeOffRejected" iap:recipients="@creator"
        iap:urgency="immediate">
      <bpmn:incoming>toRejected</bpmn:incoming>
      <bpmn:outgoing>toRejectedEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toRejectedEnd" sourceRef="notifyRejected" targetRef="requestRejected" />
    <bpmn:endEvent id="requestApproved" iap:hostTag="approved" name="Time off approved">
      <bpmn:incoming>toApprovedEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="requestRejected" iap:hostTag="rejected" name="Time off refused">
      <bpmn:incoming>toRejectedEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="reminded" iap:hostTag="overdue" name="Marked overdue">
      <bpmn:incoming>toReminded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="requestExpired" iap:hostTag="expired" name="Nobody decided in time">
      <bpmn:incoming>toExpired</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="timeOffRequestDiagram">
