<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<sub = 'https://iap.uhndata.io/sub/'>
<irv = 'https://iap.uhndata.io/irv/'>

//-----------------------------------------------------------------------------
// PRETOTYPE. A reviewer's notes to self on a submission: feedback that binds
// nothing and that nobody else reads.
[irv:Notes] > sub:Feedback
  - sling:resourceType (STRING) = "irv/Notes" mandatory autocreated protected

  // Principal name of the reviewer the notes belong to
  - owner (STRING) mandatory
