<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:iap="https://iap.uhndata.io/bpmn"
                  xmlns:sv="http://www.jcp.org/jcr/sv/1.0"
                  id="researchProposalDefinitions"
                  targetNamespace="https://iap.uhndata.io/demos/researchProposal">
  <bpmn:process id="researchProposal" name="Research proposal" isExecutable="true">
    <bpmn:startEvent id="created" name="Proposal started">
      <bpmn:outgoing>toChooseRoute</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toChooseRoute" sourceRef="created" targetRef="chooseRoute" />
    <bpmn:userTask id="chooseRoute" iap:performers="@creator" iap:requirement="protocol" name="Say whether there is a protocol">
      <bpmn:incoming>toChooseRoute</bpmn:incoming>
      <bpmn:incoming>toChooseRouteAgain</bpmn:incoming>
      <bpmn:outgoing>toRoute</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="toRoute" sourceRef="chooseRoute" targetRef="route" />
    <bpmn:exclusiveGateway id="route" default="toChooseRouteAgain" name="Is there a protocol?">
      <bpmn:incoming>toRoute</bpmn:incoming>
      <bpmn:outgoing>toUploadProposal</bpmn:outgoing>
      <bpmn:outgoing>toFillQuestionnaire</bpmn:outgoing>
      <bpmn:outgoing>toChooseRouteAgain</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="toUploadProposal" name="Yes" sourceRef="route" targetRef="uploadProposal">
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name">
            <sv:value>cond:SingleCondition</sv:value>
          </sv:property>
          <sv:property sv:name="comparator" sv:type="String">
            <sv:value>equals</sv:value>
          </sv:property>
          <sv:node sv:name="operandA">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="source" sv:type="String">
              <sv:value>answer</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>protocol/hasProtocol</sv:value>
            </sv:property>
          </sv:node>
          <sv:node sv:name="operandB">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>true</sv:value>
            </sv:property>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toFillQuestionnaire" name="No" sourceRef="route" targetRef="fillQuestionnaire">
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name">
            <sv:value>cond:SingleCondition</sv:value>
          </sv:property>
          <sv:property sv:name="comparator" sv:type="String">
            <sv:value>equals</sv:value>
          </sv:property>
          <sv:node sv:name="operandA">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="source" sv:type="String">
              <sv:value>answer</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>protocol/hasProtocol</sv:value>
            </sv:property>
          </sv:node>
          <sv:node sv:name="operandB">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>false</sv:value>
            </sv:property>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toChooseRouteAgain" name="Not answered" sourceRef="route" targetRef="chooseRoute" />
    <bpmn:userTask id="uploadProposal" iap:performers="@creator" iap:requirement="proposal" name="Upload the protocol">
      <bpmn:incoming>toUploadProposal</bpmn:incoming>
      <bpmn:incoming>toUploadInstead</bpmn:incoming>
      <bpmn:incoming>toUploadOnSend</bpmn:incoming>
      <bpmn:outgoing>toStillWithProtocol</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="toStillWithProtocol" sourceRef="uploadProposal" targetRef="stillWithProtocol" />
    <bpmn:exclusiveGateway id="stillWithProtocol" default="toParseProposal" name="Still with a protocol?">
      <bpmn:incoming>toStillWithProtocol</bpmn:incoming>
      <bpmn:outgoing>toQuestionnaireInstead</bpmn:outgoing>
      <bpmn:outgoing>toCheckedBefore</bpmn:outgoing>
      <bpmn:outgoing>toParseProposal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="toQuestionnaireInstead" name="Changed to no" sourceRef="stillWithProtocol" targetRef="fillQuestionnaire">
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name">
            <sv:value>cond:SingleCondition</sv:value>
          </sv:property>
          <sv:property sv:name="comparator" sv:type="String">
            <sv:value>equals</sv:value>
          </sv:property>
          <sv:node sv:name="operandA">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="source" sv:type="String">
              <sv:value>answer</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>protocol/hasProtocol</sv:value>
            </sv:property>
          </sv:node>
          <sv:node sv:name="operandB">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>false</sv:value>
            </sv:property>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toCheckedBefore" name="Already checked" sourceRef="stillWithProtocol" targetRef="isProposal">
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name">
            <sv:value>cond:SingleCondition</sv:value>
          </sv:property>
          <sv:property sv:name="comparator" sv:type="String">
            <sv:value>is not empty</sv:value>
          </sv:property>
          <sv:node sv:name="operandA">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="source" sv:type="String">
              <sv:value>validation</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>is_proposal</sv:value>
            </sv:property>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toParseProposal" sourceRef="stillWithProtocol" targetRef="parseProposal" />
    <bpmn:serviceTask id="parseProposal" iap:handler="parseDocuments" name="Read the protocol">
      <bpmn:incoming>toParseProposal</bpmn:incoming>
      <bpmn:outgoing>toCheckProposal</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toCheckProposal" sourceRef="parseProposal" targetRef="is_proposal" />
    <bpmn:userTask id="is_proposal" iap:performers="iap-extraction" name="Check the upload is a research proposal">
      <bpmn:incoming>toCheckProposal</bpmn:incoming>
      <bpmn:outgoing>toIsProposal</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="toIsProposal" sourceRef="is_proposal" targetRef="isProposal" />
    <bpmn:exclusiveGateway id="isProposal" default="toSendWithProtocol" name="Is it a research proposal?">
      <bpmn:incoming>toCheckedBefore</bpmn:incoming>
      <bpmn:incoming>toIsProposal</bpmn:incoming>
      <bpmn:outgoing>toNotAProposal</bpmn:outgoing>
      <bpmn:outgoing>toSendWithProtocol</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="toNotAProposal" name="Surely not" sourceRef="isProposal" targetRef="notAProposal">
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name">
            <sv:value>cond:SingleCondition</sv:value>
          </sv:property>
          <sv:property sv:name="comparator" sv:type="String">
            <sv:value>equals</sv:value>
          </sv:property>
          <sv:node sv:name="operandA">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="source" sv:type="String">
              <sv:value>validation</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>is_proposal</sv:value>
            </sv:property>
          </sv:node>
          <sv:node sv:name="operandB">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>no</sv:value>
            </sv:property>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toSendWithProtocol" sourceRef="isProposal" targetRef="sendWithProtocol" />
    <bpmn:endEvent id="notAProposal" name="Not a research proposal">
      <bpmn:incoming>toNotAProposal</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="sendWithProtocol" iap:performers="@creator" name="Send for review">
      <bpmn:incoming>toSendWithProtocol</bpmn:incoming>
      <bpmn:incoming>toSendWithProtocolAgain</bpmn:incoming>
      <bpmn:outgoing>toSentWithProtocol</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="toSentWithProtocol" sourceRef="sendWithProtocol" targetRef="sentWithProtocol" />
    <bpmn:exclusiveGateway id="sentWithProtocol" default="toCanSendWithProtocol" name="Still with a protocol?">
      <bpmn:incoming>toSentWithProtocol</bpmn:incoming>
      <bpmn:outgoing>toQuestionnaireOnSend</bpmn:outgoing>
      <bpmn:outgoing>toCanSendWithProtocol</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="toQuestionnaireOnSend" name="Changed to no" sourceRef="sentWithProtocol" targetRef="fillQuestionnaire">
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name">
            <sv:value>cond:SingleCondition</sv:value>
          </sv:property>
          <sv:property sv:name="comparator" sv:type="String">
            <sv:value>equals</sv:value>
          </sv:property>
          <sv:node sv:name="operandA">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="source" sv:type="String">
              <sv:value>answer</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>protocol/hasProtocol</sv:value>
            </sv:property>
          </sv:node>
          <sv:node sv:name="operandB">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>false</sv:value>
            </sv:property>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toCanSendWithProtocol" sourceRef="sentWithProtocol" targetRef="canSendWithProtocol" />
    <bpmn:exclusiveGateway id="canSendWithProtocol" default="toMarkSubmitted" name="Can it be sent?">
      <bpmn:incoming>toCanSendWithProtocol</bpmn:incoming>
      <bpmn:outgoing>toSendWithProtocolAgain</bpmn:outgoing>
      <bpmn:outgoing>toMarkSubmitted</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="toSendWithProtocolAgain" name="A document was rejected, or something is missing" sourceRef="canSendWithProtocol" targetRef="sendWithProtocol">
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name">
            <sv:value>cond:ConditionGroup</sv:value>
          </sv:property>
          <sv:property sv:name="requireAll" sv:type="Boolean">
            <sv:value>false</sv:value>
          </sv:property>
          <sv:node sv:name="proposalRejected">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:SingleCondition</sv:value>
            </sv:property>
            <sv:property sv:name="comparator" sv:type="String">
              <sv:value>equals</sv:value>
            </sv:property>
            <sv:node sv:name="operandA">
              <sv:property sv:name="jcr:primaryType" sv:type="Name">
                <sv:value>cond:ConditionOperand</sv:value>
              </sv:property>
              <sv:property sv:name="source" sv:type="String">
                <sv:value>validation</sv:value>
              </sv:property>
              <sv:property sv:name="value" sv:type="String" sv:multiple="true">
                <sv:value>is_proposal</sv:value>
              </sv:property>
            </sv:node>
            <sv:node sv:name="operandB">
              <sv:property sv:name="jcr:primaryType" sv:type="Name">
                <sv:value>cond:ConditionOperand</sv:value>
              </sv:property>
              <sv:property sv:name="value" sv:type="String" sv:multiple="true">
                <sv:value>no</sv:value>
              </sv:property>
            </sv:node>
          </sv:node>
          <sv:node sv:name="questionnaireRejected">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:SingleCondition</sv:value>
            </sv:property>
            <sv:property sv:name="comparator" sv:type="String">
              <sv:value>equals</sv:value>
            </sv:property>
            <sv:node sv:name="operandA">
              <sv:property sv:name="jcr:primaryType" sv:type="Name">
                <sv:value>cond:ConditionOperand</sv:value>
              </sv:property>
              <sv:property sv:name="source" sv:type="String">
                <sv:value>validation</sv:value>
              </sv:property>
              <sv:property sv:name="value" sv:type="String" sv:multiple="true">
                <sv:value>is_questionnaire</sv:value>
              </sv:property>
            </sv:node>
            <sv:node sv:name="operandB">
              <sv:property sv:name="jcr:primaryType" sv:type="Name">
                <sv:value>cond:ConditionOperand</sv:value>
              </sv:property>
              <sv:property sv:name="value" sv:type="String" sv:multiple="true">
                <sv:value>no</sv:value>
              </sv:property>
            </sv:node>
          </sv:node>
          <sv:node sv:name="incomplete">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:SingleCondition</sv:value>
            </sv:property>
            <sv:property sv:name="comparator" sv:type="String">
              <sv:value>includes</sv:value>
            </sv:property>
            <sv:node sv:name="operandA">
              <sv:property sv:name="jcr:primaryType" sv:type="Name">
                <sv:value>cond:ConditionOperand</sv:value>
              </sv:property>
              <sv:property sv:name="source" sv:type="String">
                <sv:value>tags</sv:value>
              </sv:property>
            </sv:node>
            <sv:node sv:name="operandB">
              <sv:property sv:name="jcr:primaryType" sv:type="Name">
                <sv:value>cond:ConditionOperand</sv:value>
              </sv:property>
              <sv:property sv:name="value" sv:type="String" sv:multiple="true">
                <sv:value>incomplete</sv:value>
              </sv:property>
            </sv:node>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toMarkSubmitted" sourceRef="canSendWithProtocol" targetRef="markSubmitted" />
    <bpmn:userTask id="fillQuestionnaire" iap:performers="@creator" iap:requirement="questionnaire" name="Answer the questionnaire">
      <bpmn:incoming>toFillQuestionnaire</bpmn:incoming>
      <bpmn:incoming>toQuestionnaireInstead</bpmn:incoming>
      <bpmn:incoming>toQuestionnaireOnSend</bpmn:incoming>
      <bpmn:outgoing>toStillWithoutProtocol</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="toStillWithoutProtocol" sourceRef="fillQuestionnaire" targetRef="stillWithoutProtocol" />
    <bpmn:exclusiveGateway id="stillWithoutProtocol" default="toGenerateProposal" name="Still without a protocol?">
      <bpmn:incoming>toStillWithoutProtocol</bpmn:incoming>
      <bpmn:outgoing>toUploadInstead</bpmn:outgoing>
      <bpmn:outgoing>toGenerateProposal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="toUploadInstead" name="Changed to yes" sourceRef="stillWithoutProtocol" targetRef="uploadProposal">
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name">
            <sv:value>cond:SingleCondition</sv:value>
          </sv:property>
          <sv:property sv:name="comparator" sv:type="String">
            <sv:value>equals</sv:value>
          </sv:property>
          <sv:node sv:name="operandA">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="source" sv:type="String">
              <sv:value>answer</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>protocol/hasProtocol</sv:value>
            </sv:property>
          </sv:node>
          <sv:node sv:name="operandB">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>true</sv:value>
            </sv:property>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toGenerateProposal" sourceRef="stillWithoutProtocol" targetRef="generateProposal" />
    <bpmn:serviceTask id="generateProposal" iap:handler="generateDocument" iap:requirement="generatedProposal" name="Write the proposal from the answers">
      <bpmn:incoming>toGenerateProposal</bpmn:incoming>
      <bpmn:outgoing>toSendWithoutProtocol</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toSendWithoutProtocol" sourceRef="generateProposal" targetRef="sendWithoutProtocol" />
    <bpmn:userTask id="sendWithoutProtocol" iap:performers="@creator" name="Send for review">
      <bpmn:incoming>toSendWithoutProtocol</bpmn:incoming>
      <bpmn:incoming>toSendWithoutProtocolAgain</bpmn:incoming>
      <bpmn:outgoing>toSentWithoutProtocol</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="toSentWithoutProtocol" sourceRef="sendWithoutProtocol" targetRef="sentWithoutProtocol" />
    <bpmn:exclusiveGateway id="sentWithoutProtocol" default="toFinalProposal" name="Still without a protocol?">
      <bpmn:incoming>toSentWithoutProtocol</bpmn:incoming>
      <bpmn:outgoing>toUploadOnSend</bpmn:outgoing>
      <bpmn:outgoing>toFinalProposal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="toUploadOnSend" name="Changed to yes" sourceRef="sentWithoutProtocol" targetRef="uploadProposal">
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name">
            <sv:value>cond:SingleCondition</sv:value>
          </sv:property>
          <sv:property sv:name="comparator" sv:type="String">
            <sv:value>equals</sv:value>
          </sv:property>
          <sv:node sv:name="operandA">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="source" sv:type="String">
              <sv:value>answer</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>protocol/hasProtocol</sv:value>
            </sv:property>
          </sv:node>
          <sv:node sv:name="operandB">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>true</sv:value>
            </sv:property>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toFinalProposal" sourceRef="sentWithoutProtocol" targetRef="finalProposal" />
    <bpmn:serviceTask id="finalProposal" iap:handler="generateDocument" iap:requirement="generatedProposal" name="Write the proposal from the final answers">
      <bpmn:incoming>toFinalProposal</bpmn:incoming>
      <bpmn:outgoing>toCanSendWithoutProtocol</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toCanSendWithoutProtocol" sourceRef="finalProposal" targetRef="canSendWithoutProtocol" />
    <bpmn:exclusiveGateway id="canSendWithoutProtocol" default="toMarkSubmittedWithoutProtocol" name="Can it be sent?">
      <bpmn:incoming>toCanSendWithoutProtocol</bpmn:incoming>
      <bpmn:outgoing>toSendWithoutProtocolAgain</bpmn:outgoing>
      <bpmn:outgoing>toMarkSubmittedWithoutProtocol</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="toSendWithoutProtocolAgain" name="Something is missing" sourceRef="canSendWithoutProtocol" targetRef="sendWithoutProtocol">
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name">
            <sv:value>cond:SingleCondition</sv:value>
          </sv:property>
          <sv:property sv:name="comparator" sv:type="String">
            <sv:value>includes</sv:value>
