{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Research proposal",
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "bpmnAuthoritative": true,
    "tags": ["active"],
    "description": "A researcher uploads a proposal, checks what was read into the form, and sends it for review. A reviewer then accepts or refuses it.",
    "created": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "created",
      "label": "Proposal started",
      "jcr:reference:flowNodeType": "/WorkflowTypes/StartEvent",
      "toComplete": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toComplete",
        "targetRef": "complete"
      }
    },
    // Uploading the proposal starts its parse, classification and reading, which land while this step is
    // open. The researcher checks what was read, answers the rest, and sends it.
    "complete": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "complete",
      "label": "Send for review",
      "performers": [
        "@creator"
      ],
      "jcr:reference:flowNodeType": "/WorkflowTypes/UserTask",
      "toCanSend": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toCanSend",
        "targetRef": "canSend"
      }
    },
    "canSend": {
      "jcr:primaryType": "wf:ExclusiveGateway",
      "elementId": "canSend",
      "label": "Can it be sent?",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ExclusiveGateway",
      "toCompleteAgain": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toCompleteAgain",
        "label": "Blocked, or something is missing",
        "targetRef": "complete",
        "cond:condition": {
          "jcr:primaryType": "cond:ConditionGroup",
          "requireAll": false,
          "blocked": {
            "jcr:primaryType": "cond:SingleCondition",
            "comparator": "equals",
            "operandA": {
              "jcr:primaryType": "cond:ConditionOperand",
              "source": "property",
              "value": [
                "extractionBlocked"
              ]
            },
            "operandB": {
              "jcr:primaryType": "cond:ConditionOperand",
              "value": [
                "true"
              ]
            }
          },
          "incomplete": {
            "jcr:primaryType": "cond:SingleCondition",
            "comparator": "includes",
            "operandA": {
              "jcr:primaryType": "cond:ConditionOperand",
              "source": "tags"
            },
            "operandB": {
              "jcr:primaryType": "cond:ConditionOperand",
              "value": [
                "incomplete"
              ]
            }
          }
        }
      },
      "toMarkSubmitted": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toMarkSubmitted",
        "targetRef": "markSubmitted",
        "isDefault": true
      }
    },
    "markSubmitted": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "markSubmitted",
      "label": "Mark it submitted",
      "handler": "addTag",
      "tag": "submitted",
      "replaceExisting": true,
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toReview": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toReview",
        "targetRef": "review"
      }
    },
    "review": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "review",
      "label": "Review the proposal",
      "performers": [
        "proposal-reviewers"
      ],
      "outcomeOptions": [
        "approved",
        "rejected"
      ],
      "jcr:reference:flowNodeType": "/WorkflowTypes/UserTask",
      "toRecord": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toRecord",
        "targetRef": "record"
      }
    },
    "record": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "record",
      "label": "Write the decision down",
      "handler": "recordReview",
      "requirement": "review",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDecision": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDecision",
        "targetRef": "decision"
      }
    },
    "decision": {
      "jcr:primaryType": "wf:ExclusiveGateway",
      "elementId": "decision",
      "label": "Approved?",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ExclusiveGateway",
      "toApproved": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toApproved",
        "targetRef": "approved",
        "cond:condition": {
          "jcr:primaryType": "cond:SingleCondition",
          "comparator": "equals",
          "operandA": {
            "jcr:primaryType": "cond:ConditionOperand",
            "source": "variable",
            "value": [ "outcome" ]
          },
          "operandB": {
            "jcr:primaryType": "cond:ConditionOperand",
            "value": [ "approved" ]
          }
        }
      },
      "toRejected": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toRejected",
        "targetRef": "rejected",
        "isDefault": true
      }
    },
    "approved": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "approved",
      "label": "Proposal approved",
      "hostTag": "approved",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    },
    "rejected": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "rejected",
      "label": "Proposal refused",
      "hostTag": "rejected",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
