<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:iap="https://iap.uhndata.io/bpmn"
                  id="readPfqDefinitions"
                  targetNamespace="https://iap.uhndata.io/demos/readPfq">
  <bpmn:process id="readPfq" name="Read a patient facing questionnaire" isExecutable="true">
    <bpmn:startEvent id="started" name="The questionnaire is readable">
      <bpmn:outgoing>toAsk</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toAsk" sourceRef="started" targetRef="askTheModel" />
    <!-- One call for the whole requirement, and no gate before it. A proposal has to be identified before it
         is read, and the kind of study it turns out to be decides what is asked next; a submission against
         this schema is a questionnaire because the submitter said so, and every question is asked of every
         one. iap:requirement names which of the schema's questions are put to the model; iap:documents names
         what is read, in order, sent as one text under a heading each. -->
    <bpmn:serviceTask id="askTheModel" iap:handler="intakeAnswers" iap:requirement="extracted"
        iap:documents="preamble,questionnaire"
        name="Read the questionnaire">
      <bpmn:incoming>toAsk</bpmn:incoming>
      <bpmn:outgoing>toMark</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toMark" sourceRef="askTheModel" targetRef="markCompleteness" />
    <bpmn:serviceTask id="markCompleteness" iap:handler="markCompleteness"
        name="Record whether anything is still missing">
      <bpmn:incoming>toMark</bpmn:incoming>
      <bpmn:outgoing>toFinish</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toFinish" sourceRef="markCompleteness" targetRef="finishReading" />
    <!-- Moves the submission off `running` whatever the reading found, so the view stops showing a spinner
         nobody can tell from a reading still in progress. -->
    <bpmn:serviceTask id="finishReading" iap:handler="finishReading" name="The reading is over">
      <bpmn:incoming>toFinish</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toDone" sourceRef="finishReading" targetRef="done" />
    <bpmn:endEvent id="done" name="The questionnaire has been read">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="readPfqDiagram">
    <bpmndi:BPMNPlane id="readPfqPlane" bpmnElement="readPfq">
      <bpmndi:BPMNShape id="startedShape" bpmnElement="started">
        <dc:Bounds x="160" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="136" y="223" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="askTheModelShape" bpmnElement="askTheModel">
        <dc:Bounds x="250" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="markCompletenessShape" bpmnElement="markCompleteness">
        <dc:Bounds x="400" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finishReadingShape" bpmnElement="finishReading">
        <dc:Bounds x="550" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doneShape" bpmnElement="done">
        <dc:Bounds x="700" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="676" y="223" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toAskEdge" bpmnElement="toAsk">
        <di:waypoint x="196" y="198" />
        <di:waypoint x="250" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toMarkEdge" bpmnElement="toMark">
        <di:waypoint x="350" y="198" />
        <di:waypoint x="400" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toFinishEdge" bpmnElement="toFinish">
        <di:waypoint x="500" y="198" />
        <di:waypoint x="550" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDoneEdge" bpmnElement="toDone">
        <di:waypoint x="650" y="198" />
        <di:waypoint x="700" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
