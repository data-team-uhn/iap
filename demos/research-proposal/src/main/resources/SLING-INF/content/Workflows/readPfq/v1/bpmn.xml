<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:iap="https://iap.uhndata.io/bpmn"
                  xmlns:sv="http://www.jcp.org/jcr/sv/1.0"
                  id="readPfqDefinitions"
                  targetNamespace="https://iap.uhndata.io/demos/readPfq">
  <bpmn:process id="readPfq" name="Read a patient facing questionnaire" isExecutable="true">
    <bpmn:startEvent id="started" name="The questionnaire is readable">
      <bpmn:outgoing>toClassify</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toClassify" sourceRef="started" targetRef="classify" />
    <bpmn:serviceTask id="classify" iap:handler="classifyDocument" name="Classify the document">
      <bpmn:incoming>toClassify</bpmn:incoming>
      <bpmn:outgoing>toQuestionnaireCheck</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toQuestionnaireCheck" sourceRef="classify" targetRef="isQuestionnaire" />
    <bpmn:exclusiveGateway id="isQuestionnaire" default="toMarkUnsettled" name="A patient facing questionnaire?">
      <bpmn:incoming>toQuestionnaireCheck</bpmn:incoming>
      <bpmn:incoming>confirmedToIsQuestionnaire</bpmn:incoming>
      <bpmn:outgoing>toEndReadingFailed</bpmn:outgoing>
      <bpmn:outgoing>toAsk</bpmn:outgoing>
      <bpmn:outgoing>toMarkNotAQuestionnaire</bpmn:outgoing>
      <bpmn:outgoing>toMarkUnsettled</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="toEndReadingFailed" name="Could not classify" sourceRef="isQuestionnaire" targetRef="endReadingFailed">
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name">
            <sv:value>cond:SingleCondition</sv:value>
          </sv:property>
          <sv:property sv:name="comparator" sv:type="String">
            <sv:value>equals</sv:value>
          </sv:property>
          <sv:node sv:name="operandA">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="source" sv:type="String">
              <sv:value>property</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>extractionStatus</sv:value>
            </sv:property>
          </sv:node>
          <sv:node sv:name="operandB">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>failed</sv:value>
            </sv:property>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">extractionStatus == failed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="endReadingFailed" name="The document could not be classified">
      <bpmn:incoming>toEndReadingFailed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="toAsk" name="Yes" sourceRef="isQuestionnaire" targetRef="askTheModel">
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name">
            <sv:value>cond:SingleCondition</sv:value>
          </sv:property>
          <sv:property sv:name="comparator" sv:type="String">
            <sv:value>equals</sv:value>
          </sv:property>
          <sv:node sv:name="operandA">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="source" sv:type="String">
              <sv:value>decision</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>is_questionnaire/decision</sv:value>
            </sv:property>
          </sv:node>
          <sv:node sv:name="operandB">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>yes</sv:value>
            </sv:property>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">is_questionnaire/decision == yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toMarkNotAQuestionnaire" name="No" sourceRef="isQuestionnaire" targetRef="markNotAQuestionnaire">
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name">
            <sv:value>cond:SingleCondition</sv:value>
          </sv:property>
          <sv:property sv:name="comparator" sv:type="String">
            <sv:value>equals</sv:value>
          </sv:property>
          <sv:node sv:name="operandA">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="source" sv:type="String">
              <sv:value>decision</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>is_questionnaire/decision</sv:value>
            </sv:property>
          </sv:node>
          <sv:node sv:name="operandB">
            <sv:property sv:name="jcr:primaryType" sv:type="Name">
              <sv:value>cond:ConditionOperand</sv:value>
            </sv:property>
            <sv:property sv:name="value" sv:type="String" sv:multiple="true">
              <sv:value>no</sv:value>
            </sv:property>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">is_questionnaire/decision == no</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toMarkUnsettled" name="Not settled" sourceRef="isQuestionnaire" targetRef="markUnsettled" />
    <bpmn:serviceTask id="askTheModel" iap:handler="intakeAnswers" iap:requirement="extracted" iap:documents="preamble,questionnaire" name="Read the questionnaire">
      <bpmn:incoming>toAsk</bpmn:incoming>
      <bpmn:outgoing>toMark</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toMark" sourceRef="askTheModel" targetRef="markCompleteness" />
    <bpmn:serviceTask id="markCompleteness" iap:handler="markCompleteness" name="Record whether anything is still missing">
      <bpmn:incoming>toMark</bpmn:incoming>
      <bpmn:outgoing>toFinish</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toFinish" sourceRef="markCompleteness" targetRef="finishReading" />
    <bpmn:serviceTask id="finishReading" iap:handler="finishReading" name="The reading is over">
      <bpmn:incoming>toFinish</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toDone" sourceRef="finishReading" targetRef="done" />
    <bpmn:endEvent id="done" name="The questionnaire has been read">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="markNotAQuestionnaire" iap:handler="markCompleteness" name="Record whether anything is still missing">
      <bpmn:incoming>toMarkNotAQuestionnaire</bpmn:incoming>
      <bpmn:outgoing>toFinishNotAQuestionnaire</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toFinishNotAQuestionnaire" sourceRef="markNotAQuestionnaire" targetRef="finishNotAQuestionnaire" />
    <bpmn:serviceTask id="finishNotAQuestionnaire" iap:handler="finishReading" name="The reading is over">
      <bpmn:incoming>toFinishNotAQuestionnaire</bpmn:incoming>
      <bpmn:outgoing>toEndNotAQuestionnaire</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toEndNotAQuestionnaire" sourceRef="finishNotAQuestionnaire" targetRef="endNotAQuestionnaire" />
    <bpmn:endEvent id="endNotAQuestionnaire" name="Not a patient facing questionnaire">
      <bpmn:incoming>toEndNotAQuestionnaire</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="markUnsettled" iap:handler="markCompleteness" name="Record whether anything is still missing">
      <bpmn:incoming>toMarkUnsettled</bpmn:incoming>
      <bpmn:outgoing>toFinishUnsettled</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toFinishUnsettled" sourceRef="markUnsettled" targetRef="finishUnsettled" />
    <bpmn:serviceTask id="finishUnsettled" iap:handler="finishReading" iap:message="The reading waits for you to confirm whether this is a patient facing questionnaire." name="The reading is paused">
      <bpmn:incoming>toFinishUnsettled</bpmn:incoming>
      <bpmn:outgoing>toConfirmUnsettled</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toConfirmUnsettled" sourceRef="finishUnsettled" targetRef="confirmUnsettled" />
    <bpmn:userTask id="confirmUnsettled" iap:performers="@creator" iap:requirement="is_questionnaire" name="Continue once this is confirmed">
      <bpmn:incoming>toConfirmUnsettled</bpmn:incoming>
      <bpmn:outgoing>confirmedToIsQuestionnaire</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="confirmedToIsQuestionnaire" name="Confirmed" sourceRef="confirmUnsettled" targetRef="isQuestionnaire" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="readPfqDiagram">
    <bpmndi:BPMNPlane id="readPfqPlane" bpmnElement="readPfq">
      <bpmndi:BPMNShape id="startedShape" bpmnElement="started">
        <dc:Bounds x="100" y="382" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="classifyShape" bpmnElement="classify">
        <dc:Bounds x="180" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="isQuestionnaireShape" bpmnElement="isQuestionnaire" isMarkerVisible="true">
        <dc:Bounds x="380" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="askTheModelShape" bpmnElement="askTheModel">
        <dc:Bounds x="520" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="markCompletenessShape" bpmnElement="markCompleteness">
        <dc:Bounds x="680" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finishReadingShape" bpmnElement="finishReading">
        <dc:Bounds x="830" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doneShape" bpmnElement="done">
        <dc:Bounds x="980" y="382" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="markNotAQuestionnaireShape" bpmnElement="markNotAQuestionnaire">
        <dc:Bounds x="355" y="520" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finishNotAQuestionnaireShape" bpmnElement="finishNotAQuestionnaire">
        <dc:Bounds x="355" y="650" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endNotAQuestionnaireShape" bpmnElement="endNotAQuestionnaire">
        <dc:Bounds x="387" y="782" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="markUnsettledShape" bpmnElement="markUnsettled">
        <dc:Bounds x="230" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finishUnsettledShape" bpmnElement="finishUnsettled">
        <dc:Bounds x="230" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="confirmUnsettledShape" bpmnElement="confirmUnsettled">
        <dc:Bounds x="400" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endReadingFailedShape" bpmnElement="endReadingFailed">
        <dc:Bounds x="500" y="520" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toEndReadingFailedEdge" bpmnElement="toEndReadingFailed">
        <di:waypoint x="418" y="412" />
        <di:waypoint x="518" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toClassifyEdge" bpmnElement="toClassify">
        <di:waypoint x="136" y="400" />
        <di:waypoint x="180" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toQuestionnaireCheckEdge" bpmnElement="toQuestionnaireCheck">
        <di:waypoint x="280" y="400" />
        <di:waypoint x="380" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toAskEdge" bpmnElement="toAsk">
        <di:waypoint x="430" y="400" />
        <di:waypoint x="520" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toMarkNotAQuestionnaireEdge" bpmnElement="toMarkNotAQuestionnaire">
        <di:waypoint x="405" y="425" />
        <di:waypoint x="405" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toMarkUnsettledEdge" bpmnElement="toMarkUnsettled">
        <di:waypoint x="405" y="375" />
        <di:waypoint x="280" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toMarkEdge" bpmnElement="toMark">
        <di:waypoint x="620" y="400" />
        <di:waypoint x="680" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toFinishEdge" bpmnElement="toFinish">
        <di:waypoint x="780" y="400" />
        <di:waypoint x="830" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDoneEdge" bpmnElement="toDone">
        <di:waypoint x="930" y="400" />
        <di:waypoint x="980" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toFinishNotAQuestionnaireEdge" bpmnElement="toFinishNotAQuestionnaire">
        <di:waypoint x="405" y="600" />
        <di:waypoint x="405" y="650" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toEndNotAQuestionnaireEdge" bpmnElement="toEndNotAQuestionnaire">
        <di:waypoint x="405" y="730" />
        <di:waypoint x="405" y="782" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toFinishUnsettledEdge" bpmnElement="toFinishUnsettled">
        <di:waypoint x="280" y="150" />
        <di:waypoint x="280" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toConfirmUnsettledEdge" bpmnElement="toConfirmUnsettled">
        <di:waypoint x="330" y="60" />
        <di:waypoint x="400" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="confirmedToIsQuestionnaireEdge" bpmnElement="confirmedToIsQuestionnaire">
        <di:waypoint x="450" y="100" />
        <di:waypoint x="405" y="375" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
