{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Read a patient facing questionnaire",
  "active": true,
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "active": true,
    "description": "What the platform does with an uploaded questionnaire once the daemon has parsed it. It is classified first: is it a patient facing questionnaire. The pick is stored as an answer, pre-filled for the requester, and acted on only once it is settled - confirmed, changed, or picked by a model sure enough of it. A settled yes reads the questions about it out of the questionnaire and its preamble in one call. A settled no ends the reading, leaving the questions to be answered by hand. An unsettled pick pauses the reading on a task the requester completes after confirming it. Started by the extractAnswers system workflow when a parse lands, so a preamble uploaded later reads again, and fills only what is still unanswered.",
    "started": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "started",
      "label": "The questionnaire is readable",
      "jcr:reference:flowNodeType": "/WorkflowTypes/StartEvent",
      "toClassify": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toClassify",
        "targetRef": "classify"
      }
    },
    "classify": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "classify",
      "label": "Classify the document",
      "handler": "classifyDocument",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toQuestionnaireCheck": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toQuestionnaireCheck",
        "targetRef": "isQuestionnaire"
      }
    },
    "isQuestionnaire": {
      "jcr:primaryType": "wf:ExclusiveGateway",
      "elementId": "isQuestionnaire",
      "label": "A patient facing questionnaire?",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ExclusiveGateway",
      "toAsk": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toAsk",
        "label": "Yes",
        "targetRef": "askTheModel",
        "cond:condition": {
          "jcr:primaryType": "cond:SingleCondition",
          "comparator": "equals",
          "operandA": {
            "jcr:primaryType": "cond:ConditionOperand",
            "source": "decision",
            "value": [
              "is_questionnaire/decision"
            ]
          },
          "operandB": {
            "jcr:primaryType": "cond:ConditionOperand",
            "value": [
              "yes"
            ]
          }
        }
      },
      "toMarkNotAQuestionnaire": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toMarkNotAQuestionnaire",
        "label": "No",
        "targetRef": "markNotAQuestionnaire",
        "cond:condition": {
          "jcr:primaryType": "cond:SingleCondition",
          "comparator": "equals",
          "operandA": {
            "jcr:primaryType": "cond:ConditionOperand",
            "source": "decision",
            "value": [
              "is_questionnaire/decision"
            ]
          },
          "operandB": {
            "jcr:primaryType": "cond:ConditionOperand",
            "value": [
              "no"
            ]
          }
        }
      },
      "toMarkUnsettled": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toMarkUnsettled",
        "label": "Not settled",
        "targetRef": "markUnsettled",
        "isDefault": true
      }
    },
    "askTheModel": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "askTheModel",
      "label": "Read the questionnaire",
      "handler": "intakeAnswers",
      "requirement": "extracted",
      "documents": [
        "preamble",
        "questionnaire"
      ],
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toMark": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toMark",
        "targetRef": "markCompleteness"
      }
    },
    "markCompleteness": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "markCompleteness",
      "label": "Record whether anything is still missing",
      "handler": "markCompleteness",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toFinish": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toFinish",
        "targetRef": "finishReading"
      }
    },
    "finishReading": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "finishReading",
      "label": "The reading is over",
      "handler": "finishReading",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "done"
      }
    },
    "done": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "done",
      "label": "The questionnaire has been read",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    },
    "markNotAQuestionnaire": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "markNotAQuestionnaire",
      "label": "Record whether anything is still missing",
      "handler": "markCompleteness",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toFinishNotAQuestionnaire": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toFinishNotAQuestionnaire",
        "targetRef": "finishNotAQuestionnaire"
      }
    },
    "finishNotAQuestionnaire": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "finishNotAQuestionnaire",
      "label": "The reading is over",
      "handler": "finishReading",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toEndNotAQuestionnaire": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toEndNotAQuestionnaire",
        "targetRef": "endNotAQuestionnaire"
      }
    },
    "endNotAQuestionnaire": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "endNotAQuestionnaire",
      "label": "Not a patient facing questionnaire",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    },
    "markUnsettled": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "markUnsettled",
      "label": "Record whether anything is still missing",
      "handler": "markCompleteness",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toFinishUnsettled": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toFinishUnsettled",
        "targetRef": "finishUnsettled"
      }
    },
    "finishUnsettled": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "finishUnsettled",
      "label": "The reading is paused",
      "handler": "finishReading",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toConfirmUnsettled": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toConfirmUnsettled",
        "targetRef": "confirmUnsettled"
      }
    },
    "confirmUnsettled": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "confirmUnsettled",
      "label": "Continue once this is confirmed",
      "performers": [
        "@creator"
      ],
      "requirement": "is_questionnaire",
      "jcr:reference:flowNodeType": "/WorkflowTypes/UserTask",
      "confirmedToIsQuestionnaire": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "confirmedToIsQuestionnaire",
        "label": "Confirmed",
        "targetRef": "isQuestionnaire"
      }
    }
  }
}
