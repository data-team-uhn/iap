{
  "bundles": [
    {
      "id": "${project.groupId}:${project.artifactId}:${project.version}",
      // After schemas (27) and submissions (28), whose trees this content is loaded into
      "start-order": "30"
    }
  ],
  "configurations": {
    "org.apache.sling.jcr.repoinit.RepositoryInitializer~demo-research-proposal": {
      "service.ranking:Integer": 400,
      "scripts": [
        // The two people the demo is about. Passwords match the names because this is a demo: it is
        // reached through --demo or the demo integration-test suite, never a real deployment.
        // The council reviews questionnaires as the reviewers review proposals; the same demo
        // reviewer sits on both, since the demo is about the two workflows rather than about
        // who is in which body.
        "create group proposal-researchers \n create group proposal-reviewers \n create group pfq-council",
        "create user demo-researcher with password demo-researcher \n create user demo-reviewer with password demo-reviewer",
        "add demo-researcher to group proposal-researchers \n add demo-reviewer to group proposal-reviewers \n add demo-reviewer to group pfq-council",
        "set properties on authorizable(demo-researcher) \n set profile/email to \"demo-researcher@example.com\" \n end",
        "set properties on authorizable(demo-reviewer) \n set profile/email to \"demo-reviewer@example.com\" \n end"
      ]
    }
  }
}
