<doc = 'https://iap.uhndata.io/doc/'>

//-----------------------------------------------------------------------------
// Marks a node that documents a feature at runtime, such as the catalogue of
// defined tags, at `<path>.doc.json` and `<path>.doc.md`. A node type can
// extend the mixin, or a single node can carry it.
[doc:Documented]
  mixin

  // The title of the documentation, such as "Tags"
  - title (STRING)

  // The introduction shown under the title
  - description (STRING)
