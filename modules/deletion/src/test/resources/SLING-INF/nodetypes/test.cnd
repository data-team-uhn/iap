<test = 'https://iap.uhndata.io/test/'>
<iap = 'https://iap.uhndata.io/'>

// Replicates the shape of a versionable entity: the links container and
// everything under it stay out of the version history, so links can be
// added and removed without checking their holder out.
[test:Entity] > nt:unstructured, mix:referenceable, mix:versionable
  + iap:links (iap:Links) = iap:Links IGNORE
