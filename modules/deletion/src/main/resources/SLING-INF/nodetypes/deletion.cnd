<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<rep = 'internal'>
<del = 'https://iap.uhndata.io/del/'>
<data = 'https://iap.uhndata.io/data/'>

//-----------------------------------------------------------------------------
//
// Deletion: the archive that deleted resources move into, to be restored or
// purged later, and the mixin that protects a resource from deletion. The
// design is in docs/deletion.md.
//
// The archive types do not extend data:Content. An entry is not content, so
// it takes no tags or links, and the DELETE servlet for data/Content does not
// serve it.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// Marks a resource that must never be deleted: not archived, not deleted for
// good, and not purged if it is in the archive. Removing the mixin lifts the
// protection.
[del:Undeletable]
  mixin

//-----------------------------------------------------------------------------
// The archive root at /Archive, and the buckets of the prefix tree under it.
// The repoinit grants it to nobody, so queries never return archived content
// to ordinary users.
[del:Archive] > sling:Folder, rep:AccessControllable
  - sling:resourceType (STRING) = "del/Archive" mandatory autocreated protected

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The entries, filed in a PrefixTree under buckets that are del:Archive
  // nodes themselves. No entry is a direct child of /Archive.
  + * (del:ArchiveEntry) = del:ArchiveEntry
  + * (del:Archive) = del:Archive

//-----------------------------------------------------------------------------
// One archiving deletion: who requested it, when (jcr:created), and which
// path, with one del:DeletedItem for each subtree it moved into the archive.
[del:ArchiveEntry] > sling:Folder, mix:created
  - sling:resourceType (STRING) = "del/ArchiveEntry" mandatory autocreated protected

  // The user id of the user who requested the deletion. jcr:createdBy names
  // whoever wrote the entry: the iap-deletion service user, or the session
  // of a caller deleting within its own transaction.
  - deletedBy (STRING) mandatory

  // The path whose deletion was requested, such as /Submissions/abc. The
  // other items came along through references or links.
  - requestedPath (STRING) mandatory

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The archived subtrees
  + * (del:DeletedItem) = del:DeletedItem

//-----------------------------------------------------------------------------
// A wrapper around one archived subtree, recording where it came from so it
// can be restored. The record is on the wrapper, so archiving and restoring
// never change the archived resources themselves.
[del:DeletedItem] > sling:Folder
  - sling:resourceType (STRING) = "del/DeletedItem" mandatory autocreated protected

  // The absolute path the subtree was moved from, such as /Submissions/abc
  - originalPath (STRING) mandatory

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The archived subtree. The archive puts exactly one here.
  + * (nt:base)
