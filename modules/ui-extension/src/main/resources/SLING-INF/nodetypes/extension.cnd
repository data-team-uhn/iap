<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<ext = 'https://iap.uhndata.io/ext/'>

//-----------------------------------------------------------------------------
//
// An extension point: a place in the interface that shows the extensions
// registered on it. Points are kept under /apps/iap/ExtensionPoints/, and
// docs/ui-extensions.md describes them.
//
//-----------------------------------------------------------------------------
[ext:Point] > nt:base, sling:Resource, mix:referenceable
  query

  - sling:resourceType (STRING) = "ext/Point" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "data/Entity" mandatory autocreated protected

  // The identifier extensions name in their ext:pointId, such as
  // "iap/coreUI/view"
  - ext:pointId (STRING) mandatory

  // What the point is for, in a phrase for people, such as "Ways of signing in
  // offered on the login page"
  - ext:pointName (STRING) mandatory

  // And any other properties
  - * (undefined) multiple
  - * (undefined)

//-----------------------------------------------------------------------------
//
// An extension: something a module adds to the interface, shown by the
// extension point it names.
//
//-----------------------------------------------------------------------------
[ext:Extension] > nt:base, sling:Resource, mix:referenceable
  query

  - sling:resourceType (STRING) = "ext/Extension" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "data/Entity" mandatory autocreated protected

  // The ext:pointId of the extension point that shows the extension
  - ext:pointId (STRING) mandatory

  // The component that renders the extension, as an asset such as
  // "asset:iap-commons.NoticeBanner.js". A "?lazy" suffix loads it only when
  // it is first rendered.
  - ext:renderURL (STRING)

  // Where the extension leads, such as a view's path or a link's target
  - ext:targetURL (STRING)

  - ext:exactURLMatch (BOOLEAN)

  // The extension's name, which a point may show, such as a widget's title
  - ext:name (STRING) mandatory

  // An icon for the extension
  - ext:icon (STRING)

  // The extension's position in its point, lowest first
  - defaultOrder (LONG) = "0" mandatory autocreated

  // Whether the extension is left out of its point, without being deleted
  - ext:defaultDisabled (BOOLEAN) = "false" mandatory autocreated

  // A short description of the extension, such as a line under a sign-in
  // button
  - ext:hint (STRING)

  // Data for the component, such as the markdown message of a banner
  - ext:data (STRING)

  // Whether a frameTop extension is also shown on the login page, before
  // sign-in. Absent means no, since most extensions need a session.
  - ext:visibleBeforeLogin (BOOLEAN)

  // The personas the extension is for, such as "reviewer". Absent means every
  // persona. A point that filters by persona shows the extension only to
  // these. A persona decides what is shown, and never controls access.
  - ext:personas (STRING) multiple

  // The places an action is shown in, by the names the pages give them, such
  // as "versionList" for a list of versions. Absent means every place.
  - ext:places (STRING) multiple

  // And any other properties
  - * (undefined) multiple
  - * (undefined)

//-----------------------------------------------------------------------------
//
// The extension point finder, at /uixp. Asked for an ext:pointId in its uixp
// parameter, it answers with the path of that point.
//
//-----------------------------------------------------------------------------
[ext:PointFinder] > sling:Resource
  query

  - sling:resourceType (STRING) = "ext/PointFinder" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "data/Entity" mandatory autocreated protected
