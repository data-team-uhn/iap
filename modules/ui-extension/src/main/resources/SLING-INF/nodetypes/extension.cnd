<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<ext = 'https://iap.uhndata.io/ext/'>

//-----------------------------------------------------------------------------
//
// A User Interface Extension Point (UIXP) defines a place in the UI that accepts extensions
//
//-----------------------------------------------------------------------------
[ext:Point] > nt:base, sling:Resource, mix:referenceable

  // Attributes

  // We can use extension points in a query.
  query

  // Properties

  // Hardcode the resource type.
  - sling:resourceType (STRING) = "ext/Point" mandatory autocreated protected

  // Hardcode the resource supertype
  - sling:resourceSuperType (STRING) = "data/Entity" mandatory autocreated protected

  // The identifier of this UIXP, which will be referenced by UIX
  - ext:pointId (STRING) mandatory

  // A more user-friendly name for this UIXP
  - ext:pointName (STRING) mandatory

  // And any other properties
  - * (undefined) multiple
  - * (undefined)

//-----------------------------------------------------------------------------
//
// A User Interface Extension (UIX) defines content that can be automatically placed in a UIXP
//
//-----------------------------------------------------------------------------
[ext:Extension] > nt:base, sling:Resource, mix:referenceable

  // Attributes

  // We can use extensions in a query.
  query

  // Properties:

  // Hardcode the resource type.
  - sling:resourceType (STRING) = "ext/Extension" mandatory autocreated protected

  // Hardcode the resource supertype
  - sling:resourceSuperType (STRING) = "data/Entity" mandatory autocreated protected

  // The ID of the extension point targeted by this extension
  - ext:pointId (STRING) mandatory

  // The URL to the script that can render this extension
  - ext:renderURL (STRING)

  // The (optional) URL that this extension is targeting, for links and views
  - ext:targetURL (STRING)

  // Whether the target URL should be matched exactly for Views
  - ext:exactURLMatch (BOOLEAN)

  // The name of the extension
  - ext:name (STRING) mandatory

  // Optional icon associated with this extension
  - ext:icon (STRING)

  // The order that this should appear in the list of extensions in the extension point
  - defaultOrder (LONG) = "0" mandatory autocreated

  // Whether this extension is disabled or not by default
  - ext:defaultDisabled (BOOLEAN) = "false" mandatory autocreated

  // Optional short description of the extension's content
  - ext:hint (STRING)

  // Optional data (stored in the JCR node) to be passed to the rendered component
  - ext:data (STRING)

  // Whether this extension is also displayed on pages served before authentication (currently
  // the login page, which renders opted-in frameTop extensions above its content). Opt-in, so
  // that extensions assuming a session (e.g. the app bar) never leak onto pre-auth pages.
  - ext:visibleBeforeLogin (BOOLEAN)

  // The personas this extension belongs to, e.g. "reviewer". A user acts as one persona at a time
  // and only sees the extensions belonging to it, so that each persona's UI is designed around what
  // that role does rather than around the rights the individual happens to hold.
  //
  // Absent means every persona, unlike ext:visibleBeforeLogin above: an extension that never
  // considered personas keeps displaying exactly where it did before.
  //
  // This selects what is DISPLAYED and is never an access control; permissions are enforced by the
  // repository, independently of which persona is active.
  - ext:personas (STRING) multiple

  // And any other properties
  - * (undefined) multiple
  - * (undefined)

//-----------------------------------------------------------------------------
//
// A UIXP Finder locates extension points based on their ID
//
//-----------------------------------------------------------------------------
[ext:PointFinder] > sling:Resource

  // Attributes

  // We can use extension points in a query.
  query

  // Properties

  // Hardcode the resource type.
  - sling:resourceType (STRING) = "ext/PointFinder" mandatory autocreated protected

  // Hardcode the resource supertype: each UIXP is a resource.
  - sling:resourceSuperType (STRING) = "data/Entity" mandatory autocreated protected
