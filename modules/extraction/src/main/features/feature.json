{
  "bundles":[
    {
      // Starts after the LLM client (25), the workflow engine (26), and the submissions and schemas modules it
      // uses (28)
      "id":"${project.groupId}:${project.artifactId}:${project.version}",
      "start-order":"29"
    }
  ],
  "configurations":{
    "org.apache.sling.jcr.repoinit.RepositoryInitializer~extraction":{
      "service.ranking:Integer": 400,
      "scripts":[
        // The user that hands a finished parse to the workflow engine and later asks it to read the answers.
        // The workflow definitions decide which events it may fire: the documentParsed, extractAnswers,
        // readingStarted, readingFailed, validated, categorised and decided start events name only this user, and
        // so does the task an intake workflow waits at for each validation.
        //
        // It writes nothing: even the claim on a reading and a give-up are events, so the workflow engine makes
        // every change as its own user.
        // It reads /Schemas and /Workflows to check that the schema version's reading workflow exists before it
        // asks for a reading. Granted by name: a service user mapped as [iap-extraction] holds only that
        // principal, so what /Schemas grants to everyone does not reach it.
        "create service user iap-extraction \n set ACL for iap-extraction \n allow jcr:read on /Submissions,/Schemas,/Workflows \n end"
      ]
    },
    "org.apache.sling.serviceusermapping.impl.ServiceUserMapperImpl.amended~iapextraction":{
      "user.mapping":[
        "io.uhndata.iap.extraction:extraction=[iap-extraction]"
      ]
    },
    // One submission read at a time, to match the LLM module's gate of one model call at a time. A wider queue
    // would not read anything sooner: jobs would wait at the gate, where they time out and fail, instead of in
    // the queue, where they can wait as long as needed.
    "org.apache.sling.event.jobs.QueueConfiguration~iapextraction":{
      "queue.name":"iap-extraction",
      "queue.topics":[
        "iap/extraction/extract",
        "iap/extraction/decide"
      ],
      "queue.type":"UNORDERED",
      "queue.maxparallel:Double":1.0
    }
  }
}
