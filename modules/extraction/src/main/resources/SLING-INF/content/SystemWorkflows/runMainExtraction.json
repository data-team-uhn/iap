{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Read the answers out of a submission's documents",
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "tags": ["active"],
    "targetResourceType": "sub/Submission",
    "description": "Queues the reading of the form answers once the submitter confirmed the category.",
    "requested": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "requested",
      "label": "Next clicked",
      "messageName": "runMainExtraction",
      "performers": ["@creator"],
      "jcr:reference:flowNodeType": "/WorkflowTypes/MessageStartEvent",
      "toQueue": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toQueue",
        "targetRef": "queue"
      }
    },
    "queue": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "queue",
      "label": "Queue the main extraction",
      "handler": "queueMainExtraction",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "done"
      }
    },
    "done": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "done",
      "label": "Queued",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
