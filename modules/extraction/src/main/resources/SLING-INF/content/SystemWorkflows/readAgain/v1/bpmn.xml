<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:iap="https://iap.uhndata.io/bpmn"
                  id="readAgainDefinitions"
                  targetNamespace="https://iap.uhndata.io/system/readAgain">
  <bpmn:message id="readAgainMessage" name="readAgain" />
  <bpmn:process id="readAgain" name="Read a submission's documents again" isExecutable="true">
    <bpmn:startEvent id="requested" iap:performers="everyone" name="Asked to read again">
      <bpmn:messageEventDefinition id="readRequested" messageRef="readAgainMessage" />
      <bpmn:outgoing>toQueue</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toQueue" sourceRef="requested" targetRef="queue" />
    <!-- Queues the reading again after one ended. The reading itself runs as a background job. -->
    <bpmn:serviceTask id="queue" iap:handler="readAgain" name="Queue the reading">
      <bpmn:incoming>toQueue</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toDone" sourceRef="queue" targetRef="done" />
    <bpmn:endEvent id="done" name="Queued">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="readAgainDiagram">
    <bpmndi:BPMNPlane id="readAgainPlane" bpmnElement="readAgain">
      <bpmndi:BPMNShape id="requestedShape" bpmnElement="requested">
        <dc:Bounds x="160" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="136" y="223" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="queueShape" bpmnElement="queue">
        <dc:Bounds x="250" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doneShape" bpmnElement="done">
        <dc:Bounds x="400" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="404" y="223" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toQueueEdge" bpmnElement="toQueue">
        <di:waypoint x="196" y="198" />
        <di:waypoint x="250" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDoneEdge" bpmnElement="toDone">
        <di:waypoint x="350" y="198" />
        <di:waypoint x="400" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
