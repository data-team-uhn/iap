{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Send a submission's failed parses again",
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "tags": ["active"],
    "targetResourceType": "sub/Submission",
    "description": "Sends the submission's uploads that were never parsed, or whose parse failed, to be parsed.",
    "requested": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "requested",
      "label": "Asked to try again",
      "messageName": "retryParse",
      "performers": ["@creator"],
      "jcr:reference:flowNodeType": "/WorkflowTypes/MessageStartEvent",
      "toParse": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toParse",
        "targetRef": "parse"
      }
    },
    "parse": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "parse",
      "label": "Send the uploads that failed again",
      "handler": "parseDocuments",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "done"
      }
    },
    "done": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "done",
      "label": "Sent again",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
