<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:iap="https://iap.uhndata.io/bpmn"
                  id="validatedDefinitions"
                  targetNamespace="https://iap.uhndata.io/system/validated">
  <bpmn:message id="validatedMessage" name="validated" />
  <bpmn:process id="validated" name="Save the validation of an upload" isExecutable="true">
    <!-- Only the extraction module's own user may fire this: it is what runs the reading jobs -->
    <bpmn:startEvent id="received" iap:performers="iap-extraction" name="Verdict received">
      <bpmn:messageEventDefinition id="receivedMessage" messageRef="validatedMessage" />
      <bpmn:outgoing>toTask</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toTask" sourceRef="received" targetRef="record" />
    <bpmn:serviceTask id="record" iap:handler="recordValidation" name="Save the verdict">
      <bpmn:incoming>toTask</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toDone" sourceRef="record" targetRef="recorded" />
    <bpmn:endEvent id="recorded" name="Verdict saved">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="validatedDiagram">
    <bpmndi:BPMNPlane id="validatedPlane" bpmnElement="validated">
      <bpmndi:BPMNShape id="receivedShape" bpmnElement="received">
        <dc:Bounds x="160" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="133" y="223" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="recordShape" bpmnElement="record">
        <dc:Bounds x="250" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="recordedShape" bpmnElement="recorded">
        <dc:Bounds x="400" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="378" y="223" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toTaskEdge" bpmnElement="toTask">
        <di:waypoint x="196" y="198" />
        <di:waypoint x="250" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDoneEdge" bpmnElement="toDone">
        <di:waypoint x="350" y="198" />
        <di:waypoint x="400" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
