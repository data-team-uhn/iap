{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Read the answers out of a submission's documents",
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "tags": ["active"],
    "targetResourceType": "sub/Submission",
    "description": "Starts the reading workflow that the submission's schema version names.",
    "requested": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "requested",
      "label": "Answers requested",
      "messageName": "extractAnswers",
      "performers": ["iap-extraction"],
      "jcr:reference:flowNodeType": "/WorkflowTypes/MessageStartEvent",
      "toRead": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toRead",
        "targetRef": "read"
      }
    },
    "read": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "read",
      "label": "Put the submission through its reading workflow",
      "handler": "startWorkflow",
      "workflowFrom": "schemaVersion/readingWorkflow",
      "replaceActive": true,
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "done"
      }
    },
    "done": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "done",
      "label": "Handed over",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
