<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:iap="https://iap.uhndata.io/bpmn"
                  id="reviewExtractionDefinitions"
                  targetNamespace="https://iap.uhndata.io/system/reviewExtraction">
  <bpmn:message id="reviewExtractionMessage" name="reviewExtraction" />
  <bpmn:process id="reviewExtraction" name="Record what the submitter said about a pre-filled answer"
                isExecutable="true">
    <bpmn:startEvent id="reviewed" iap:performers="everyone" name="Answer reviewed">
      <bpmn:messageEventDefinition id="reviewRequested" messageRef="reviewExtractionMessage" />
      <bpmn:outgoing>toRecord</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toRecord" sourceRef="reviewed" targetRef="record" />
    <bpmn:serviceTask id="record" iap:handler="reviewExtraction" name="Write down what they said">
      <bpmn:incoming>toRecord</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toDone" sourceRef="record" targetRef="done" />
    <bpmn:endEvent id="done" name="Review recorded">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="reviewExtractionDiagram">
    <bpmndi:BPMNPlane id="reviewExtractionPlane" bpmnElement="reviewExtraction">
      <bpmndi:BPMNShape id="reviewedShape" bpmnElement="reviewed">
        <dc:Bounds x="160" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="140" y="223" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="recordShape" bpmnElement="record">
        <dc:Bounds x="250" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doneShape" bpmnElement="done">
        <dc:Bounds x="400" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="378" y="223" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toRecordEdge" bpmnElement="toRecord">
        <di:waypoint x="196" y="198" />
        <di:waypoint x="250" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDoneEdge" bpmnElement="toDone">
        <di:waypoint x="350" y="198" />
        <di:waypoint x="400" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
