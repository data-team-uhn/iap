<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:iap="https://iap.uhndata.io/bpmn"
                  id="stopProcessingDefinitions"
                  targetNamespace="https://iap.uhndata.io/system/stopProcessing">
  <bpmn:message id="stopProcessingMessage" name="stopProcessing" />
  <bpmn:process id="stopProcessing" name="Stop reading a submission's documents" isExecutable="true">
    <bpmn:startEvent id="requested" iap:performers="everyone" name="Asked to stop">
      <bpmn:messageEventDefinition id="stopRequested" messageRef="stopProcessingMessage" />
      <bpmn:outgoing>toStop</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toStop" sourceRef="requested" targetRef="stop" />
    <!-- Drops a parse not yet read in, and stops a model call still going. -->
    <bpmn:serviceTask id="stop" iap:handler="stopProcessing" name="Stop the reading">
      <bpmn:incoming>toStop</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toDone" sourceRef="stop" targetRef="done" />
    <bpmn:endEvent id="done" name="Stopped">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="stopProcessingDiagram">
    <bpmndi:BPMNPlane id="stopProcessingPlane" bpmnElement="stopProcessing">
      <bpmndi:BPMNShape id="requestedShape" bpmnElement="requested">
        <dc:Bounds x="160" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="150" y="223" width="57" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="stopShape" bpmnElement="stop">
        <dc:Bounds x="250" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doneShape" bpmnElement="done">
        <dc:Bounds x="400" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="403" y="223" width="31" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toStopEdge" bpmnElement="toStop">
        <di:waypoint x="196" y="198" />
        <di:waypoint x="250" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDoneEdge" bpmnElement="toDone">
        <di:waypoint x="350" y="198" />
        <di:waypoint x="400" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
