<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:iap="https://iap.uhndata.io/bpmn"
                  id="readingStartedDefinitions"
                  targetNamespace="https://iap.uhndata.io/system/readingStarted">
  <bpmn:message id="readingStartedMessage" name="readingStarted" />
  <bpmn:process id="readingStarted" name="Claim the reading of a submission" isExecutable="true">
    <!-- Only the extraction module's own user may fire this: it is what runs the reading jobs -->
    <bpmn:startEvent id="started" iap:performers="iap-extraction" name="Reading job started">
      <bpmn:messageEventDefinition id="startedReceived" messageRef="readingStartedMessage" />
      <bpmn:outgoing>toTask</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toTask" sourceRef="started" targetRef="claim" />
    <bpmn:serviceTask id="claim" iap:handler="claimReading" name="Claim the reading">
      <bpmn:incoming>toTask</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toDone" sourceRef="claim" targetRef="claimed" />
    <bpmn:endEvent id="claimed" name="Claimed">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="readingStartedDiagram">
    <bpmndi:BPMNPlane id="readingStartedPlane" bpmnElement="readingStarted">
      <bpmndi:BPMNShape id="startedShape" bpmnElement="started">
        <dc:Bounds x="160" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="133" y="223" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="claimShape" bpmnElement="claim">
        <dc:Bounds x="250" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="claimedShape" bpmnElement="claimed">
        <dc:Bounds x="400" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="393" y="223" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toTaskEdge" bpmnElement="toTask">
        <di:waypoint x="196" y="198" />
        <di:waypoint x="250" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDoneEdge" bpmnElement="toDone">
        <di:waypoint x="350" y="198" />
        <di:waypoint x="400" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
