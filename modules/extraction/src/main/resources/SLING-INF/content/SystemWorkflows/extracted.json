{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Save the answers read out of a submission's documents",
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "tags": ["active"],
    "targetResourceType": "sub/Submission",
    "description": "Saves every answer the model read as a suggestion, and ends the reading.",
    "received": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "received",
      "label": "Answers read",
      "messageName": "extracted",
      "performers": ["iap-extraction"],
