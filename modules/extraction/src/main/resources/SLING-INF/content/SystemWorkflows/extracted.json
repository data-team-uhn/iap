      "toTask": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toTask",
        "targetRef": "record"
      }
    },
    "record": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "record",
      "label": "Save the answers",
      "handler": "recordExtraction",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "recorded"
      }
    },
    "recorded": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "recorded",
      "label": "Answers saved",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
