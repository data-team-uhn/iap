<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:iap="https://iap.uhndata.io/bpmn"
                  id="retryParseDefinitions"
                  targetNamespace="https://iap.uhndata.io/system/retryParse">
  <bpmn:message id="retryParseMessage" name="retryParse" />
  <bpmn:process id="retryParse" name="Send a submission's failed parses again" isExecutable="true">
    <bpmn:startEvent id="requested" iap:performers="everyone" name="Asked to try again">
      <bpmn:messageEventDefinition id="retryRequested" messageRef="retryParseMessage" />
      <bpmn:outgoing>toParse</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toParse" sourceRef="requested" targetRef="parse" />
    <!-- The same step the process runs the first time round, which is the whole point: it sends what still
         wants sending, so a second run picks up the uploads that failed and leaves the rest alone. -->
    <bpmn:serviceTask id="parse" iap:handler="parseDocuments" name="Send the uploads that failed again">
      <bpmn:incoming>toParse</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toDone" sourceRef="parse" targetRef="done" />
    <bpmn:endEvent id="done" name="Sent again">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="retryParseDiagram">
    <bpmndi:BPMNPlane id="retryParsePlane" bpmnElement="retryParse">
      <bpmndi:BPMNShape id="requestedShape" bpmnElement="requested">
        <dc:Bounds x="160" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="139" y="223" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="parseShape" bpmnElement="parse">
        <dc:Bounds x="250" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doneShape" bpmnElement="done">
        <dc:Bounds x="400" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="388" y="223" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toParseEdge" bpmnElement="toParse">
        <di:waypoint x="196" y="198" />
        <di:waypoint x="250" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDoneEdge" bpmnElement="toDone">
        <di:waypoint x="350" y="198" />
        <di:waypoint x="400" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
