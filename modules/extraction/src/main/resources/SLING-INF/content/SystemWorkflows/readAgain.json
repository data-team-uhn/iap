{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Read a submission's documents again",
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "tags": ["active"],
    "targetResourceType": "sub/Submission",
    "description": "Queues another reading of a submission's parsed documents.",
    "requested": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "requested",
      "label": "Asked to read again",
