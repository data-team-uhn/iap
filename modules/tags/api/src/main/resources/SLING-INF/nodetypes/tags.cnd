<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<doc = 'https://iap.uhndata.io/doc/'>
<tag = 'https://iap.uhndata.io/tag/'>
<data = 'https://iap.uhndata.io/data/'>

//-----------------------------------------------------------------------------
//
// Tags: named markers placed on content through its multivalued `tags`
// property, such as "incomplete", "submitted" or "retired".
//
// A tag can be placed only once it is defined by a tag:Definition under
// /Tags. The definition says what the tag means, where it may be placed and
// how it behaves. See docs/tags.md.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// The /Tags homepage, holding the tag definitions.
[tag:Homepage] > data:Content, rep:AccessControllable, doc:Documented
  query

  - sling:resourceType (STRING) = "tag/Homepage" mandatory autocreated protected

  // The node type a paginated listing of /Tags returns
  - childNodeType (STRING) = "tag:Definition" mandatory autocreated protected

  // The heading of the tag catalogue served at /Tags.doc.md. A deployment can
  // edit them to reword it.
  - title (STRING) = "Tags" autocreated
  - description (STRING) = "All the tags defined in this instance, grouped by category." autocreated

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The tag definitions
  + * (tag:Definition) = tag:Definition

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// The definition of one tag: what it means, where it may be placed, and how
// it behaves. Tagged content stores the tag as a plain string in its `tags`
// property, equal to the definition's name.
[tag:Definition] > data:Content
  - sling:resourceType (STRING) = "tag/Definition" mandatory autocreated protected

  // The string stored in the `tags` property of tagged content. When absent,
  // the tag's name is the name of this node. Set it for a tag string that
  // would be awkward as a node name.
  - name (STRING)

  // The tag's name as people read it. When absent, the UI shows the name.
  - label (STRING)

  // What the tag means and when it applies, in one short sentence
  - description (STRING)

  // The categories the tag belongs to, such as "lifecycle" or "review".
  // Listings group and filter tags by category.
  - category (STRING) multiple

  // Whether the content under a tagged node carries the tag too. Every
  // version of a "retired" schema is retired.
  - inheritable (BOOLEAN) = false autocreated

  // Whether a node carries the tag when content below it does, up to the
  // nearest tag:Boundary. A submission with an "incomplete" answer is
  // incomplete.
  - aggregated (BOOLEAN) = false autocreated

  // The resource types of the content the tag may be placed on, subtypes
  // included, such as "sub/Submission" or "data/Entity". When empty, it may
  // be placed on any content.
  - targetResourceTypes (STRING) multiple

  // The color the UI shows the tag in, as a CSS color. The chip's
  // background, text and border all derive from it, as the variant says.
  - color (STRING)

  // How the UI shows the tag. "soft", the default, tints the background with
  // the color and makes the text a readable shade of it. "outlined" shows
  // that text and a matching border on no background. "filled" fills the
  // chip with the color, under black or white text.
  - variant (STRING)

  // The icon shown next to the label, as a MUI icon name such as
  // "EditOutlined". A name the tags module's tagIcons.tsx does not list
  // shows no icon.
  - icon (STRING)

  // The tag's position in listings, lowest first. Tags without one come
  // last.
  - order (LONG)

  // Whether only the code managing the tag may add or remove it
  - system (BOOLEAN) = false autocreated

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured
