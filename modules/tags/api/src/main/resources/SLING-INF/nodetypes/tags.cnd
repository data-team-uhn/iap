<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<doc = 'https://iap.uhndata.io/doc/'>
<tag = 'https://iap.uhndata.io/tag/'>
<data = 'https://iap.uhndata.io/data/'>

//-----------------------------------------------------------------------------
//
// Tags: named markers that can be placed on any data:Content node through its
// multivalued `tags` property, e.g. "incomplete", "submitted", or "sensitive".
//
// Unlike free-form labels, every usable tag must first be *defined* as an
// tag:Definition node stored under /Tags: the definition is the single
// source of truth for what the tag means, where it may be applied, and how it
// behaves, instead of each piece of code relying on an off-hand understanding
// of ad-hoc marker strings.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// Homepage node for the /Tags root path, holding the tag definitions.
[tag:Homepage] > data:Content, rep:AccessControllable, doc:Documented
  // Attributes:

  // We can query tag definitions
  query

  // Properties:

  - sling:resourceType (STRING) = "tag/Homepage" mandatory autocreated protected

  // The type of the children listed by the pagination servlet
  - childNodeType (STRING) = "tag:Definition" mandatory autocreated protected

  // The heading of the served documentation, overriding the empty defaults of
  // the doc:Documented mixin. Autocreated rather than hardcoded in the model
  // serving the catalogue, but still editable, so that a deployment can reword
  // the heading without touching code.
  - title (STRING) = "Tags" autocreated
  - description (STRING) = "All the tags defined in this instance, grouped by category." autocreated

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Contains tag definitions
  + * (tag:Definition) = tag:Definition

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// The definition of one tag: what it means, where it may be placed, and how
// it behaves. The tag itself is stored on tagged nodes as a plain string in
// their `tags` property, matching this definition's name.
[tag:Definition] > data:Content
  - sling:resourceType (STRING) = "tag/Definition" mandatory autocreated protected

  // The string stored in the `tags` property of tagged nodes. When absent,
  // the name of this definition node itself is the tag name; setting an
  // explicit name allows tag strings that would be awkward as node names.
  - name (STRING)

  // Human-readable name displayed in the UI; falls back to the tag name
  - label (STRING)

  // Longer explanation of what this tag means and when it applies
  - description (STRING)

  // The categories this tag belongs to, e.g. "lifecycle" or "review",
  // used for grouping and filtering tags in listings
  - category (STRING) multiple

  // Whether content under a tagged node implicitly carries this tag too,
  // e.g. every answer inside a "sensitive" submission is itself sensitive
  - inheritable (BOOLEAN) = false autocreated

  // Whether a node implicitly carries this tag when any of its descendants
  // explicitly does, e.g. a submission with an "incomplete" answer is
  // itself incomplete
  - aggregated (BOOLEAN) = false autocreated

  // The sling:resourceType values of the content this tag may be placed
  // on, including their subtypes, e.g. "sub/Submission" or "data/Entity";
  // when empty, the tag may be placed on any content
  - targetResourceTypes (STRING) multiple

  // Optional color used when displaying this tag, as a CSS color value; the
  // chip's background, text and border are all derived from it, according to
  // the variant
  - color (STRING)

  // How the tag is displayed: "soft" (the default when absent) tints the
  // background with the color and clamps the color into a readable text,
  // "outlined" draws only that readable text and a matching border on a
  // transparent background, and "filled" uses the color as a loud fill
  // under contrasting text
  - variant (STRING)

  // Optional icon displayed next to this tag's label, as a MUI icon name,
  // e.g. "EditOutlined"; names outside the UI's curated icon set (see the
  // tags module's tagIcons.tsx) display no icon
  - icon (STRING)

  // Optional explicit position of this tag in listings; tags with a lower
  // order are displayed first, tags without an order are displayed last
  - order (LONG)

  // Whether this tag is managed by the platform itself, which prevents
  // adding or removing it through the regular user-facing APIs
  - system (BOOLEAN) = false autocreated

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured
