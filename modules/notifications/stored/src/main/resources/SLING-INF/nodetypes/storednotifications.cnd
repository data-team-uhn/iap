<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<nt = 'http://www.jcp.org/jcr/nt/1.0'>
<data = 'https://iap.uhndata.io/data/'>
<notif = 'https://iap.uhndata.io/notifications/'>


// The root of the stored notifications, /Notifications. It holds a folder for
// each recipient, which only they may read. As a data:EntityHomepage, it lists
// the notifications through the pagination servlet.
[notif:Homepage] > data:EntityHomepage
  // Attributes:

  // We can query the homepage
  query

  // Properties:

  - sling:resourceType (STRING) = "notif/Homepage" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "data/EntityHomepage" mandatory autocreated protected

  // The type of the children listed by the pagination servlet
  - childNodeType (STRING) = "notif:Notification" mandatory autocreated protected

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // One folder per recipient, holding their notifications in prefix-tree buckets
  + * (sling:Folder)
  + * (nt:base) = nt:unstructured

// One thing one person was told. The message is rendered when it is stored, so
// it reads the same after the template is reworded or the subject is deleted.
[notif:Notification] > data:Content
  // Attributes:

  // We can query notifications, such as to count somebody's unread ones
  query

  // Properties:

  - sling:resourceType (STRING) = "notif/Notification" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "data/Content" mandatory autocreated protected

  // The user id of the person this is for, the only person granted read on it
  - recipient (STRING) mandatory

  // The sentence shown to the recipient, such as `Your request was approved`
  - message (STRING) mandatory

  // What happened, as the event name, such as `approved`
  - event (STRING)

  // The path of the resource it is about, which the notification links to. A
  // path, since the resource may be deleted while the notification stays.
  - subject (PATH)

  // The user id of the person who caused it, if somebody did
  - actor (STRING)

  // How soon the recipient was to hear about it, such as `immediate` or `batched`
  - urgency (STRING)

  // Whether the recipient has marked it read. The recipient may change it.
  - read (BOOLEAN) = 'false' mandatory autocreated

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple
