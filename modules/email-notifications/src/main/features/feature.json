{
  "title": "IAP - Email notification support",
  "description": "Sending emails built from templates stored in the repository",
  "variables":{
    "emailnotifications.smtps.host":"localhost",
    "emailnotifications.smtps.port":"8465",
    "emailnotifications.smtps.checkserveridentity": "true",
    "emailnotifications.smtps.from":"",
    "emailnotifications.smtps.username":"username",
    "emailnotifications.smtps.password":"",
    "emailnotifications.messageidprovider.host": "localhost"
  },
  "bundles":[
    // Jakarta Mail 2.1 moved the implementation out of the API jar, and the API finds its
    // providers through ServiceLoader, which only crosses a bundle boundary when the framework
    // carries an osgi.serviceloader mediator. This launcher carries none, so the combined bundle
    // Angus publishes is what keeps the API and the SMTP provider in one classloader. Installing
    // jakarta.mail:jakarta.mail-api next to it is not belt and braces but a coin flip: both
    // export jakarta.mail 2.1.5, install order decides which one everything else wires to, and
    // sending fails outright when the API-only bundle wins. It stays a compile dependency only.
    {
      "id":"org.eclipse.angus:jakarta.mail:2.0.5",
      "start-order":"24"
    },
    // Jakarta Activation 2.1 split the same way, and the split leaves the API unable to find the
    // classes that write each part of a message. Rather than mediate that lookup -- which takes a
    // ServiceLoader extender, the angus-activation registry provider, and a fragment carrying a
    // mailcap file, all so a class name in a text file can be resolved -- the handlers are named at
    // compile time in AngusContentHandlers, which installs itself as the default command map. The
    // API bundle alone is then all the runtime needs. The one thing given up is the other registry:
    // with no MimeTypeRegistryProvider, FileTypeMap cannot guess a media type from a file name and
    // answers application/octet-stream, which costs nothing here because every attachment is sent
    // with an explicit type.
    {
      "id":"jakarta.activation:jakarta.activation-api:2.1.4",
      "start-order":"24"
    },
    {
      "id":"org.apache.commons:commons-text:1.15.0",
      "start-order":"24"
    },
    {
      "id":"org.apache.servicemix.bundles:org.apache.servicemix.bundles.jasypt:1.9.3_1",
      "start-order":"24"
    },
    {
      "id":"org.apache.sling:org.apache.sling.commons.crypto:1.1.0",
      "start-order":"24"
    },
    {
      "id":"org.apache.sling:org.apache.sling.commons.messaging:1.0.2",
      "start-order":"24"
    },
    {
      "id":"org.apache.sling:org.apache.sling.commons.messaging.mail:2.0.0",
      "start-order":"24"
    },
    {
      "id":"${project.groupId}:${project.artifactId}:${project.version}",
      "start-order":"25"
    }
  ],
  "configurations":{
    "org.apache.sling.commons.crypto.internal.EnvironmentVariablePasswordProvider~default":{
      "names":[
        "default"
      ],
      "name":"SLING_COMMONS_CRYPTO_PASSWORD"
    },
    "org.apache.sling.commons.crypto.jasypt.internal.JasyptRandomIvGeneratorRegistrar~default":{
      "algorithm": "SHA1PRNG"
    },
    "org.apache.sling.commons.crypto.jasypt.internal.JasyptRandomSaltGeneratorRegistrar~default":{
      "algorithm": "SHA1PRNG"
    },
    "org.apache.sling.commons.crypto.jasypt.internal.JasyptStandardPbeStringCryptoService~default":{
      "algorithm": "PBEWITHHMACSHA512ANDAES_256",
      "securityProviderName": "",
      "keyObtentionIterations": 1000,
      "names": [
        "default"
      ],
      "stringOutputType": "base64"
    },
    "org.apache.sling.commons.messaging.mail.internal.SimpleMailService~default":{
      "names": [
        "default"
      ],
      "threadpool.name": "default",
      "mail.smtps.from": "${emailnotifications.smtps.from}",
      "mail.smtps.host": "${emailnotifications.smtps.host}",
      "mail.smtps.port": "${emailnotifications.smtps.port}",
      "mail.smtps.ssl.checkserveridentity": "${emailnotifications.smtps.checkserveridentity}",
      "username": "${emailnotifications.smtps.username}",
      "password": "${emailnotifications.smtps.password}",
      "messageIdProvider.target": "(names=default)"
    },
    "org.apache.sling.commons.messaging.mail.internal.SimpleMessageIdProvider~default":{
      "host": "${emailnotifications.messageidprovider.host}",
      "names": [
        "default"
      ]
    }
  }
}
