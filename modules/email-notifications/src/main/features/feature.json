{
  "title": "IAP - Email notification support",
  "description": "Sends emails built from templates stored in the repository",
  "variables":{
    "emailnotifications.smtps.host":"localhost",
    "emailnotifications.smtps.port":"8465",
    "emailnotifications.smtps.checkserveridentity": "true",
    "emailnotifications.smtps.from":"",
    "emailnotifications.smtps.username":"username",
    "emailnotifications.smtps.password":"DFMeLL3AOICFmg4+uUoOx16clt6Xe0BMdNSBFqcuKiaVKMqfFudz3KOwM5Gj3t/g",
    "emailnotifications.messageidprovider.host": "localhost"
  },
  "bundles":[
    // The Jakarta Mail API and the Angus Mail implementation in one bundle. The API finds the SMTP
    // provider through ServiceLoader, which crosses no bundle boundary in this launcher, so the
    // two must share a bundle. Never install jakarta.mail:jakarta.mail-api beside it. Both
    // export jakarta.mail 2.1.5, and sending fails if the API-only bundle is the one wired.
    {
      "id":"org.eclipse.angus:jakarta.mail:${angus.mail.version}",
      "start-order":"24"
    },
    // The Jakarta Activation API alone. AngusContentHandlers gives it the classes that write
    // each part of a message. With no angus-activation, FileTypeMap cannot guess a media type
    // from a file name; every attachment here is sent with an explicit type.
    {
      "id":"jakarta.activation:jakarta.activation-api:${jakarta.activation.version}",
      "start-order":"24"
    },
    // The template engine of the subjects and bodies. It needs commons-lang3, which boot.json
    // installs.
    {
      "id":"org.apache.velocity:velocity-engine-core:${velocity.version}",
      "start-order":"24"
    },
    {
      "id":"org.apache.commons:commons-text:${commons.text.version}",
      "start-order":"24"
    },
    {
      "id":"org.apache.servicemix.bundles:org.apache.servicemix.bundles.jasypt:1.9.3_1",
      "start-order":"24"
    },
    {
      "id":"org.apache.sling:org.apache.sling.commons.crypto:${sling.commons.crypto.version}",
      "start-order":"24"
    },
    {
      "id":"org.apache.sling:org.apache.sling.commons.messaging:${sling.commons.messaging.version}",
      "start-order":"24"
    },
    {
      "id":"org.apache.sling:org.apache.sling.commons.messaging.mail:${sling.commons.messaging.mail.version}",
      "start-order":"24"
    },
    {
      // After iap-notifications-api (26), whose delivery extension point this implements
      "id":"${project.groupId}:${project.artifactId}:${project.version}",
      "start-order":"27"
    }
  ],
  "configurations":{
    "org.apache.sling.commons.crypto.internal.EnvironmentVariablePasswordProvider~default":{
      "names":[
        "default"
      ],
      "name":"SLING_COMMONS_CRYPTO_PASSWORD"
    },
    "org.apache.sling.commons.crypto.jasypt.internal.JasyptRandomIvGeneratorRegistrar~default":{
      "algorithm": "SHA1PRNG"
    },
    "org.apache.sling.commons.crypto.jasypt.internal.JasyptRandomSaltGeneratorRegistrar~default":{
      "algorithm": "SHA1PRNG"
    },
    "org.apache.sling.commons.crypto.jasypt.internal.JasyptStandardPbeStringCryptoService~default":{
      "algorithm": "PBEWITHHMACSHA512ANDAES_256",
      "securityProviderName": "",
      "keyObtentionIterations": 1000,
      "names": [
        "default"
      ],
      // iap-oidc-support configures a second Jasypt stack, "~iapoauth". Without these targets
      // the two stacks can bind each other's services, and one then reads an unset variable.
      "passwordProvider.target": "(names=default)",
      "ivGenerator.target": "(algorithm=SHA1PRNG)",
      "saltGenerator.target": "(algorithm=SHA1PRNG)",
      "stringOutputType": "base64"
    },
    "org.apache.sling.commons.messaging.mail.internal.SimpleMailService~default":{
      "names": [
        "default"
      ],
      "threadpool.name": "default",
      "mail.smtps.from": "${emailnotifications.smtps.from}",
      "mail.smtps.host": "${emailnotifications.smtps.host}",
      "mail.smtps.port": "${emailnotifications.smtps.port}",
      "mail.smtps.ssl.checkserveridentity": "${emailnotifications.smtps.checkserveridentity}",
      "username": "${emailnotifications.smtps.username}",
      "password": "${emailnotifications.smtps.password}",
      // This reference is greedy. Without the target it would bind the higher-ranked "~iapoauth"
      // CryptoService of iap-oidc-support, and decrypt `password` with the wrong key.
      "cryptoService.target": "(names=default)",
      "messageIdProvider.target": "(names=default)"
    },
    "org.apache.sling.commons.messaging.mail.internal.SimpleMessageIdProvider~default":{
      "host": "${emailnotifications.messageidprovider.host}",
      "names": [
        "default"
      ]
    }
  }
}
