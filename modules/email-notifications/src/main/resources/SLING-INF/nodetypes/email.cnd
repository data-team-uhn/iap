<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<nt = 'http://www.jcp.org/jcr/nt/1.0'>
<mail = 'https://iap.uhndata.io/mail/'>

//-----------------------------------------------------------------------------
//
// Email templates: the sender, subject and bodies of an email that the
// platform sends. A deployment can reword an email by editing its template.
// docs/notifications.md describes them.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// One email template. The bodies, and any header or footer of its own, are
// child files. Any other file child is an inline attachment, which the HTML
// body shows as `cid:<file name>`.
[mail:Template] > sling:Folder
  // Attributes:

  // Templates can be found by a query
  query

  // Properties:

  - sling:resourceType (STRING) = "mail/Template" mandatory autocreated protected

  // The address and display name the email is sent from, such as
  // `noreply@example.org` and `IAP`
  - senderAddress (STRING) mandatory
  - senderName (STRING)

  // The address and display name replies go to, if not the sender's
  - replyToAddress (STRING)
  - replyToName (STRING)

  // The subject line, a Velocity template such as `Your request ${subjectTitle}`
  - subject (STRING) mandatory

  // Any other single-valued property, except a `jcr:` or `sling:` one, is a
  // variable for the subject and the bodies. Multivalued ones are ignored.
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Children:

  // The Velocity templates of the HTML and plain text bodies. Either may be
  // left out, and an email needs at least one.
  + bodyTemplate.html (nt:file)
  + bodyTemplate.txt (nt:file)

  // `bodyTemplate.header.html`, `bodyTemplate.footer.html` and their `.txt`
  // twins replace the shared header and footer. Any other file is an inline
  // attachment.
  + * (nt:file)
