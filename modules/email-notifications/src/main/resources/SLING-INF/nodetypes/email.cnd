<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<nt = 'http://www.jcp.org/jcr/nt/1.0'>
<iap = 'https://iap.uhndata.io/'>

//-----------------------------------------------------------------------------
//
// Email templates: the sender, subject and body of an email that the platform
// sends, stored in the repository so that a deployment can reword it without
// touching code.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// One email template. The body parts live in `bodyTemplate.html` and
// `bodyTemplate.txt` child files; any other file child is included in the email
// as an inline attachment, referenced from the HTML body as `cid:<file name>`.
// Every other property becomes a variable available to the body templates.
[iap:EmailTemplate] > sling:Folder
  // Attributes:

  // We can look for templates in a query
  query

  // Properties:

  - sling:resourceType (STRING) = "iap/EmailTemplate" mandatory autocreated protected

  // The address and name the email is sent from
  - senderAddress (STRING) mandatory
  - senderName (STRING)

  // Where replies should go, when that is not the sender
  - replyToAddress (STRING)
  - replyToName (STRING)

  // The subject line, which may itself contain ${variable} placeholders
  - subject (STRING) mandatory

  // Any other property is a variable the body templates can substitute
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Children:

  // The body templates, either of which may be left out
  + bodyTemplate.html (nt:file)
  + bodyTemplate.txt (nt:file)

  // Any other file is included as an inline attachment
  + * (nt:file)
