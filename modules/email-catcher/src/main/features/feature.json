{
  "bundles":[
    {
      // Must start no earlier than the bundles whose node types it builds on: data:Content (21) and
      // data:EntityHomepage (24), nor than the bundle whose packages it now imports: iap-metrics (26). A bundle that starts before its exporter fails the feature analyser rather
      // than at runtime, which is why this trails the highest of them rather than sitting at 25.
      "id":"${project.groupId}:${project.artifactId}:${project.version}",
      "start-order":"27"
    }
  ],
  "configurations":{
    "org.apache.sling.serviceusermapping.impl.ServiceUserMapperImpl.amended~iapemailcatcher":{
      "user.mapping":[
        "io.uhndata.iap.email-catcher:emailcatcher=[iap-email-catcher]"
      ]
    }
  },
  "repoinit:TEXT|true": "@file"
}
