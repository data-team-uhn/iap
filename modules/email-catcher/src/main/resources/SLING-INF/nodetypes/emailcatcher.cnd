<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<data = 'https://iap.uhndata.io/data/'>
<mail = 'https://iap.uhndata.io/mail/'>

//-----------------------------------------------------------------------------
//
// What a development instance sends instead of mail: every message handed to
// the mail service, filed where it can be read back.
//
// This exists so that email can be exercised without a mail server, and it
// ships only in a development, test or demo distribution. A production
// distribution has no bundle declaring these types.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// Homepage node for the /CaughtMail root path.
[mail:CaughtMailHomepage] > data:EntityHomepage
  - sling:resourceType (STRING) = "mail/CaughtMailHomepage" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "data/EntityHomepage" mandatory autocreated protected

  // The type of the children listed by the pagination servlet, which is what lets .paginate.json
  // filter, sort and page the caught messages without this module serving a listing of its own
  - childNodeType (STRING) = "mail:CaughtMessage" mandatory autocreated protected

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The messages caught so far
  + * (mail:CaughtMessage) = mail:CaughtMessage

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// One message that would have been sent.
//
// Content rather than an entity: nothing references a caught message, nothing
// versions one, and it is a record of something that happened rather than a
// thing the institution works on.
//
// The addresses are stored as they were written on the message, display name
// and all, because what is worth checking is what a recipient would have seen
// in their client rather than a normalised form of it.
[mail:CaughtMessage] > data:Content
  - sling:resourceType (STRING) = "mail/CaughtMessage" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "data/Content" mandatory autocreated protected

  // What the message says it is
  - subject (STRING)

  // Who it is from, and where a reply would have gone
  - from (STRING) multiple
  - replyTo (STRING) multiple

  // Who would have received it. Kept apart rather than merged into one list:
  // whether an address was visible to the others is part of what is being
  // checked, and a bcc that read as a to would hide a real mistake.
  - to (STRING) multiple
  - cc (STRING) multiple
  - bcc (STRING) multiple

  // When the message was handed over. Stamped here rather than read from the
  // message's own Date header, which has second precision: this is what a
  // reader sorts by, and two messages sent in the same second would otherwise
  // be in no particular order. The Date header itself stays among the headers.
  - caughtAt (DATE) mandatory

  // The bodies, either of which may be absent: a message may be plain text
  // only, HTML only, or both
  - textBody (STRING)
  - htmlBody (STRING)

  // Every other header, as "Name: value" lines. Anything the platform sets
  // deliberately - a List-Unsubscribe, a reference to what a notification is
  // about - is checkable here without this type having to know about it.
  - headers (STRING) multiple

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured
