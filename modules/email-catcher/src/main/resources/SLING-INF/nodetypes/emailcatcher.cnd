<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<data = 'https://iap.uhndata.io/data/'>
<mail = 'https://iap.uhndata.io/mail/'>

//-----------------------------------------------------------------------------
//
// The messages the email catcher files instead of sending, while it is on.
// See docs/notifications.md.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// The node that answers, to anyone, whether mail is being caught. It sits
// under /libs/iap because /CaughtMail is readable by administrators alone.
[mail:CatcherStatus] > sling:Folder
  - sling:resourceType (STRING) = "mail/CatcherStatus" mandatory autocreated protected

//-----------------------------------------------------------------------------
// The homepage of the caught messages, at /CaughtMail.
[mail:CaughtMailHomepage] > data:EntityHomepage
  - sling:resourceType (STRING) = "mail/CaughtMailHomepage" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "data/EntityHomepage" mandatory autocreated protected

  // The node type that /CaughtMail.paginate.json lists
  - childNodeType (STRING) = "mail:CaughtMessage" mandatory autocreated protected

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The messages caught so far
  + * (mail:CaughtMessage) = mail:CaughtMessage

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// One message that would have been sent. It is content, not an entity:
// nothing references or versions it.
//
// The addresses are stored as the message wrote them, display names included,
// such as "The Sender <sender@example.com>".
[mail:CaughtMessage] > data:Content
  - sling:resourceType (STRING) = "mail/CaughtMessage" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "data/Content" mandatory autocreated protected

  - subject (STRING)

  // The sender, and where a reply would have gone
  - from (STRING) multiple
  - replyTo (STRING) multiple

  // The recipients, kept apart by kind, so that a reader can see which
  // addresses the other recipients would have seen
  - to (STRING) multiple
  - cc (STRING) multiple
  - bcc (STRING) multiple

  // When the catcher filed the message, to the millisecond. The message's own
  // Date header, which has second precision, stays among the headers.
  - caughtAt (DATE) mandatory

  // The bodies. A message may have a plain text body, an HTML body, or both.
  - textBody (STRING)
  - htmlBody (STRING)

  // Every other header, as "Name: value", such as "X-Reason: a reminder"
  - headers (STRING) multiple

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured
