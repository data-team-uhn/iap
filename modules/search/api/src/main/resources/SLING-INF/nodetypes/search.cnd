<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<data = 'https://iap.uhndata.io/data/'>

//-----------------------------------------------------------------------------
//
// Search: the node that /search.json, the search endpoint, is served from.
// The endpoint is described in docs/search.md.
//
// One node of this type sits at /search. It holds no data. It gives the
// search servlet a resource type to register on, and a path that access
// control applies to.
//
// The type does not extend data:Content. The endpoint is not content, so it
// takes no tags or links, and the DELETE servlet for data/Content does not
// serve it.
//
//-----------------------------------------------------------------------------

[data:Search] > sling:Folder
  // The resource type the search servlet is registered on
  - sling:resourceType (STRING) = "data/Search" mandatory autocreated protected
