<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<iap = 'https://iap.uhndata.io/'>

//-----------------------------------------------------------------------------
//
// Search: the endpoint that runs queries against the repository.
//
// A single node of this type is expected, at /search. It holds no data: it
// exists only to give the search servlet a resource to be registered on, so
// that the endpoint is a normal repository path, subject to normal access
// control, rather than a path reserved by a servlet registration.
//
// Deliberately NOT a data:Content: the endpoint is plumbing, not content, so
// it must not acquire tags, links, or the data/Content resource supertype,
// which would hand /search itself to the content deletion endpoint and let a
// DELETE archive the search endpoint. The archive types avoid the same trap,
// for the same reason; see deletion.cnd.
//
//-----------------------------------------------------------------------------

[iap:Search] > sling:Folder
  // Properties:

  // Hardcode the resource type, this is what the search servlet is registered on.
  - sling:resourceType (STRING) = "iap/Search" mandatory autocreated protected
