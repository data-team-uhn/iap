<test = 'https://iap.uhndata.io/test/'>

// The shapes an index meets: entities filed in buckets under a homepage, the descendants a
// listing filters on, at any depth, and descendants it does not
[test:Entity] > nt:unstructured, mix:referenceable
[test:Request] > test:Entity
[test:Answer] > nt:unstructured
[test:Review] > nt:unstructured
[test:Note] > nt:unstructured
[test:Flagged] mixin
