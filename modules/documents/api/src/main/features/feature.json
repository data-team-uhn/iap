{
  "bundles":[
    {
      "id":"${project.groupId}:${project.artifactId}:${project.version}",
      "start-order":"25"
    }
  ],
  "variables":{
    // Where the Docling daemon listens. A variable, not a plain value, so a launch can point IAP at a
    // daemon somewhere else: start.py passes -V docling.url=http://localhost:18765 for a local run, and
    // the default below is the compose service name (tools/deploy/generate_compose.py --docling).
    "docling.url":"http://docling:18765"
  },
  "configurations":{
    "org.apache.sling.serviceusermapping.impl.ServiceUserMapperImpl.amended~iapdocuments":{
      "user.mapping":[
        "io.uhndata.iap.documents-api:parse-jobs=[iap-documents]"
      ]
    },
    // How to reach the daemon, read by both callers: the dispatch and the stop. The daemon's own
    // token and the response timeout also go here, as "daemonToken" and "responseTimeout".
    // Where the daemon POSTs parse outcomes is set on the daemon itself
    // (IAP_DOCLING_CALLBACK_URL), not sent with the dispatch: that call carries the shared token and
    // the daemon's port is unauthenticated. The callback is authenticated with the shared JWT both
    // sides read from the IAP_DOCLING_CALLBACK_JWT environment variable. A "callbackToken" property on
    // the ...internal.ParseCallbackServlet and ...internal.ParseJobConsumer configurations overrides
    // it. Without a token the consumer refuses to dispatch, since no callback could be accepted.
    "io.uhndata.iap.documents.internal.DaemonConnection":{
      "daemonUrl":"${docling.url}"
    },
    // Only the daemon's callback, a failed dispatch or a stop ends a job, so a daemon killed mid-parse
    // leaves a job active for good, and everything waiting on it waits for good too. The sweep fails
    // such a job and deletes its staging folder. Half an hour is above the daemon's own quarter-hour
    // limit on a PDF conversion (a Word document has none), with room for the queue in front of it.
    // Raise it if parses really take longer.
    "io.uhndata.iap.documents.internal.StaleParseJobSweeper":{
      "maxAgeMinutes":30
    }
  },
  "repoinit:TEXT|true": "@file"
}
