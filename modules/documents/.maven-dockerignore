# What the docker-maven-plugin must not send when modules/documents is the context. Only the
# generation worker builds from here (generation/worker/Dockerfile); the Docling image's context
# is processing/, with its own ignore files.
#
# Keep this and .dockerignore identical, for the reason processing/.dockerignore gives.
# The Dockerfile names every file it copies, so this only keeps the context small: processing's
# .venv alone is ~100 MB.
api/
**/target/
**/.venv/
**/.pytest_cache/
**/.ruff_cache/
**/src/test/
**/__pycache__
**/*.pyc
