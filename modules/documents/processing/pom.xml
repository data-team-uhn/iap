<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.uhndata.iap</groupId>
    <artifactId>iap-documents</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>iap-processing</artifactId>
  <packaging>pom</packaging>
  <name>IAP - Document processing</name>
  <description>Document-processing pipeline (parsing, markdown cleanup, chunking).</description>

  <properties>
    <python.executable>python</python.executable>
  </properties>

  <build>
    <plugins>
      <!-- The Python sources carry license headers; exclude only the generated/config bits. -->
      <plugin>
        <groupId>org.apache.rat</groupId>
        <artifactId>apache-rat-plugin</artifactId>
        <configuration>
          <inputExcludes combine.children="append">
            <exclude>**/__pycache__/**</exclude>
            <exclude>pytest.ini</exclude>
            <exclude>ruff.toml</exclude>
            <exclude>.dockerignore</exclude>
            <exclude>.maven-dockerignore</exclude>
          </inputExcludes>
        </configuration>
      </plugin>

      <!-- Run the pytest suite during the test phase, honouring the shared skipTests flag.
           Needs Python on the PATH with the packages in requirements-test.txt installed;
           CI does that in .github/workflows/pull-request-build.yml. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <!-- Lint before the tests: a duplicate import or an unused name is cheaper to
                 hear about than a test failure, and nothing else in the build checks Python. -->
            <id>lint-parsing-python</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${skipTests}</skip>
              <executable>${python.executable}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>-m</argument>
                <argument>ruff</argument>
                <argument>check</argument>
                <argument>src</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>run-parsing-python-tests</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${skipTests}</skip>
              <executable>${python.executable}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>-m</argument>
                <argument>pytest</argument>
                <argument>src/test/python</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <!-- If Docker is available&activated, also build the Docling parser daemon image -->
      <id>docker</id>
      <activation>
        <activeByDefault>false</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <configuration>
              <images>
                <image>
                  <name>iap/docling:%l</name>
                  <build>
                    <contextDir>${project.basedir}</contextDir>
                    <dockerFile>Dockerfile</dockerFile>
                  </build>
                </image>
              </images>
            </configuration>
            <executions>
              <execution>
                <id>build</id>
                <phase>package</phase>
                <goals>
                  <goal>build</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
