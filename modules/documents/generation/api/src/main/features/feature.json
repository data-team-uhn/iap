{
  "bundles":[
    {
      "id":"${project.groupId}:${project.artifactId}:${project.version}",
      "start-order":"25"
    }
  ],
  "variables":{
    // Where the generation worker listens. A variable, as docling.url is, so a local run can point IAP at a
    // worker on localhost: start.py passes -V generation.url=http://localhost:18766, and the default below is
    // the compose service name (tools/deploy/generate_compose.py --generation).
    "generation.url":"http://generation:18766"
  },
  "configurations":{
    // The worker's own token, when it requires one, is read from the IAP_GENERATION_TOKEN environment variable
    // unless a "workerToken" property is set here.
    "io.uhndata.iap.documents.generation.internal.WorkerDocumentGenerator":{
      "workerUrl":"${generation.url}"
    }
  }
}
