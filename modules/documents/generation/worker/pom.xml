<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.uhndata.iap</groupId>
    <artifactId>iap-documents-generation</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>iap-documents-generation-worker</artifactId>
  <packaging>pom</packaging>
  <name>IAP - Document generation worker</name>
  <description>The worker filling .docx templates with docxtpl and converting them with LibreOffice.</description>

  <properties>
    <!-- python3, not python, for the reason the processing module gives -->
    <python.executable>python3</python.executable>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.rat</groupId>
        <artifactId>apache-rat-plugin</artifactId>
        <configuration>
          <inputExcludes combine.children="append">
            <exclude>**/__pycache__/**</exclude>
            <exclude>pytest.ini</exclude>
            <exclude>ruff.toml</exclude>
          </inputExcludes>
        </configuration>
      </plugin>

      <!-- Ruff, then pytest, through the utils module's run_check.py. The tests import the shared
           helpers from utils/src/main/python too; see src/test/python/conftest.py. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>lint-generation-python</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${skipTests}</skip>
              <executable>${python.executable}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>-B</argument>
                <argument>../../utils/run_check.py</argument>
                <argument>ruff</argument>
                <argument>check</argument>
                <argument>src</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>run-generation-python-tests</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${skipTests}</skip>
              <executable>${python.executable}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>-B</argument>
                <argument>../../utils/run_check.py</argument>
                <argument>pytest</argument>
                <argument>src/test/python</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <!-- If Docker is available&activated, also build the generation worker image -->
      <id>docker</id>
      <activation>
        <activeByDefault>false</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <configuration>
              <images>
                <image>
                  <name>iap/generation</name>
                  <build>
                    <!-- modules/documents, so the image can take the shared helpers from utils/
                         as well as its own code; the Dockerfile says which files -->
                    <contextDir>${project.basedir}/../..</contextDir>
                    <dockerFile>generation/worker/Dockerfile</dockerFile>
                  </build>
                </image>
              </images>
            </configuration>
            <executions>
              <execution>
                <id>build</id>
                <phase>package</phase>
                <goals>
                  <goal>build</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
