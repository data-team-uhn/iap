<auth = 'https://iap.uhndata.io/auth/'>

//-----------------------------------------------------------------------------
//
// Authored: marks content whose last-writing user is tracked in
// jcr:lastModified at the time indicated by jcr:lastModifiedBy.
// These are like mix:versionable except they propagate upwards to all nodes
// with the mixin.
//
//-----------------------------------------------------------------------------
[auth:Authored]
  mixin

  // The user attributed with the commit that last touched this node.
  // System-maintained, do not write manually.
  - jcr:lastModified (DATE) IGNORE
  - jcr:lastModifiedBy (STRING) IGNORE
