// Session limits.
//
// The session cookie is signed with a key every instance sharing the repository uses. Only this module's
// service user may read it, and set it the first time it is needed.
{
  "bundles":[
    {
      // Before the identity provider's sign-in at 25, whose cookie manager uses this module's API
      "id":"${project.groupId}:${project.artifactId}:${project.version}",
      "start-order":"24"
    }
  ],
  "configurations":{
    "io.uhndata.iap.auth.sessions.internal.SessionCookiesImpl":{
      "idleMinutes:Integer":30,
      "maximumHours:Integer":8
    },
    "org.apache.sling.jcr.repoinit.RepositoryInitializer~iap-sessions":{
      "scripts":[
        "create path (rep:Unstructured) /jcr:system/iap-sessions/SigningKey \n set ACL for everyone \n   deny jcr:all on /jcr:system/iap-sessions \n end",
        "create service user iap-session-keeper \n set ACL for iap-session-keeper \n   allow jcr:read on /jcr:system/iap-sessions \n   allow jcr:read,jcr:modifyProperties on /jcr:system/iap-sessions/SigningKey \n end"
      ]
    },
    "org.apache.sling.serviceusermapping.impl.ServiceUserMapperImpl.amended~iap-sessions":{
      "user.mapping":[
        "io.uhndata.iap.sessions=[iap-session-keeper]"
      ]
    }
  }
}
