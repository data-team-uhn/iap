// Keycloak / OIDC sign-in.
//
// Signs users in through Keycloak with the Apache Sling OAuth client. Its OidcIdentityProvider
// lets Oak's DefaultSyncHandler provision each user into Oak. Their Keycloak realm roles become
// group principals that ACLs can name.
//
// Three names tie the configurations below together. Each must be the same in every place listed:
//   * connection name "keycloak": the OIDC provider connection (OidcConnectionImpl.name,
//     OidcAuthenticationHandler.defaultConnectionName, SlingUserInfoProcessorImpl.connection,
//     and the entry-point query parameter ?c=keycloak).
//   * idp name "keycloak": the ExternalIdentityProvider the authentication handler registers
//     (OidcAuthenticationHandler.idp, ExternalLoginModuleFactory.idp.name, SlingLoginCookieManager.idpName).
//   * sync handler name "keycloak": links the JAAS login module to the sync handler
//     (ExternalLoginModuleFactory.sync.handlerName, DefaultSyncHandler.handler.name).
//
// The bundles are the ones the OAuth client's published main.slingosgifeature lists for 0.1.6,
// except oak-auth-external, which oak/oak_base.json ships.
//
// Runtime environment variables (resolved by the configadmin interpolation plugin declared in
// boot.json): FRONTEND_KEYCLOAK_REALM_URL, BACKEND_KEYCLOAK_REALM_URL, KEYCLOAK_CLIENT_ID,
// KEYCLOAK_CLIENT_SECRET, IAP_PUBLIC_URL, and IAP_OAUTH_ENCRYPTION_PASSWORD. See docs/keycloak-oidc.md.
{
    "bundles":[
        { "id":"com.nimbusds:oauth2-oidc-sdk:11.23.1", "start-order":"24" },
        { "id":"com.nimbusds:nimbus-jose-jwt:10.0.2", "start-order":"24" },
        { "id":"com.nimbusds:content-type:2.3", "start-order":"24" },
        { "id":"com.nimbusds:lang-tag:1.7", "start-order":"24" },
        { "id":"org.apache.servicemix.bundles:org.apache.servicemix.bundles.jcip-annotations:1.0_2", "start-order":"24" },
        { "id":"net.minidev:json-smart:2.5.1", "start-order":"24" },
        { "id":"net.minidev:accessors-smart:2.5.1", "start-order":"24" },
        { "id":"org.ow2.asm:asm:${asm.version}", "start-order":"24" },
        { "id":"org.apache.sling:org.apache.sling.commons.crypto:${sling.commons.crypto.version}", "start-order":"24" },
        { "id":"org.apache.servicemix.bundles:org.apache.servicemix.bundles.jasypt:1.9.3_1", "start-order":"24" },
        { "id":"org.apache.sling:org.apache.sling.auth.oauth-client:${sling.auth.oauth-client.version}", "start-order":"25" },
        { "id":"${project.groupId}:${project.artifactId}:${project.version}", "start-order":"25" }
    ],
    "configurations":{
        // Token encryption. The UserInfo processor and the authentication handler both require a
        // CryptoService, even with token storage off. Another module can run its own Jasypt stack
        // in the same instance, so this one names its own parts by target filter. Untargeted, the
        // stacks cross-bind, and one of them reads an environment variable that is not set.
        "org.apache.sling.commons.crypto.jasypt.internal.JasyptRandomIvGeneratorRegistrar~iapoauth":{
            "algorithm":"DRBG"
        },
        "org.apache.sling.commons.crypto.jasypt.internal.JasyptRandomSaltGeneratorRegistrar~iapoauth":{
            "algorithm":"DRBG"
        },
        "org.apache.sling.commons.crypto.internal.EnvironmentVariablePasswordProvider~iapoauth":{
            "names":["iap-oauth"],
            "name":"IAP_OAUTH_ENCRYPTION_PASSWORD"
        },
        // The OAuth client's CryptoService references are untargeted, and their generated names
        // ($000, $005, ...) can change on upgrade. The ranking makes them bind this service rather
        // than another stack's.
        "org.apache.sling.commons.crypto.jasypt.internal.JasyptStandardPbeStringCryptoService~iapoauth":{
            "algorithm":"PBEWITHHMACSHA512ANDAES_256",
            "names":["iap-oauth"],
            "service.ranking:Integer":100,
            // The generator registrars publish an algorithm, but no names
            "ivGenerator.target":"(algorithm=DRBG)",
            "saltGenerator.target":"(algorithm=DRBG)",
            "passwordProvider.target":"(names=iap-oauth)"
        },

        // --- OAuth client token store + login cookie ------------------------------------------
        // The OAuth client keeps tokens in the signed-in user's home. idpName is the idp name above.
        "org.apache.sling.auth.oauth_client.impl.JcrUserHomeOAuthTokenStore":{
        },
        "org.apache.sling.auth.oauth_client.impl.SlingLoginCookieManager":{
            "idpName":"keycloak"
        },

        // --- The Keycloak connection ----------------------------------------------------------
        // Every endpoint is given here, under the realm root. The authorization endpoint and the
        // issuer use the URL the browser reaches Keycloak by. The others use the URL IAP reaches it by.
        "org.apache.sling.auth.oauth_client.impl.OidcConnectionImpl~keycloak": {
            "name": "keycloak",
            // The browser's URL
            "authorizationEndpoint": "$[env:FRONTEND_KEYCLOAK_REALM_URL]/protocol/openid-connect/auth",
            "issuer":                "$[env:FRONTEND_KEYCLOAK_REALM_URL]",
            // IAP's URL
            "tokenEndpoint": "$[env:BACKEND_KEYCLOAK_REALM_URL]/protocol/openid-connect/token",
            "jwkSetURL":     "$[env:BACKEND_KEYCLOAK_REALM_URL]/protocol/openid-connect/certs",
            "userInfoUrl":   "$[env:BACKEND_KEYCLOAK_REALM_URL]/protocol/openid-connect/userinfo",
            "clientId": "$[env:KEYCLOAK_CLIENT_ID]",
            "clientSecret": "$[env:KEYCLOAK_CLIENT_SECRET]",
            "scopes": ["openid","profile","email"]
        },

        // --- Claim -> user/group mapping ------------------------------------------------------
        // groupsClaimName names the flat top-level claim that a Keycloak protocol mapper fills
        // with the realm roles (see docs/keycloak-oidc.md). With idpNameInPrincipals false, a
        // group principal is the plain role name, such as "reader". Changing it renames every
        // principal, and every ACL naming one stops matching.
        "org.apache.sling.auth.oauth_client.impl.SlingUserInfoProcessorImpl":{
            "connection":"keycloak",
            "groupsClaimName":"groups",
            "groupsInIdToken":true,
            "idpNameInPrincipals":false,
            "storeAccessToken":false,
            // The back-channel logout presents it to Keycloak
            "storeRefreshToken":true
        },

        // --- The Sling authentication handler -------------------------------------------------
        // Covering "/", it reads the sling.oidcauth session cookie on any request the form handler
        // finds no credentials in, so a Keycloak sign-in holds across the whole site. Its low
        // service.ranking puts the form handler first at "/", so a signed-out user is sent to
        // /login. "/oidc-login" is more specific than "/", so there this handler starts the
        // Keycloak sign-in whatever its ranking. idp names the ExternalIdentityProvider it
        // registers, which the external login module below uses. callbackUri must exactly match a
        // Valid Redirect URI registered on the Keycloak client.
        "org.apache.sling.auth.oauth_client.impl.OidcAuthenticationHandler~keycloak":{
            "path":["/","/oidc-login"],
            "service.ranking:Integer":"-1000",
            "idp":"keycloak",
            "defaultConnectionName":"keycloak",
            "callbackUri":"$[env:IAP_PUBLIC_URL]/system/sling/oauth/callback",
            "pkceEnabled":true,
            "userInfoEnabled":true
        },

        // --- Oak provisioning: sync handler ---------------------------------------------------
        // Provisions the user on sign-in, under /home/users/oidc. Dynamic membership stores the
        // Keycloak roles as rep:externalPrincipalNames, with no local group node per role. The
        // ExternalPrincipalConfiguration below exposes them as principals. For full
        // synchronisation, with local group nodes, set user.dynamicMembership to false and remove
        // the ExternalPrincipalConfiguration wiring.
        // Each user.propertyMapping entry is local=external. The profile entries name Keycloak
        // claims: check them against a real token. refresh_token is not a claim: the OAuth
        // client adds it, encrypted.
        "org.apache.jackrabbit.oak.spi.security.authentication.external.impl.DefaultSyncHandler~keycloak":{
            "handler.name":"keycloak",
            "user.dynamicMembership":true,
            "user.expirationTime":"0", // Resync on every sign-in
            "user.membershipExpTime":"1h",
            "user.membershipNestingDepth:Integer":"1",
            "user.pathPrefix":"oidc",
            "user.propertyMapping":["rep:fullname=name","profile/email=email","oauth/refresh_token=refresh_token"]
        },

        // --- Oak provisioning: external login module ------------------------------------------
        // Adds the OidcIdentityProvider (idp.name) to the JAAS stack and binds it to the sync
        // handler above. The factory defaults to jaas.controlFlag=SUFFICIENT and
        // jaas.ranking=150, so a local username and password that this provider cannot handle
        // fall through to Oak's LoginModuleImpl.
        "org.apache.jackrabbit.oak.spi.security.authentication.external.impl.ExternalLoginModuleFactory~keycloak":{
            "idp.name":"keycloak",
            "sync.handlerName":"keycloak"
        },

        // --- Oak provisioning: external principal configuration -------------------------------
        // Exposes the role principals in rep:externalPrincipalNames to the principal manager, so
        // ACLs can name them. It is also listed in the SecurityProviderRegistration's
        // requiredServicePids in oak/oak_base.json.
        "org.apache.jackrabbit.oak.spi.security.authentication.external.impl.principal.ExternalPrincipalConfiguration":{
        },

        // --- OIDC end-session servlet ---------------------------------------------------------
        // The fallback for when the back-channel logout fails: the servlet redirects the browser to
        // Keycloak's end-session endpoint. The browser makes this call, so it uses the frontend URL.
        "io.uhndata.iap.auth.oidc.impl.OidcEndSessionServlet":{
            "endSessionEndpoint":"$[env:FRONTEND_KEYCLOAK_REALM_URL]/protocol/openid-connect/logout",
            "clientId":"$[env:KEYCLOAK_CLIENT_ID]",
            "postLogoutRedirectUri":"$[env:IAP_PUBLIC_URL]/login"
        },

        // Back-channel logout: IAP posts the user's refresh token to Keycloak, which ends the SSO
        // session without asking the user. IAP makes this call, so it uses the backend URL. A blank
        // endpoint leaves only the redirect.
        "io.uhndata.iap.auth.oidc.impl.OidcLogoutAuthenticationHandler":{
            "backchannelLogoutEndpoint":"$[env:BACKEND_KEYCLOAK_REALM_URL]/protocol/openid-connect/logout",
            "clientId":"$[env:KEYCLOAK_CLIENT_ID]",
            "clientSecret":"$[env:KEYCLOAK_CLIENT_SECRET]"
        }
    },

    // /oidc-login, where the sign-in button leads. The OIDC handler covers this path more
    // specifically than the form handler, so a request here starts the Keycloak sign-in. The
    // OAuth client returns the user to the same path, where the sling:redirect sends them on to /.
    "repoinit:TEXT|true": "@file"
}
