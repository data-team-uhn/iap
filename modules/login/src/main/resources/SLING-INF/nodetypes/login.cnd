<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<app = 'https://iap.uhndata.io/app/'>

//-----------------------------------------------------------------------------
// The login page, at /login: the only page a visitor without a session can reach.
[app:LoginPage] > sling:Folder
  query

  - sling:resourceType (STRING) = "app/LoginPage" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "data/Content" mandatory autocreated protected
  - title (String) = "${platform.name} - Sign in" mandatory autocreated
