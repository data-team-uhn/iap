<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<tag = 'https://iap.uhndata.io/tag/'>
<data = 'https://iap.uhndata.io/data/'>
<sch = 'https://iap.uhndata.io/sch/'>
<datareq = 'https://iap.uhndata.io/datareq/'>


[datareq:CataloguesHomepage] > data:EntityHomepage
  - sling:resourceType (STRING) = "datareq/CataloguesHomepage" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "data/EntityHomepage" mandatory autocreated protected

  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  + * (datareq:Catalogue) = datareq:Catalogue

  + * (nt:base) = nt:unstructured

// What data a submitter may be asked to choose from: one source system, or several gathered under one
// name. The catalogue itself only identifies the collection; what it actually holds lives in its
// versions, so that a catalogue can be republished without disturbing anything already filed
// against it.
[datareq:Catalogue] > data:Entity, tag:Boundary
  - sling:resourceType (STRING) = "datareq/Catalogue" mandatory autocreated protected

  - title (STRING) mandatory

  - description (STRING)

  - active (BOOLEAN) = false

  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  + * (datareq:CatalogueVersion)

  + * (nt:base) = nt:unstructured

// One published state of a catalogue, and the unit a selection is made against. Immutable in
// practice: a source system that gains or loses fields is republished as a new version, so a
// selection keeps meaning exactly what it meant when it was made.
//
// Named v1, v2 — never 1.0. A dot in a node name breaks Sling path resolution, since what follows it
// parses as a selector; the readable label lives in the `version` property.
[datareq:CatalogueVersion] > data:Entity, tag:Boundary
  orderable

  - sling:resourceType (STRING) = "datareq/CatalogueVersion" mandatory autocreated protected

  - version (STRING) mandatory

  - description (STRING)

  - active (BOOLEAN) = false

  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  + * (datareq:Database)

  + * (nt:base) = nt:unstructured

// One source system within a catalogue version.
//
// `identifier`, here as on the levels below it, is the source's own name for the thing. The three of
// them together are what a chosen field is recorded as, so they are the durable half of a catalogue:
// renaming one rewrites every key built from it.
[datareq:Database] > data:EntityPart
  orderable

  - sling:resourceType (STRING) = "datareq/Database" mandatory autocreated protected

  - identifier (STRING) mandatory

  - label (STRING)

  - description (STRING)

  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  + * (datareq:Collection)

  + * (nt:base) = nt:unstructured

// A named group of fields within a database — what the interface calls a collection, whatever the
// source system calls it. `label` is what a reader is shown, falling back to the identifier.
[datareq:Collection] > data:EntityPart
  orderable

  - sling:resourceType (STRING) = "datareq/Collection" mandatory autocreated protected

  - identifier (STRING) mandatory

  - label (STRING)

  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  + * (datareq:Field)

  + * (nt:base) = nt:unstructured

// One field a submitter may ask for.
[datareq:Field] > data:EntityPart
  orderable

  - sling:resourceType (STRING) = "datareq/Field" mandatory autocreated protected

  - identifier (STRING) mandatory

  - label (STRING)

  - description (STRING)

  - cardinality (STRING)

  - dataType (STRING)

  // Deliberately without a default: absent means nobody has assessed this field, which a reader has
  // to be able to tell from assessed and found clear. A source whose fields carry no assessment
  // shows no badge at all rather than a reassuring one.
  - phi (BOOLEAN)

  - example (STRING)

  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  + * (nt:base) = nt:unstructured

// A requirement asking the submitter which data they need, answered by choosing fields out of a
// catalogue.
//
// It names the catalogue rather than one of its versions, which is the opposite of how a schema
// version names an exact workflow version. A workflow decides what *happens* to a submission, so a
// schema freezes it; a catalogue only decides what is *available to pick*, and freezing it here
// would make every republication of a source system require a new schema version. The version a
// given submitter chose from is recorded on their selection instead.
[datareq:DataRequirement] > sch:Requirement
  - sling:resourceType (STRING) = "datareq/DataRequirement" mandatory autocreated protected

  - catalogue (REFERENCE) mandatory

// The fields chosen in answer to one data requirement, as a part of the submission that holds them.
//
// Fields are held by key rather than by reference on purpose. A catalogue version is a full copy, so
// a field that did not change between two versions is still two different nodes, and a reference
// would have to be rewritten on every republication; a key is stable by construction. It is also
// what an export outside this platform carries, so a selection assembled elsewhere means the same
// thing here.
[datareq:Selection] > data:EntityPart, mix:referenceable, mix:lastModified
  - sling:resourceType (STRING) = "datareq/Selection" mandatory autocreated protected

  - fulfills (REFERENCE) mandatory

  // Recorded when the selection is first made and never moved afterwards: this is what keeps a
  // filed submission meaning what it meant, whatever has been published since.
  - catalogueVersion (REFERENCE) mandatory

  - fields (STRING) multiple

  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  + * (nt:base) = nt:unstructured
