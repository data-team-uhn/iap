<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.uhndata.iap</groupId>
    <artifactId>iap-data-requirement</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>iap-data-requirement-impl</artifactId>
  <packaging>bundle</packaging>
  <name>IAP - Data requirement - Implementation</name>
  <description>Projecting a data requirement onto a form, and recording what was chosen.</description>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <extensions>true</extensions>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>iap-data-requirement-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The form projection's extension point, and the submission a selection is written onto -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>iap-submissions-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>iap-schemas-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Recording a selection is a workflow event, not a write: this is the handler extension point -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>iap-workflows</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- A Selection is an EntityPart is a Content: the hierarchy has to be on the compile classpath even
         where this code names none of it -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>iap-data-content-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>iap-data-entities-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.sling</groupId>
      <artifactId>org.apache.sling.api</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.json</groupId>
      <artifactId>jakarta.json-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
    </dependency>
    <!-- A REFERENCE cannot be written through the resolver, so the selection is referenced through JCR -->
    <dependency>
      <groupId>javax.jcr</groupId>
      <artifactId>jcr</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.sling</groupId>
      <artifactId>org.apache.sling.testing.sling-mock.junit5</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.parsson</groupId>
      <artifactId>parsson</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Whether a request is still a draft is a tag, and the tags service does not run under sling-mock -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>iap-tags-api</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
    </dependency>
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
    </dependency>
  </dependencies>
</project>
