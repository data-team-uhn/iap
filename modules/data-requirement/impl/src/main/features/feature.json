// The whole data requirement feature: the definitions and the code that acts on them. A distribution
// that wants data requirements takes this one file and gets both bundles.
{
  "bundles": [
    {
      // The definitions: node types, models, and the content under /libs and /Extensions.
      // After schemas (27), whose sch:Requirement a data requirement extends: node types register in
      // bundle start order, and a type naming an unregistered supertype takes the whole file down with it
      "id": "${project.groupId}:iap-data-requirement-api:${project.version}",
      "start-order": "28"
    },
    {
      // The describer, the part creator, the completeness evaluator and the save handler, all of which
      // read the types above
      "id": "${project.groupId}:${project.artifactId}:${project.version}",
      "start-order": "28"
    }
  ],
  "configurations": {
    "org.apache.sling.jcr.repoinit.RepositoryInitializer~data-requirement": {
      "service.ranking:Integer": 300,
      "scripts": [
        "create path (datareq:CataloguesHomepage) /Catalogues",
        // Catalogues are readable by everyone. A submitter has to see what is on offer to choose from it, and
        // a reviewer needs the catalogue version to read a filed selection's keys. Changes still go through
        // the workflow engine.
        "set ACL on /Catalogues \n allow jcr:read for everyone \n end"
      ]
    }
  }
}
