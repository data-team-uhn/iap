<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<rep = 'internal'>
<doc = 'https://iap.uhndata.io/doc/'>
<link = 'https://iap.uhndata.io/link/'>
<data = 'https://iap.uhndata.io/data/'>

//-----------------------------------------------------------------------------
//
// Links: typed connections from a resource, kept in its link:links child. A
// link points at other content in the repository (link:Link, link:WeakLink),
// or records a value naming something outside it, such as an identifier in
// another system (link:ExternalLink). A relation that is part of a node type's
// own shape is a REFERENCE property of that type instead.
//
// Every link type is defined by a link:Definition node under /LinkTypes: what
// the link means, what it may connect, and how it behaves. docs/links.md
// explains the design.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// The homepage at /LinkTypes, which holds the link definitions.
[link:TypesHomepage] > data:Content, rep:AccessControllable, doc:Documented
  // We can query link definitions
  query

  - sling:resourceType (STRING) = "link/TypesHomepage" mandatory autocreated protected

  // The title and introduction of the catalogue of link types, which a
  // deployment can edit
  - title (STRING) = "Link types" autocreated
  - description (STRING) = "All the link types defined in this instance." autocreated

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The link definitions. There is no default type: link:Definition is
  // abstract, so each definition names its kind.
  + * (link:Definition)

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A type of link: what a link of this type means, what it may connect, and how
// it behaves. It is abstract. Each kind below holds the settings that depend on
// where the target lives.
//
// The residual property definitions accept a setting of the other kind too.
// The model ignores it.
[link:Definition] > data:Content, mix:referenceable, mix:lastModified
  abstract

  - sling:resourceType (STRING) = "link/Definition" mandatory autocreated protected

  // The name of the link type, as people read it; the node name if unset
  - label (STRING)

  // What this type of link means and when it applies, shown in the catalogue
  - description (STRING)

  // Whether a user interface should show links of this type. A hint, not
  // access control: anybody who can read a resource can read its links.
  - displayed (BOOLEAN) = true

  // The node types the content holding the link must have, any one of them.
  // Any content may hold it when unset.
  - requiredSourceTypes (NAME) multiple

  // A template for the label of the link's target, such as
  // "{typeLabel}: {name}". Its placeholders:
  // - {name}: the target's node name
  // - {property:xyz}: one of the target's properties
  // - {label}: the link's own label
  // - {typeLabel}: this definition's label
  // - {sourceName}: the node name of the content holding the link
  // - {value}: an external link's recorded value
  // Without a template, the label is the target's node name, or the value.
  - targetLabelTemplate (STRING)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A type of link to content in this repository, held by link:Link or
// link:WeakLink nodes. It says what a link may point at, what happens when the
// target is deleted, and whether the target links back.
[link:InternalDefinition] > link:Definition
  - sling:resourceType (STRING) = "link/InternalDefinition" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "link/Definition" mandatory autocreated protected

  // Whether the links hold a WEAKREFERENCE, which lets the target be deleted,
  // rather than a REFERENCE, which stops the deletion
  - weak (BOOLEAN) = false

  // The node types the linked content must have, any one of them. Any content
  // may be linked to when unset.
  - requiredDestinationTypes (NAME) multiple

  // The path of the definition of the reverse link, which goes from the linked
  // content back to the content holding the link. A definition may name
  // itself. The reverse is added with the link when the user may add it, and
  // by the links service user after the commit otherwise.
  - backlink (PATH)

  // Whether links of this type are only created as the reverse of another
  // link, never directly
  - backlinkOnly (BOOLEAN) = false

  // What happens when the linked content is deleted:
  // - IGNORE: the link stays, pointing at nothing; only valid for weak links
  // - REMOVE_LINK: the link is removed (the default)
  // - RECURSIVE_DELETE: the content holding the link is deleted too
  // docs/deletion.md describes how a deletion applies it.
  - onDelete (STRING) = "REMOVE_LINK" mandatory autocreated

//-----------------------------------------------------------------------------
// A type of link that records a value naming something outside this
// repository, such as an identifier in another system, held by
// link:ExternalLink nodes. It says what a valid value looks like, and how to
// turn one into an address.
[link:ExternalDefinition] > link:Definition
  - sling:resourceType (STRING) = "link/ExternalDefinition" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "link/Definition" mandatory autocreated protected

  // A regular expression every recorded value must match in full, checked when
  // the link is created
  - valuePattern (STRING)

  // A template that turns the recorded value into an address, such as
  // "https://ehr.example.org/chart/{value}"
  - urlTemplate (STRING)

//-----------------------------------------------------------------------------
// Marks content that holds links. A node type lists the mixin among its
// supertypes, or a single node carries it. It is no gate: content whose type
// allows a link:links child some other way can hold links too.
[link:Linkable]
  mixin

  // The links, kept out of the versions of a versionable owner
  + link:links (link:Links) = link:Links autocreated IGNORE

//-----------------------------------------------------------------------------
// The container of a resource's links, its link:links child.
[link:Links] > data:Content
  - sling:resourceType (STRING) = "link/Links" mandatory autocreated protected

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The links
  + * (link:Link) = link:Link IGNORE
  + * (link:WeakLink) = link:WeakLink IGNORE
  + * (link:ExternalLink) = link:ExternalLink IGNORE

//-----------------------------------------------------------------------------
// A link to content in the repository, holding a REFERENCE to it.
[link:Link] > data:Content, mix:lastModified
  - sling:resourceType (STRING) = "link/Link" mandatory autocreated protected

  // The link's type, a reference to its link:Definition
  - type (REFERENCE) mandatory nofulltext

  // The linked content
  - reference (REFERENCE) mandatory nofulltext

  // The link's own label, optional
  - label (STRING)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

//-----------------------------------------------------------------------------
// A link to content in the repository, holding a WEAKREFERENCE to it.
[link:WeakLink] > link:Link
  - sling:resourceType (STRING) = "link/WeakLink" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "link/Link" mandatory autocreated protected

  // The linked content
  - reference (WEAKREFERENCE) mandatory nofulltext

//-----------------------------------------------------------------------------
// A link to something outside the repository, named by the recorded value,
// such as this resource's identifier in another system.
[link:ExternalLink] > data:Content, mix:lastModified
  - sling:resourceType (STRING) = "link/ExternalLink" mandatory autocreated protected

  // The link's type, a reference to its link:Definition
  - type (REFERENCE) mandatory nofulltext

  // The recorded value, such as an identifier or a URL
  - value (STRING) mandatory

  // The link's own label, optional
  - label (STRING)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple
