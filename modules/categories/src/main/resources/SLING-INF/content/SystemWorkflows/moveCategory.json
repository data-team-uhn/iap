{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Move a category",
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "tags": ["active"],
    "targetResourceType": "cat/Category",
    "description": "Moves a category, with everything under it, to another place in the tree.",
    "requested": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "requested",
      "label": "Requested",
      "messageName": "move",
      "performers": ["iap-administrators"],
      "jcr:reference:flowNodeType": "/WorkflowTypes/MessageStartEvent",
      "toMove": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toMove",
        "targetRef": "move"
      }
    },
    "move": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "move",
      "label": "Move the category",
      "handler": "moveContent",
      "within": "cat/CategoriesHomepage",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "done"
      }
    },
    "done": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "done",
      "label": "Category moved",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
