<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<iap = 'https://iap.uhndata.io/'>
<cat = 'https://iap.uhndata.io/cat/'>

//-----------------------------------------------------------------------------
//
// Categories: an admin-editable tree classifying submissions, e.g.
// "Prospective studies" / "Prospective Interventional Studies" /
// "Behavioral Interventions". Categories nest by path, and sibling order is
// the JCR child order, deliberately arranged by administrators.
//
// A leaf category (one with no subcategories) is what submissions are
// actually filed under; it optionally references the sch:SchemaVersion
// governing those submissions, which in turn references the workflow they
// follow. Submissions filed under a category without a schema version fall
// back to a default behavior.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// Homepage node for the /Categories root path. iap:Documented makes the tree
// serve its own catalogue of live leaf categories at /Categories.doc.md and
// /Categories.doc.json, primarily consumed by AI-assisted categorization.
[cat:CategoriesHomepage] > iap:EntityHomepage, iap:Documented
  // Top-level categories are presented in a deliberate, admin-chosen order.
  orderable

  - sling:resourceType (STRING) = "cat/CategoriesHomepage" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "iap/EntityHomepage" mandatory autocreated protected

  // The listed entities are categories, not following the naming convention
  // that would derive cat:Categorie from the resource type.
  - childNodeType (STRING) = "cat:Category" mandatory autocreated protected

  // The heading of the served documentation, overriding the empty defaults of
  // the iap:Documented mixin. Autocreated rather than hardcoded in the model
  // serving the catalogue, but still editable, so that a deployment can reword
  // the heading without touching code.
  - title (STRING) = "Submission categories" autocreated
  // Deliberately terse: the introduction lands in the categorization prompt,
  // where serving rules (only live leaves are listed) are noise - the catalogue
  // simply is the set of valid choices.
  - description (STRING) = "The categories a submission may currently be filed under." autocreated

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Contains the category tree
  + * (cat:Category) = cat:Category

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A submission category. The node name is the category's technical name;
// the label is what submitters see.
[cat:Category] > iap:Entity
  // Sibling subcategories are presented in a deliberate, admin-chosen order.
  orderable

  - sling:resourceType (STRING) = "cat/Category" mandatory autocreated protected

  // Human-readable name displayed to submitters
  - label (STRING) mandatory

  // Prompt-ready description of what belongs in this category, used both as
  // guidance for submitters and as input for AI-assisted categorization
  - description (STRING)

  // The sch:SchemaVersion governing submissions filed under this category;
  // the schema version in turn references the workflow they follow. Only
  // leaf categories are expected to carry this - node types cannot express
  // that restriction, so it is upheld by the administrative UI.
  - schemaVersion (REFERENCE)

  // When true, no new submissions may be filed under this category or its
  // subcategories; existing submissions keep referencing it.
  - retired (BOOLEAN) = false mandatory autocreated

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Subcategories
  + * (cat:Category) = cat:Category

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured
