<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<doc = 'https://iap.uhndata.io/doc/'>
<data = 'https://iap.uhndata.io/data/'>
<cat = 'https://iap.uhndata.io/cat/'>

//-----------------------------------------------------------------------------
//
// Categories: the tree administrators build for submitters to choose from,
// such as "Prospective studies" / "Prospective Interventional Studies" /
// "Behavioral Interventions". Sibling order is the JCR child order, which
// administrators arrange.
//
// Submissions are filed under leaf categories, the ones with no
// subcategories. A leaf may reference the sch:SchemaVersion its submissions
// follow.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// The /Categories homepage. It serves the catalogue of live leaf categories at
// /Categories.doc.md and /Categories.doc.json.
[cat:CategoriesHomepage] > data:EntityHomepage, doc:Documented
  orderable

  - sling:resourceType (STRING) = "cat/CategoriesHomepage" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "data/EntityHomepage" mandatory autocreated protected

  // Without this property, the type of the listed entities would be derived
  // from the resource type as cat:Categorie.
  - childNodeType (STRING) = "cat:Category" mandatory autocreated protected

  // The catalogue's heading, which a deployment can reword
  - title (STRING) = "Submission categories" autocreated
  // The catalogue's introduction, which a deployment can reword
  - description (STRING) = "The categories a submission may currently be filed under." autocreated

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Contains the category tree
  + * (cat:Category) = cat:Category

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A submission category. The node name is its technical name, and the label
// is what submitters see.
[cat:Category] > data:Entity
  orderable

  - sling:resourceType (STRING) = "cat/Category" mandatory autocreated protected

  // The name submitters see, such as "Prospective studies"
  - label (STRING) mandatory

  // What belongs in this category, written as prose for whoever chooses one
  - description (STRING)

  // The sch:SchemaVersion a new submission under this category follows; the
  // schema version in turn references the workflow. Carried by top-level
  // categories, which are what a submitter picks when starting a submission.
  // The categories below them are what a classification of the uploaded
  // document picks from. Node types cannot express where it may be set, so
  // that is upheld by the administrative UI.
  - schemaVersion (REFERENCE)

  // A retired category carries the inheritable `retired` tag, which closes it
  // and its whole subtree to new submissions. See docs/categories.md.

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Subcategories
  + * (cat:Category) = cat:Category

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured
