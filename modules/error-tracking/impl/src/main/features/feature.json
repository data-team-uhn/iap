{
  "bundles":[
    {
      // No later than iap-java-utils (20), which depends on it. The feature analyser refuses a bundle that
      // imports from a bundle with a later start order.
      "id":"${project.groupId}:iap-error-tracking-api:${project.version}",
      "start-order":"20"
    },
    {
      // After every bundle it builds on, the last of which start at 24: iap-data-entities-api, iap-tags-api and
      // iap-status
      "id":"${project.groupId}:${project.artifactId}:${project.version}",
      "start-order":"25"
    }
  ],
  "configurations":{
    "org.apache.sling.serviceusermapping.impl.ServiceUserMapperImpl.amended~iaperrortracking":{
      "user.mapping":[
        "io.uhndata.iap.error-tracking-impl:errortracking=[iap-error-tracking]"
      ]
    }
  },
  "repoinit:TEXT|true": "@file"
}
