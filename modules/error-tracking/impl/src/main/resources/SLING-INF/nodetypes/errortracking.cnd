<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<data = 'https://iap.uhndata.io/data/'>
<err = 'https://iap.uhndata.io/err/'>

//-----------------------------------------------------------------------------
//
// Error tracking: the errors a running instance could not deal with on its
// own, recorded under /LoggedErrors. See docs/error-tracking.md.
//
// Nothing here is versionable, and /LoggedErrors has no versionable ancestor,
// so no property declares an on-parent-version behaviour.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// The homepage of the recorded errors, at /LoggedErrors. Recorded errors are
// not entities, but a data:EntityHomepage gets them listed and filtered by the
// pagination servlet, and can carry the ACL that repoinit sets on it.
[err:LoggedErrorsHomepage] > data:EntityHomepage
  query

  - sling:resourceType (STRING) = "err/LoggedErrorsHomepage" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "data/EntityHomepage" mandatory autocreated protected

  // The node type that /LoggedErrors.paginate.json lists
  - childNodeType (STRING) = "err:LoggedError" mandatory autocreated protected

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The recorded errors
  + * (err:LoggedError) = err:LoggedFailure

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// What every recorded error has, whether or not something was thrown. A
// recorded error is either an err:LoggedFailure or an err:LoggedProblem.
//
// The node is named after a fingerprint of the fault: the component, the
// operation, and either the classes and frames of what was thrown or the
// problem's phrase. Whatever varies with the data, the message included, is
// left out of the fingerprint and kept below as a sample. The number of these
// nodes grows with the ways this build can fail, and none is ever deleted.
//
// jcr:created, which data:Content brings through mix:created, is when the
// fault was first recorded.
[err:LoggedError] > data:Content
  abstract

  query

  // Set here, so that both kinds of recorded error are err/LoggedError
  // resources. The value data:Content sets, "data/Content", would hide them
  // from the acknowledge servlet, the triage tags and the homepage model.
  - sling:resourceSuperType (STRING) = "err/LoggedError" mandatory autocreated protected

  // The fully qualified name of the class that was running. For a plugin, the
  // plugin's class, not the framework that called it. Part of the
  // fingerprint. When a caller does not name it for a thrown failure, it is
  // the topmost class of the stack trace whose package starts with
  // io.uhndata.iap.
  - component (STRING)

  // What the component was doing: a short label chosen in code, such as
  // "computeTags". Part of the fingerprint.
  - operation (STRING)

  // How many times this fault has been recorded. A fault recorded a thousand
  // times keeps twenty subjects, and this says a thousand.
  - occurrences (LONG) = '1' mandatory autocreated

  // When this fault was last recorded
  - lastOccurrence (DATE) mandatory

  // Up to five distinct messages this fault was seen with, most recent first.
  // "Cannot read /Submissions/1234" and "Cannot read /Submissions/5678" are
  // one fault seen twice. For a failure, these are the throwable's messages.
  // For a problem, they are the reported phrases that differ from `problem`.
  - messages (STRING) multiple

  // Up to twenty distinct paths this fault happened to, most recent first.
  // There is no count of the paths left out. Content that has to be repaired
  // carries its own marker, as tagComputationState does.
  - subjects (STRING) multiple

  // Up to ten distinct usernames this fault happened on behalf of, most
  // recent first. Absent when no caller named a user, as for a commit hook or
  // a scheduled task.
  - actors (STRING) multiple

  // The details given with the most recent occurrence that had any, one
  // "key: value" per line, such as "attempt: 3"
  - lastContext (STRING)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The decisions taken about this error
  + * (err:Acknowledgement) = err:Acknowledgement

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A recorded error that something was thrown for.
[err:LoggedFailure] > err:LoggedError
  - sling:resourceType (STRING) = "err/LoggedFailure" mandatory autocreated protected

  // The class name of the outermost throwable, such as
  // "java.lang.IllegalStateException". Part of the fingerprint.
  - type (STRING) mandatory

  // The stack trace of the first occurrence, causes included, as a log file
  // prints it, cut after 65,536 characters
  - stackTrace (STRING) mandatory

//-----------------------------------------------------------------------------
// A recorded error that nothing was thrown for: something the instance found
// wrong, most often a mis-authored definition, such as a condition naming a
// comparator that does not exist. `component` and `operation` say where it was
// noticed, and `subjects` what it was noticed on.
[err:LoggedProblem] > err:LoggedError
  - sling:resourceType (STRING) = "err/LoggedProblem" mandatory autocreated protected

  // What is wrong: a short phrase chosen in code, such as "unknown
  // comparator". Part of the fingerprint. A reported phrase that quotes a
  // value, such as "unknown comparator: 'sameDay'", is recorded under its
  // leading words, and kept whole in `messages`.
  - problem (STRING) mandatory

//-----------------------------------------------------------------------------
// One decision somebody took about a recorded error. A new decision is added
// beside the earlier ones, which stay.
[err:Acknowledgement] > data:Content
  - sling:resourceType (STRING) = "err/Acknowledgement" mandatory autocreated protected

  // What was decided: the name of a tag in the error-triage category, such as
  // "known-issue". The error's triage tags are computed from its most recent
  // decision.
  - resolution (STRING) mandatory

  // Why, in the words of whoever decided
  - note (STRING)

  // The error's `occurrences` when the decision was taken. Once the error has
  // been recorded more times than this, it needs attention again. A count
  // orders two decisions taken in the same second, and needs no clock.
  - acknowledgedOccurrences (LONG) mandatory

  // jcr:created and jcr:createdBy, from data:Content, say when and who decided

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured
