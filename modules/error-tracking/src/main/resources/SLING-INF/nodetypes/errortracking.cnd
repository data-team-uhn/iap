<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<mix = 'http://www.jcp.org/jcr/mix/1.0'>
<err = 'https://iap.uhndata.io/err/'>

//-----------------------------------------------------------------------------
//
// Error tracking: errors that a running instance could not deal with on its
// own are recorded under /LoggedErrors, so that a system administrator can be
// told about them long after the log file they were written to has rotated
// away.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// Homepage node for the /LoggedErrors root path, holding the recorded errors.
[err:LoggedErrorsHomepage] > sling:Folder
  // Attributes:

  // We can query the recorded errors
  query

  // Properties:

  - sling:resourceType (STRING) = "err/LoggedErrorsHomepage" mandatory autocreated protected

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Contains recorded errors
  + * (err:LoggedError) = err:LoggedError

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// One recorded error: what was thrown, and the stack trace it was thrown with.
// The node is named after a digest of its stack trace, so the same failure
// thrown again from the same place is counted here instead of filling the
// container with copies of itself. Nothing ever removes these nodes: an error
// stays relevant until somebody has dealt with it, which can take as long as it
// takes.
//
// The mix:created supertype records when, and on whose behalf, the error was
// first seen; `lastOccurrence` records when it was last seen.
[err:LoggedError] > nt:base, mix:created
  - sling:resourceType (STRING) = "err/LoggedError" mandatory autocreated protected

  // The class name of the throwable that was recorded, e.g.
  // "java.lang.IllegalStateException"
  - type (STRING) mandatory

  // The throwable's own message, absent when it was thrown without one
  - message (STRING)

  // The full stack trace, including the causes, as it would be printed to a
  // log file. This is what the node's name is a digest of, so two errors share
  // a node only when their traces are identical, message included.
  - stackTrace (STRING) mandatory

  // How many times this exact error has been recorded so far
  - occurrences (LONG) = '1' mandatory autocreated

  // When this error was last recorded; jcr:created is when it was first seen
  - lastOccurrence (DATE) mandatory

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured
