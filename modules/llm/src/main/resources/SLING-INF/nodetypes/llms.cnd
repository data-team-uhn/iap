<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<llm = 'https://iap.uhndata.io/llm/'>

//-----------------------------------------------------------------------------
//
// LLM configuration: the catalog of available LLM providers and models, plus
// the currently active selection.
//
// The structure is two levels deep:
//   llm:Configuration   (the catalog root, holds the active selection)
//     +-- llm:Provider  (an endpoint, e.g. a local Ollama or Prompter)
//           +-- llm:Model  (a model offered by that provider)
//
// The catalog is seeded from initial content. Only the active selection
// (activeProvider / activeModel) is meant to change at runtime, through the
// admin screen.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// The catalog root. Holds the list of providers and the active selection.
[llm:Configuration] > sling:Folder
  // The list of providers is orderable.
  orderable
  // We can use this in a query.
  query

  - sling:resourceType (STRING) = "llm/Configuration" mandatory autocreated protected

  // A title for this configuration.
  - title (String)

  // The name of the currently selected provider child node.
  - activeProvider (String)

  // The name of the currently selected model child node, within the active provider.
  - activeModel (String)

  // The available providers.
  + * (llm:Provider) = llm:Provider

//-----------------------------------------------------------------------------
// An LLM provider, i.e. an API endpoint such as a local Ollama or Prompter.
// One provider can serve many models.
[llm:Provider] > sling:Folder
  // The list of models is orderable.
  orderable
  // We can use providers in a query.
  query

  - sling:resourceType (STRING) = "llm/Provider" mandatory autocreated protected

  // A human-readable label for this provider.
  - label (String)

  // The request dialect this provider speaks, matched against the 'llm.provider' service property of a
  // registered client to decide which client handles it. Defaults to the provider's node name when unset.
  - api (String)

  // The base URL of the API (the chat completions path is appended for OpenAI-compatible providers).
  - endpoint (String) mandatory

  // The name of the environment variable holding the API key for this provider.
  - apiKeyEnvVar (String)

  // The project the requests are billed to, for providers that scope calls to a project.
  - projectId (String)

  // Maximum time to wait for a request to this provider, in seconds.
  - timeoutSeconds (LONG) = '120'

  // Allow provider-specific extra properties (for example apiVersion).
  - * (undefined)

  // The models offered by this provider.
  + * (llm:Model) = llm:Model

//-----------------------------------------------------------------------------
// A model offered by a provider.
[llm:Model] > sling:Folder
  // We can use models in a query.
  query

  - sling:resourceType (STRING) = "llm/Model" mandatory autocreated protected

  // The model's maximum context window, in tokens.
  - contextLimitTokens (LONG)

  // The maximum number of tokens to generate in the response.
  - maxOutputTokens (LONG) = '2000'

  // The sampling temperature passed to the model.
  - temperature (DOUBLE) = '0.0'

  // The number of input tokens to send per chunk when the input exceeds the context window.
  - chunkTokenSize (LONG)

  // Documents estimated at fewer tokens than this are sent to the model whole, never chunked.
  - wholeDocumentTokenLimit (LONG) = '20000'

  // The organization that developed this model (e.g. google, anthropic, alibaba).
  - developer (String)

  // Allow model-specific extra properties.
  - * (undefined)
