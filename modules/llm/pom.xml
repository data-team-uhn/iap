<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.uhndata.iap</groupId>
    <artifactId>iap-modules</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>iap-llm</artifactId>
  <packaging>bundle</packaging>
  <name>IAP - LLM Client Service</name>
  <description>OSGi service for talking to LLMs</description>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <configuration>
          <!--
            These are embedded into the bundle (see Embed-Dependency) for LangChain4j's runtime use, but this
            module's own source does not import them directly, so the analyzer would otherwise flag them.
            Jackson is declared but not embedded (see Import-Package below): this module's own source uses
            jackson-databind directly, so it is not unused, but jackson-core and jackson-annotations are only
            ever reached transitively (through jackson-databind and through LangChain4j).
          -->
          <ignoredUnusedDeclaredDependencies combine.children="append">
            <ignoredUnusedDeclaredDependency>dev.langchain4j:langchain4j-http-client</ignoredUnusedDeclaredDependency>
            <ignoredUnusedDeclaredDependency>com.fasterxml.jackson.core:jackson-core</ignoredUnusedDeclaredDependency>
            <ignoredUnusedDeclaredDependency>com.fasterxml.jackson.core:jackson-annotations</ignoredUnusedDeclaredDependency>
            <ignoredUnusedDeclaredDependency>com.knuddels:jtokkit</ignoredUnusedDeclaredDependency>
          </ignoredUnusedDeclaredDependencies>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <instructions>
            <!-- Only the public API package is exported; the internal package and every embedded library
                 (LangChain4j + its JDK HTTP client + jtokkit) stay private to this bundle. -->
            <Export-Package>io.uhndata.iap.llm</Export-Package>
            <!-- LangChain4j itself and its JDK HTTP client transport are embedded into this bundle (fat
                 bundle), since they are plain JARs with no OSGi metadata. jtokkit is a transitive dependency
                 of LangChain4j, embedded here by artifactId. Jackson is NOT embedded: the platform already
                 ships it as a proper OSGi bundle (see base.json), so this bundle imports those packages
                 instead of carrying a second, private copy that could drift to a different version. -->
            <Embed-Dependency>
              langchain4j-open-ai,
              langchain4j-core,
              langchain4j-http-client,
              langchain4j-http-client-jdk,
              jtokkit
            </Embed-Dependency>
            <!-- Keep the genuine platform dependencies as mandatory imports (they are provided by the OSGi
                 runtime); make every other package the embedded libraries reference optional, so the self
                 contained fat bundle resolves without demanding LangChain4j's optional integrations. -->
            <Import-Package>
              jakarta.json,
              jakarta.servlet,
              com.fasterxml.jackson.core,
              com.fasterxml.jackson.databind,
              org.apache.commons.lang3,
              org.apache.sling.api,
              org.apache.sling.api.resource,
              org.apache.sling.api.servlets,
              org.slf4j,
              io.uhndata.iap.errortracking.api,
              io.uhndata.iap.utils,
              org.apache.sling.models.annotations,
              org.apache.sling.models.annotations.injectorspecific,
              *;resolution:=optional
            </Import-Package>
            <Sling-Model-Packages>io.uhndata.iap.llm.internal.models</Sling-Model-Packages>
            <Sling-Nodetypes>SLING-INF/nodetypes/llms.cnd</Sling-Nodetypes>
            <!-- The catalog (available providers and models) is reseeded from the sources on every deploy, so
                 shipping a new provider or model reaches a running instance without a manual step. The active
                 selection is a separate, much smaller tree that is seeded once and never overwritten after
                 that, since it holds the choice an administrator made at runtime, which a redeploy must not
                 silently reset. See LLMConfigurationServiceImpl. -->
            <Sling-Initial-Content>
              SLING-INF/content/libs/iap/config/;path:=/libs/iap/config/;overwrite:=true,
              SLING-INF/content/apps/iap/config/;path:=/apps/iap/config/;overwrite:=false,
              SLING-INF/content/Extensions/;path:=/Extensions/;overwriteProperties:=true;uninstall:=true,
            </Sling-Initial-Content>
          </instructions>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.apache.sling</groupId>
      <artifactId>org.apache.sling.api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.sling</groupId>
      <artifactId>org.apache.sling.models.api</artifactId>
      <version>2.0.0</version>
    </dependency>
    <dependency>
      <groupId>jakarta.json</groupId>
      <artifactId>jakarta.json-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.sling</groupId>
      <artifactId>org.apache.sling.servlets.annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
    </dependency>
    <!-- Nullability annotations for the exported API -->
    <dependency>
      <groupId>org.jetbrains</groupId>
      <artifactId>annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>iap-error-tracking-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>iap-java-utils</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!--
      LangChain4j is the LLM transport (see OpenAIClient). These artifacts, together with the Jackson and
      jtokkit libraries LangChain4j needs at runtime, are embedded into this bundle (see Embed-Dependency
      above). They are declared directly (rather than relying on transitive resolution) because
      Embed-Dependency only embeds directly-declared artifacts, and marked optional so they do not leak as
      transitive compile dependencies onto modules that depend on this one.
    -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-open-ai</artifactId>
      <version>1.16.3</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-core</artifactId>
      <version>1.16.3</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-http-client</artifactId>
      <version>1.16.3</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-http-client-jdk</artifactId>
      <version>1.16.3</version>
      <optional>true</optional>
    </dependency>
    <!--
      Jackson versions match what the platform's base feature (see base.json) already exports, since this
      module imports those packages rather than embedding its own copy (see Import-Package above).
      jackson-databind is used directly by OpenAIClient; jackson-core and jackson-annotations are only ever
      reached transitively (through jackson-databind and through LangChain4j).
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <version>${jackson.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <version>2.22</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.knuddels</groupId>
      <artifactId>jtokkit</artifactId>
      <version>1.1.0</version>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.sling</groupId>
      <artifactId>org.apache.sling.testing.sling-mock.junit5</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
    </dependency>
    <!-- The bundle context the servlet tests build their mock requests with -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.framework</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The jakarta.json implementation the tests need at runtime, loaded through the ServiceLoader -->
    <dependency>
      <groupId>org.eclipse.parsson</groupId>
      <artifactId>parsson</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
