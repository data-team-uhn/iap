<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<tag = 'https://iap.uhndata.io/tag/'>
<data = 'https://iap.uhndata.io/data/'>

//-----------------------------------------------------------------------------
//
// Content: the base node type of everything IAP stores. It is abstract, and
// concrete node types extend it.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// Marks content that can carry tags, each the name of a tag:Definition under
// /Tags. Every data:Content node has the mixin through its supertypes, and a
// node of another type, such as nt:file, becomes taggable by adding it.
// Every property is IGNORE: tags describe the content as it is now, so
// changing them needs no checkout, and restoring a version leaves them alone.
[tag:Taggable]
  mixin

  // The tags placed on this content, such as "incomplete"
  - tags (STRING) multiple IGNORE

  // The tags this content derives, one property per phase: copied from its
  // descendants (`aggregated` tags), copied from its ancestors (`inheritable`
  // tags), or computed from its own content. The tags module's propagation
  // editor writes them at commit time. Do not write them.
  - aggregatedTags (STRING) multiple IGNORE
  - inheritedTags (STRING) multiple IGNORE
  - computedTags (STRING) multiple IGNORE

  // Set while the derived tags above cannot be trusted, and absent otherwise:
  //   failed       a tag processor threw, and the values are the last ones
  //                it computed successfully
  //   recomputing  a tag repair asked for the values to be redone
  // The next commit that reaches the node recomputes them in full and removes
  // this property. A `recomputing` left at rest means a commit was interrupted
  // between the request and the recomputation.
  // The values carry no CND constraint. Oak enforces a constraint against a
  // commit hook's writes too, and the tags module must never fail a commit.
  // Do not write it.
  - tagComputationState (STRING) IGNORE

//-----------------------------------------------------------------------------
// Marks the container that `aggregated` tags climb to and no further. It
// carries the aggregate of everything beneath it, and adds nothing to its
// ancestors. Without one, an aggregated tag climbs to the repository root, and
// a commit fails unless its session may write every ancestor on the way.
// Entity homepages carry the mixin, and so does an entity that owns a subtree.
// See docs/tags.md.
[tag:Boundary]
  mixin

[data:Content] > sling:Folder, sling:Resource, sling:ResourceSuperType, tag:Taggable
  abstract

  - sling:resourceSuperType (STRING) = "data/Content" mandatory autocreated protected
