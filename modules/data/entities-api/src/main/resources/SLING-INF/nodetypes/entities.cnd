<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<link = 'https://iap.uhndata.io/link/'>
<tag = 'https://iap.uhndata.io/tag/'>
<data = 'https://iap.uhndata.io/data/'>

//-----------------------------------------------------------------------------
//
// Entity: the base node type of a thing stored as a whole, such as a
// submission. An entity can be referenced, linked to other entities, and
// versioned, and it records when it was last modified. It is abstract, and
// concrete node types extend it.
//
//-----------------------------------------------------------------------------

[data:Entity] > data:Content, link:Linkable, mix:referenceable, mix:versionable, mix:lastModified
  abstract

  query

  - sling:resourceSuperType (STRING) = "data/Entity" mandatory autocreated protected

//-----------------------------------------------------------------------------
//
// Entity part: the base node type of a piece of an entity, such as a question
// in a schema version or an answer in a submission. A part has no versions of
// its own. It is abstract, and concrete node types extend it.
//
//-----------------------------------------------------------------------------

[data:EntityPart] > data:Content
  abstract

  - sling:resourceSuperType (STRING) = "data/EntityPart" mandatory autocreated protected

//-----------------------------------------------------------------------------
//
// Entity homepage: the container of the entities of one type, such as
// /Submissions. It is abstract, and concrete homepage types extend it.
//
//-----------------------------------------------------------------------------

// A tag:Boundary, because the homepage lists and filters its entities on
// their derived tags, and nothing above it lists anything.
[data:EntityHomepage] > data:Content, rep:AccessControllable, tag:Boundary
  abstract

  query

  - sling:resourceSuperType (STRING) = "data/EntityHomepage" mandatory autocreated protected

  // The node type of the entities listed under this homepage, such as
  // sub:Submission. When absent, it is derived from the homepage's resource
  // type: sub/SubmissionsHomepage lists sub:Submission.
  - childNodeType (STRING)
