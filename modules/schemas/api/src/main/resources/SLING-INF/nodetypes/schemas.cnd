<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<tag = 'https://iap.uhndata.io/tag/'>
<data = 'https://iap.uhndata.io/data/'>
<cond = 'https://iap.uhndata.io/cond/'>
<sch = 'https://iap.uhndata.io/sch/'>

//-----------------------------------------------------------------------------
//
// Schemas: what an institutional process asks of a submission, such as the
// questions to answer, the documents to provide and the approvals to obtain.
//
// A schema is a container, and its content lives in versions. A submission is
// filed against one version. Once a version is published, only its wording
// can change. See docs/schemas.md.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// The /Schemas homepage.
[sch:SchemasHomepage] > data:EntityHomepage
  - sling:resourceType (STRING) = "sch/SchemasHomepage" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "data/EntityHomepage" mandatory autocreated protected

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The schemas
  + * (sch:Schema) = sch:Schema

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A named schema. It only identifies the schema, and its versions hold what
// a submission is asked for.
[sch:Schema] > data:Entity, tag:Boundary
  - sling:resourceType (STRING) = "sch/Schema" mandatory autocreated protected

  // The schema's name, as people read it
  - title (STRING) mandatory

  // A schema is open to new submissions unless it carries the `retired`
  // lifecycle tag, which its versions inherit.

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The versions of this schema
  + * (sch:SchemaVersion) = sch:SchemaVersion

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// One version of a schema, holding the requirements a submission must
// fulfill. A submission references the version it is filed against.
[sch:SchemaVersion] > data:Entity, tag:Boundary
  orderable

  - sling:resourceType (STRING) = "sch/SchemaVersion" mandatory autocreated protected

  // The version's label, such as "1.0"
  - version (STRING) mandatory

  // What sets this version apart, in a sentence or two
  - description (STRING)

  // Its state is its `lifecycle` tag: `draft`, `active` or `retired`. Only an
  // active version takes new submissions.

  // The wf:WorkflowVersion that the submissions filed against this version
  // go through. Only a draft can change it.
  - workflow (REFERENCE)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // What a submission must fulfill, such as a form to answer or a document
  // to provide
  + * (sch:Requirement)

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// The base of every part of a schema version: its requirements and the items
// of its forms. A servlet or a workflow bound to sch/SchemaPart serves every
// part. It is abstract, and concrete node types extend it.
[sch:SchemaPart] > data:EntityPart
  abstract

  - sling:resourceSuperType (STRING) = "sch/SchemaPart" mandatory autocreated protected

//-----------------------------------------------------------------------------
// The base of what a form holds: a question, or a section holding more items.
// Each item may carry one condition deciding whether the submitter is asked
// it. It is abstract, and concrete node types extend it.
[sch:FormItem] > sch:SchemaPart, cond:Conditionable
  abstract

  - sling:resourceSuperType (STRING) = "sch/FormItem" mandatory autocreated protected

//-----------------------------------------------------------------------------
// A group of questions in a form. Sections can nest.
[sch:Section] > sch:FormItem
  orderable

  - sling:resourceType (STRING) = "sch/Section" mandatory autocreated protected

  // The section's heading, as the submitter reads it
  - title (STRING) mandatory

  // What the submitter reads under the heading
  - description (STRING)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The questions and sections it holds
  + * (sch:FormItem)

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A question the submitter answers. Answers reference it.
[sch:Question] > sch:FormItem, mix:referenceable
  // The answer options are offered in the order they are stored
  orderable

  - sling:resourceType (STRING) = "sch/Question" mandatory autocreated protected

  // The question, as the submitter reads it
  - text (STRING) mandatory

  // A longer explanation the submitter reads under the question
  - description (STRING)

  // The type of value an answer holds: text, long, double, boolean or date
  - dataType (STRING) = "text" mandatory autocreated

  // How many values an answer takes. A positive minimum makes the question
  // required, and a maximum other than 1 lets it take several values. Zero or
  // less leaves that end open. (0,1) is one optional value, (1,1) one
  // required value, and (2,4) asks for two to four. An answer short of the
  // minimum leaves the submission incomplete, and saving an answer over the
  // maximum is refused.
  - minAnswers (LONG) = '0' autocreated
  - maxAnswers (LONG) = '1' autocreated

  // For a numeric answer, the smallest and the largest value accepted
  - minValue (DOUBLE)
  - maxValue (DOUBLE)

  // For a text answer, a regular expression every value must match in full,
  // and what the submitter is told when one does not
  - pattern (STRING)
  - patternMessage (STRING)

  // How the question is shown to the submitter
  - displayMode (STRING)

  // What the answer is used to judge, in the reviewer's terms
  - purpose (STRING)

  // The prompt an LLM is given to read this answer out of the submitted
  // documents
  - extractionPrompt (STRING)

  // The shape the LLM's reply must take, as a JSON schema
  - responseShape (STRING)

  // A content path whose items are the options, in place of child
  // sch:AnswerOption nodes, such as /Vocabularies/sites
  - optionsFrom (STRING)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The options. A question with options is answered only with their values.
  + * (sch:AnswerOption)

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// One of the answers a question offers. The value is what an answer stores
// and what a condition compares against, so changing it changes the meaning
// of every answer already recorded. The label is only what the submitter
// reads.
[sch:AnswerOption] > data:EntityPart
  - sling:resourceType (STRING) = "sch/AnswerOption" mandatory autocreated protected

  // What an answer that picks this option stores
  - value (STRING) mandatory

  // What the submitter reads; the value itself when there is none
  - label (STRING)

  // When this option applies, where the label does not say
  - description (STRING)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

//-----------------------------------------------------------------------------
// The base of what a submission must fulfill: a form to answer, a document to
// provide, an approval to obtain. Documents, reviews, comments and topics
// reference it. It may carry one condition deciding whether it applies to a
// submission. It is abstract, and concrete node types extend it.
[sch:Requirement] > sch:SchemaPart, mix:referenceable, cond:Conditionable
  abstract

  - sling:resourceSuperType (STRING) = "sch/Requirement" mandatory autocreated protected

  // The requirement's short name, such as "Patient consent"
  - label (STRING) mandatory

  // What the submitter reads about what is expected
  - description (STRING)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A form: questions, grouped into sections, that the submitter answers. A
// schema version asks its questions through form requirements.
[sch:FormRequirement] > sch:Requirement
  orderable

  - sling:resourceType (STRING) = "sch/FormRequirement" mandatory autocreated protected

  // The questions and sections of the form
  + * (sch:FormItem)

//-----------------------------------------------------------------------------
// A decision a model makes about an uploaded document before anything is read
// out of it, e.g. "is this a research proposal" or "which kind of study is
// it". It is a form requirement holding one question, whose options are the
// categories to choose from: the model's pick is stored as that question's
// answer, pre-filled for the submitter to confirm or change, and workflow
// conditions read it like any other answer.
[sch:ClassificationRequirement] > sch:FormRequirement
  - sling:resourceType (STRING) = "sch/ClassificationRequirement" mandatory autocreated protected

  // What the model is asked to decide, and how to tell
  - prompt (STRING) mandatory

  // The name of the document requirement whose upload is classified
  - document (STRING) mandatory

  // The confidence a pick needs to be saved. A less sure pick is not saved,
  // and the question waits for the submitter.
  - confidenceThreshold (DOUBLE) = '0.7' autocreated

  // Optional reference text the model is shown with the prompt, e.g. the
  // typical structure of a research protocol
  + template (nt:file)

//-----------------------------------------------------------------------------
// A document the submitter provides, such as the patient consent form.
[sch:DocumentRequirement] > sch:Requirement
  // The sections are kept in the order the document is expected to present
  // them
  orderable
  - sling:resourceType (STRING) = "sch/DocumentRequirement" mandatory autocreated protected

  // Whether the submission is incomplete without the document. The
  // requirement's condition decides whether it is asked for at all.
  - required (BOOLEAN) = true autocreated

  // Whether uploads for this requirement are never parsed, so no reading
  // uses them, e.g. a signed form nobody needs read. Defaults to false.
  - skipParsing (BOOLEAN) = false autocreated

  // The media types the document may have, such as application/pdf; any
  // when there are none
  - acceptedFileTypes (STRING) multiple

  // The prompt an AI agent is given to check whether the provided document
  // meets this requirement
  - aiCheckPrompt (STRING)

  // A template of the document, offered to submitters
  + template (nt:file)

  // The sections the document is expected to contain
  + * (sch:SectionRequirement) = sch:SectionRequirement

//-----------------------------------------------------------------------------
// A section a document is expected to contain, such as the funding section of
// a study protocol. A topic can point at it rather than at the whole
// document. It is a requirement, with a label, a description and a
// condition, and it can be referenced. Nothing is uploaded for it: it is
// looked for in the document of the requirement it belongs to.
[sch:SectionRequirement] > sch:Requirement
  // The subsections are kept in the order the document is expected to present
  // them
  orderable
  - sling:resourceType (STRING) = "sch/SectionRequirement" mandatory autocreated protected

  // Whether the document must contain this section
  - required (BOOLEAN) = true autocreated

  // The headings this section usually goes by, such as "Funding", "Budget"
  // and "Sources of support"
  - headings (STRING) multiple

  // The prompt an LLM is given to find where this section starts, when none
  // of the document's headings is one of the above
  - locationPrompt (STRING)

  // The subsections it is expected to contain
  + * (sch:SectionRequirement) = sch:SectionRequirement

//-----------------------------------------------------------------------------
// An approval a submission must obtain, such as "REB approval".
[sch:ApprovalRequirement] > sch:Requirement
  orderable

  - sling:resourceType (STRING) = "sch/ApprovalRequirement" mandatory autocreated protected

  // The principal name of the group whose members may grant this approval
  - approverGroup (STRING)

  // What the approvers want assessed
  + * (sch:Topic) = sch:Topic

//-----------------------------------------------------------------------------
// A broad area the approvers want assessed before they grant an approval,
// such as consent: whether it is needed, clear, informed, free of coercion,
// and in both languages. Assessments reference it.
[sch:Topic] > data:EntityPart, mix:referenceable
  - sling:resourceType (STRING) = "sch/Topic" mandatory autocreated protected

  // The topic, as people read it
  - text (STRING) mandatory

  // What to look for
  - description (STRING)

  // The requirements and questions that bear on this topic, where a reviewer
  // and the AI look first. Weak, so a part can be removed without first
  // unlinking it from every topic.
  - sources (WEAKREFERENCE) multiple

  // The prompt an LLM is given to assess this topic from the submission
  - assessmentPrompt (STRING)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured
