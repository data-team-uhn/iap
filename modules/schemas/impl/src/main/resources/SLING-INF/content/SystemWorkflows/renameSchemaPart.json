{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Rename a part of a draft schema version",
  "active": true,
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "active": true,
    "targetResourceType": "sch/SchemaPart",
    "description": "Gives a requirement, section or question another identifier, where it stands, while its version is a draft.",
    "requested": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "requested",
      "label": "Requested",
      "messageName": "rename",
      "performers": ["iap-administrators"],
      "jcr:reference:flowNodeType": "/WorkflowTypes/MessageStartEvent",
      "cond:condition": {
        "jcr:primaryType": "cond:SingleCondition",
        "comparator": "includes",
        "operandA": {
          "jcr:primaryType": "cond:ConditionOperand",
          "source": "property",
          "value": ["tags"]
        },
        "operandB": {
          "jcr:primaryType": "cond:ConditionOperand",
          "value": ["draft"]
        }
      },
      "toRename": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toRename",
        "targetRef": "rename"
      }
    },
    "rename": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "rename",
      "label": "Rename the part",
      "handler": "renameContent",
      "namePattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "done"
      }
    },
    "done": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "done",
      "label": "Part renamed",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
