{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Correct a part of a schema version",
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "tags": ["active"],
    "targetResourceType": "sch/SchemaPart",
    "description": "Corrects what a requirement, section or question says, on any version: what submitters read, and what guides reading answers out of documents. Nothing that decides what an answer means, which answers are valid or which parts apply can change here; that takes a new version. A correction reaches the submissions already filed against the version.",
    "requested": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "requested",
      "label": "Requested",
      "messageName": "update",
      "performers": ["iap-administrators"],
      "jcr:reference:flowNodeType": "/WorkflowTypes/MessageStartEvent",
      "toUpdate": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toUpdate",
        "targetRef": "update"
      }
    },
    "update": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "update",
      "label": "Correct the part",
      "handler": "updateContent",
      "fields": {
        "jcr:primaryType": "nt:unstructured",
        "label": { "jcr:primaryType": "nt:unstructured", "label": "Label" },
        "title": { "jcr:primaryType": "nt:unstructured", "label": "Title" },
        "text": { "jcr:primaryType": "nt:unstructured", "label": "Question", "multiline": true },
        "description": { "jcr:primaryType": "nt:unstructured", "label": "Description", "multiline": true },
        "patternMessage": { "jcr:primaryType": "nt:unstructured", "label": "Message when an answer does not match" },
        "purpose": { "jcr:primaryType": "nt:unstructured", "label": "Purpose", "multiline": true },
        "extractionPrompt": { "jcr:primaryType": "nt:unstructured", "label": "Extraction prompt", "multiline": true },
        "aiCheckPrompt": { "jcr:primaryType": "nt:unstructured", "label": "AI check prompt", "multiline": true }
      },
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "done"
      }
    },
    "done": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "done",
      "label": "Corrected",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
