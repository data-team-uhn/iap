<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="createSchemaDefinitions"
                  targetNamespace="https://iap.uhndata.io/systemWorkflows/createSchema">
  <bpmn:message id="createMessage" name="create" />
  <bpmn:process id="createSchema" name="Create a schema" isExecutable="true">
    <bpmn:startEvent id="requested" name="Requested">
      <bpmn:outgoing>toCreate</bpmn:outgoing>
      <bpmn:messageEventDefinition id="createRequested" messageRef="createMessage" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toCreate" sourceRef="requested" targetRef="create" />
    <bpmn:serviceTask id="create" name="Create the schema">
      <bpmn:incoming>toCreate</bpmn:incoming>
      <bpmn:outgoing>toAddVersion</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toAddVersion" sourceRef="create" targetRef="addVersion" />
    <bpmn:callActivity id="addVersion" name="Give it a first version">
      <bpmn:incoming>toAddVersion</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="toDone" sourceRef="addVersion" targetRef="done" />
    <bpmn:endEvent id="done" name="Schema created">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="createSchemaDiagram">
    <bpmndi:BPMNPlane id="createSchemaPlane" bpmnElement="createSchema">
      <bpmndi:BPMNShape id="requestedShape" bpmnElement="requested">
        <dc:Bounds x="160" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="157" y="223" width="42" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="createShape" bpmnElement="create">
        <dc:Bounds x="250" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="addVersionShape" bpmnElement="addVersion">
        <dc:Bounds x="410" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doneShape" bpmnElement="done">
        <dc:Bounds x="570" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="555" y="223" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toCreateEdge" bpmnElement="toCreate">
        <di:waypoint x="196" y="198" />
        <di:waypoint x="250" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toAddVersionEdge" bpmnElement="toAddVersion">
        <di:waypoint x="350" y="198" />
        <di:waypoint x="410" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDoneEdge" bpmnElement="toDone">
        <di:waypoint x="510" y="198" />
        <di:waypoint x="570" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
