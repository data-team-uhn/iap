{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Create a schema version",
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "tags": ["active"],
    "targetResourceType": "sch/Schema",
    "description": "Adds a version to an open schema, as a draft: empty, or a copy of another version, linked to the version it was copied from.",
    "requested": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "requested",
      "label": "Requested",
      "messageName": "createVersion",
      "performers": ["iap-administrators"],
      "jcr:reference:flowNodeType": "/WorkflowTypes/MessageStartEvent",
      "cond:condition": {
        "jcr:primaryType": "cond:SingleCondition",
        "comparator": "excludes",
        "operandA": {
          "jcr:primaryType": "cond:ConditionOperand",
          "source": "tags"
        },
        "operandB": {
          "jcr:primaryType": "cond:ConditionOperand",
          "value": ["retired"]
        }
      },
      "toCreate": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toCreate",
        "targetRef": "create"
      }
    },
    "create": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "create",
      "label": "Create the version",
      "handler": "createSchemaVersion",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toCopy": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toCopy",
        "targetRef": "copy"
      }
    },
    "copy": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "copy",
      "label": "Copy the source version, if specified",
      "handler": "copyContent",
      "sourceType": "sch/SchemaVersion",
      "skipProperties": ["version"],
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toLinkSource": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toLinkSource",
        "targetRef": "linkSource"
      }
    },
    "linkSource": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "linkSource",
      "label": "Link the copy to the version it was copied from",
      "handler": "addLink",
      "linkType": "copiedFrom",
      "to": "source",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toMarkDraft": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toMarkDraft",
        "targetRef": "markDraft"
      }
    },
    "markDraft": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "markDraft",
      "label": "Mark it as a draft",
      "handler": "addTag",
      "tag": "draft",
      "replaceExisting": true,
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "done"
      }
    },
    "done": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "done",
      "label": "Schema version created",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
