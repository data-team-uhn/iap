{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Retire a schema",
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "state": "ACTIVE",
    "targetResourceType": "sch/Schema",
    "description": "Closes a schema as a whole: every version of it is retired along with it, without changing their own state.",
    "requested": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "requested",
      "label": "Requested",
      "messageName": "retire",
      "performers": ["iap-administrators"],
      "jcr:reference:flowNodeType": "/WorkflowTypes/MessageStartEvent",
      "cond:condition": {
        "jcr:primaryType": "cond:SingleCondition",
        "comparator": "excludes",
        "operandA": {
          "jcr:primaryType": "cond:ConditionOperand",
          "source": "tags"
        },
        "operandB": {
          "jcr:primaryType": "cond:ConditionOperand",
          "value": ["retired"]
        }
      },
      "toMarkRetired": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toMarkRetired",
        "targetRef": "markRetired"
      }
    },
    "markRetired": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "markRetired",
      "label": "Mark it as retired",
      "handler": "addTag",
      "tag": "retired",
      "replaceExisting": true,
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "done"
      }
    },
    "done": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "done",
      "label": "Schema retired",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
