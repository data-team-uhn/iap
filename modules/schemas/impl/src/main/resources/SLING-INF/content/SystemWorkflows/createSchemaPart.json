{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Add a part to a draft schema version",
  "active": true,
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "active": true,
    "targetResourceType": "sch/SchemaPart",
    "description": "Adds a section or a question to a form or a section, or an answer option to a question, while its version is a draft, unless that question takes its options from elsewhere.",
    "requested": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "requested",
      "label": "Requested",
      "messageName": "create",
      "performers": ["iap-administrators"],
      "jcr:reference:flowNodeType": "/WorkflowTypes/MessageStartEvent",
      "cond:condition": {
        "jcr:primaryType": "cond:ConditionGroup",
        "requireAll": true,
        "draft": {
          "jcr:primaryType": "cond:SingleCondition",
          "comparator": "includes",
          "operandA": {
            "jcr:primaryType": "cond:ConditionOperand",
            "source": "property",
            "value": ["tags"]
          },
          "operandB": {
            "jcr:primaryType": "cond:ConditionOperand",
            "value": ["draft"]
          }
        },
        "ownOptions": {
          "jcr:primaryType": "cond:SingleCondition",
          "comparator": "is empty",
          "operandA": {
            "jcr:primaryType": "cond:ConditionOperand",
            "source": "ownProperty",
            "value": ["optionsFrom"]
          }
        }
      },
      "toCreate": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toCreate",
        "targetRef": "create"
      }
    },
    "create": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "create",
      "label": "Add the part",
      "handler": "createContent",
      "namePattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "nameHint": "Letters, digits, - and _, starting with a letter or a digit.",
      "nameFrom": ["value", "title", "text", "label"],
      "types": {
        "jcr:primaryType": "nt:unstructured",
        "section": { "jcr:primaryType": "nt:unstructured", "nodeType": "sch:Section", "label": "Section" },
        "question": { "jcr:primaryType": "nt:unstructured", "nodeType": "sch:Question", "label": "Question" },
        "option": { "jcr:primaryType": "nt:unstructured", "nodeType": "sch:AnswerOption", "label": "Option", "named": false }
      },
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toUpdate": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toUpdate",
        "targetRef": "update"
      }
    },
    "update": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "update",
      "label": "Fill it in",
      "handler": "updateContent",
      "fields": {
        "jcr:primaryType": "nt:unstructured",
        "value": {
          "jcr:primaryType": "nt:unstructured",
          "label": "Value",
          "help": "What answers store and conditions compare against. No two options of a question share one.",
          "unique": true
        },
        "label": { "jcr:primaryType": "nt:unstructured", "label": "Label" },
        "title": { "jcr:primaryType": "nt:unstructured", "label": "Title" },
        "text": { "jcr:primaryType": "nt:unstructured", "label": "Question", "multiline": true },
        "description": { "jcr:primaryType": "nt:unstructured", "label": "Description", "multiline": true },
        "dataType": {
          "jcr:primaryType": "nt:unstructured",
          "label": "Answer type",
          "choices": {
            "jcr:primaryType": "nt:unstructured",
            "text": { "jcr:primaryType": "nt:unstructured", "label": "Text" },
            "long": { "jcr:primaryType": "nt:unstructured", "label": "Whole number" },
            "double": { "jcr:primaryType": "nt:unstructured", "label": "Decimal number" },
            "boolean": { "jcr:primaryType": "nt:unstructured", "label": "Yes or no" },
            "date": { "jcr:primaryType": "nt:unstructured", "label": "Date" },
            "file": { "jcr:primaryType": "nt:unstructured", "label": "File" }
          }
        },
        "minAnswers": {
          "jcr:primaryType": "nt:unstructured",
          "label": "Minimum answers",
          "help": "0 means optional. 1 or more means required."
        },
        "maxAnswers": {
          "jcr:primaryType": "nt:unstructured",
          "label": "Maximum answers",
          "help": "0 means unlimited. 1 means a single answer."
        },
        "minValue": {
          "jcr:primaryType": "nt:unstructured",
          "label": "Lowest value",
          "appliesWhen": {
            "jcr:primaryType": "nt:unstructured",
            "property": "dataType",
            "values": ["long", "double"]
          }
        },
        "maxValue": {
          "jcr:primaryType": "nt:unstructured",
          "label": "Highest value",
          "appliesWhen": {
            "jcr:primaryType": "nt:unstructured",
            "property": "dataType",
            "values": ["long", "double"]
          }
        },
        "pattern": {
          "jcr:primaryType": "nt:unstructured",
          "label": "Pattern",
          "help": "A regular expression every answer must match.",
          "appliesWhen": {
            "jcr:primaryType": "nt:unstructured",
            "property": "dataType",
            "values": ["text"]
          }
        },
        "patternMessage": {
          "jcr:primaryType": "nt:unstructured",
          "label": "Message when an answer does not match",
          "appliesWhen": {
            "jcr:primaryType": "nt:unstructured",
            "property": "dataType",
            "values": ["text"]
          }
        },
        "optionsFrom": {
          "jcr:primaryType": "nt:unstructured",
          "label": "Options from",
          "help": "A path whose items are the options, instead of options listed here.",
          "appliesWhen": {
            "jcr:primaryType": "nt:unstructured",
            "property": "dataType",
            "values": ["text", "long", "double"]
          }
        },
        "purpose": { "jcr:primaryType": "nt:unstructured", "label": "Purpose", "multiline": true },
        "extractionPrompt": { "jcr:primaryType": "nt:unstructured", "label": "Extraction prompt", "multiline": true },
        "rubricTags": { "jcr:primaryType": "nt:unstructured", "label": "Rubric tags" }
      },
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "done"
      }
    },
    "done": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "done",
      "label": "Part added",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
