{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Activate a schema version",
  "active": true,
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "active": true,
    "targetResourceType": "sch/SchemaVersion",
    "description": "Opens a version to new submissions: a draft once it passes the publish checks, or a retired version again. The version it replaces is left alone.",
    "requested": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "requested",
      "label": "Requested",
      "messageName": "activate",
      "performers": ["iap-administrators"],
      "jcr:reference:flowNodeType": "/WorkflowTypes/MessageStartEvent",
      "toActivate": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toActivate",
        "targetRef": "activate"
      }
    },
    "activate": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "activate",
      "label": "Activate the version",
      "handler": "changeSchemaState",
      "state": "active",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "done"
      }
    },
    "done": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "done",
      "label": "Schema version activated",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
