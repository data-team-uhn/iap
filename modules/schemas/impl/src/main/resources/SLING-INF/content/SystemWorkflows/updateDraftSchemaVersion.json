{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Edit a draft schema version",
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "tags": ["active"],
    "targetResourceType": "sch/SchemaVersion",
    "description": "Changes anything about a version while it is a draft.",
    "notice": "Everything in this version can change until it is activated.",
    "requested": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "requested",
      "label": "Requested",
      "messageName": "update",
      "performers": ["iap-administrators"],
      "jcr:reference:flowNodeType": "/WorkflowTypes/MessageStartEvent",
      "cond:condition": {
        "jcr:primaryType": "cond:SingleCondition",
        "comparator": "includes",
        "operandA": {
          "jcr:primaryType": "cond:ConditionOperand",
          "source": "tags"
        },
        "operandB": {
          "jcr:primaryType": "cond:ConditionOperand",
          "value": ["draft"]
        }
      },
      "toUpdate": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toUpdate",
        "targetRef": "update"
      }
    },
    "update": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "update",
      "label": "Apply the changes",
      "handler": "updateContent",
      "fields": {
        "jcr:primaryType": "nt:unstructured",
        "version": { "jcr:primaryType": "nt:unstructured", "label": "Label" },
        "description": { "jcr:primaryType": "nt:unstructured", "label": "Description", "multiline": true },
        "workflow": {
          "jcr:primaryType": "nt:unstructured",
          "label": "Workflow",
          "referenceType": "wf/WorkflowVersion",
          "referenceRoot": "/Workflows"
        }
      },
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "done"
      }
    },
    "done": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "done",
      "label": "Schema version edited",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
