{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Edit an answer option of a draft schema version",
  "active": true,
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "active": true,
    "targetResourceType": "sch/AnswerOption",
    "description": "Changes an answer option's value and wording, while its version is a draft.",
    "requested": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "requested",
      "label": "Requested",
      "messageName": "update",
      "performers": ["iap-administrators"],
      "jcr:reference:flowNodeType": "/WorkflowTypes/MessageStartEvent",
      "cond:condition": {
        "jcr:primaryType": "cond:SingleCondition",
        "comparator": "includes",
        "operandA": {
          "jcr:primaryType": "cond:ConditionOperand",
          "source": "property",
          "value": ["tags"]
        },
        "operandB": {
          "jcr:primaryType": "cond:ConditionOperand",
          "value": ["draft"]
        }
      },
      "toUpdate": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toUpdate",
        "targetRef": "update"
      }
    },
    "update": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "update",
      "label": "Apply the changes",
      "handler": "updateContent",
      "fields": {
        "jcr:primaryType": "nt:unstructured",
        "value": {
          "jcr:primaryType": "nt:unstructured",
          "label": "Value",
          "help": "What answers store and conditions compare against. No two options of a question share one.",
          "unique": true
        },
        "label": { "jcr:primaryType": "nt:unstructured", "label": "Label" },
        "description": { "jcr:primaryType": "nt:unstructured", "label": "Description", "multiline": true }
      },
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "done"
      }
    },
    "done": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "done",
      "label": "Edited",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
