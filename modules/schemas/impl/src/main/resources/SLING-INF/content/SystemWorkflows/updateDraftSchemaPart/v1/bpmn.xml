<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:iap="https://iap.uhndata.io/bpmn"
                  xmlns:sv="http://www.jcp.org/jcr/sv/1.0"
                  id="updateDraftSchemaPartDefinitions"
                  targetNamespace="https://iap.uhndata.io/systemWorkflows/updateDraftSchemaPart">
  <bpmn:message id="updateMessage" name="update" />
  <bpmn:process id="updateDraftSchemaPart" name="Edit a part of a draft schema version" isExecutable="true">
    <bpmn:startEvent id="requested" iap:performers="iap-administrators" name="Requested">
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name"><sv:value>cond:SingleCondition</sv:value></sv:property>
          <sv:property sv:name="comparator"><sv:value>includes</sv:value></sv:property>
          <sv:node sv:name="operandA">
            <sv:property sv:name="jcr:primaryType" sv:type="Name"><sv:value>cond:ConditionOperand</sv:value></sv:property>
            <sv:property sv:name="source"><sv:value>property</sv:value></sv:property>
            <sv:property sv:name="value" sv:multiple="true"><sv:value>tags</sv:value></sv:property>
          </sv:node>
          <sv:node sv:name="operandB">
            <sv:property sv:name="jcr:primaryType" sv:type="Name"><sv:value>cond:ConditionOperand</sv:value></sv:property>
            <sv:property sv:name="source"><sv:value>literal</sv:value></sv:property>
            <sv:property sv:name="value" sv:multiple="true"><sv:value>draft</sv:value></sv:property>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
      <bpmn:outgoing>toUpdate</bpmn:outgoing>
      <bpmn:messageEventDefinition id="updateRequested" messageRef="updateMessage" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toUpdate" sourceRef="requested" targetRef="update" />
    <bpmn:serviceTask id="update" name="Apply the changes">
      <bpmn:extensionElements>
        <iap:updateContent>
          <iap:fields name="label" label="Label" />
          <iap:fields name="title" label="Title" />
          <iap:fields name="text" label="Question" multiline="true" />
          <iap:fields name="description" label="Description" multiline="true" />
          <iap:fields name="dataType" label="Answer type">
            <iap:choices value="text" label="Text" />
            <iap:choices value="long" label="Whole number" />
            <iap:choices value="double" label="Decimal number" />
            <iap:choices value="boolean" label="Yes or no" />
            <iap:choices value="date" label="Date" />
          </iap:fields>
          <iap:fields name="minAnswers" label="Minimum answers" help="0 means optional. 1 or more means required." />
          <iap:fields name="maxAnswers" label="Maximum answers" help="0 means unlimited. 1 means a single answer." />
          <iap:fields name="minValue" label="Lowest value">
            <iap:appliesWhen property="dataType">
              <iap:values>long</iap:values>
              <iap:values>double</iap:values>
            </iap:appliesWhen>
          </iap:fields>
          <iap:fields name="maxValue" label="Highest value">
            <iap:appliesWhen property="dataType">
              <iap:values>long</iap:values>
              <iap:values>double</iap:values>
            </iap:appliesWhen>
          </iap:fields>
          <iap:fields name="pattern" label="Pattern" help="A regular expression every answer must match.">
            <iap:appliesWhen property="dataType">
              <iap:values>text</iap:values>
            </iap:appliesWhen>
          </iap:fields>
          <iap:fields name="patternMessage" label="Message when an answer does not match">
            <iap:appliesWhen property="dataType">
              <iap:values>text</iap:values>
            </iap:appliesWhen>
          </iap:fields>
          <iap:fields name="optionsFrom" label="Options from" help="A path whose items are the options, instead of options listed here.">
            <iap:appliesWhen property="dataType">
              <iap:values>text</iap:values>
              <iap:values>long</iap:values>
              <iap:values>double</iap:values>
            </iap:appliesWhen>
          </iap:fields>
          <iap:fields name="purpose" label="Purpose" multiline="true" />
          <iap:fields name="extractionPrompt" label="Extraction prompt" multiline="true" />
          <iap:fields name="required" label="Required" />
          <iap:fields name="acceptedFileTypes" label="Accepted file types" help="Media types, such as application/pdf. None means any." />
          <iap:fields name="aiCheckPrompt" label="AI check prompt" multiline="true" />
          <iap:fields name="approverGroup" label="Approver group" />
        </iap:updateContent>
      </bpmn:extensionElements>
      <bpmn:incoming>toUpdate</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toDone" sourceRef="update" targetRef="done" />
    <bpmn:endEvent id="done" name="Edited">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="updateDraftSchemaPartDiagram">
    <bpmndi:BPMNPlane id="updateDraftSchemaPartPlane" bpmnElement="updateDraftSchemaPart">
      <bpmndi:BPMNShape id="requestedShape" bpmnElement="requested">
        <dc:Bounds x="160" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="157" y="223" width="42" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="updateShape" bpmnElement="update">
        <dc:Bounds x="250" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doneShape" bpmnElement="done">
        <dc:Bounds x="410" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="414" y="223" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toUpdateEdge" bpmnElement="toUpdate">
        <di:waypoint x="196" y="198" />
        <di:waypoint x="250" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDoneEdge" bpmnElement="toDone">
        <di:waypoint x="350" y="198" />
        <di:waypoint x="410" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
