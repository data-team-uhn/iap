<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<rep = 'internal'>
<data = 'https://iap.uhndata.io/data/'>
<hist = 'https://iap.uhndata.io/hist/'>

//-----------------------------------------------------------------------------
//
// History: the record of what happened to the content, kept under /History.
//
// The content of a past state is a JCR version, in the repository's version
// storage. A version cannot be given a property or a mixin, so everything said
// about a change is a node of these types. The two are joined by the version
// identifier in hist:Entry.snapshot. docs/history.md explains the design.
//
// Every pointer in this file is an identifier stored as STRING, never a
// REFERENCE. A REFERENCE would stop anybody deleting what the record describes,
// and the record has to outlive its subject.
//
// Nothing here is versionable and /History is not under a versionable
// ancestor, so no on-parent-version attributes are needed in this file. The one
// exception is the hist:Watchable mixin at the bottom, which is added to
// content that is versionable.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// The store root at /History, and every bucket under it.
//
// Actions are filed in a prefix tree, under <root>/<xx>/<yy>/<zz>/<action>,
// each bucket named after the leading characters of the action's own name.
//
// rep:AccessControllable for the ACL repoinit places here. Nobody reads this
// store directly: a service user reads it for the person asking.
[hist:Log] > sling:Folder, rep:AccessControllable
  // Attributes:

  // We can query the record
  query

  // Properties:

  - sling:resourceType (STRING) = "hist/Log" mandatory autocreated protected

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Child nodes:

  // A bucket of the prefix tree, holding further buckets or the actions
  // themselves
  + * (hist:Log) = hist:Log

  // An action, at the bottom of the prefix tree
  + * (hist:Action) = hist:Action

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// One action: one event delivery, and everything that followed from it in the
// commit that carried it out.
//
// jcr:created and jcr:createdBy are autocreated, through mix:created.
// jcr:created is when the action was recorded. jcr:createdBy is the user whose
// session wrote the record, which is not always the person responsible, so
// that person is a property of its own below.
[hist:Action] > data:Content
  // Attributes:

  // We can query the record
  query

  // Properties:

  - sling:resourceType (STRING) = "hist/Action" mandatory autocreated protected

  // Who is answerable for this, as a canonical user id: the repository's
  // spelling, not the one typed at login
  - actor (STRING) mandatory

  // Whom the actor acted for, when that was somebody else: a delegate, or the
  // system acting for a person
  - onBehalfOf (STRING)

  // What was asked for, in the platform's own vocabulary, e.g. "submit",
  // "activate"
  - operation (STRING) mandatory

  // The workflow instance this action moved, and the exact definition version
  // in force
  - workflowInstance (STRING)
  - workflowVersion (STRING)

  // Which node of the definition was being performed, and its label as the
  // definition read at the time
  - activityId (STRING)
  - activityLabel (STRING)

  // The task somebody completed to cause this, the decision they took, and what
  // they said about it
  - taskInstance (STRING)
  - outcome (STRING)
  - outcomeNote (STRING)

  // The name of the event that was delivered
  - event (STRING)

  // The component responsible, for an action no workflow caused, such as a
  // scheduled sweep, a migration or an import
  - component (STRING)

  // The action this one was performed as part of
  - parentAction (STRING)

  // When the action happened, where that is not when it was recorded, as for an
  // imported log. When it is absent, the action happened at jcr:created.
  - occurredAt (DATE)

  // Whether every snapshot this action wanted has been taken. Snapshots are
  // taken in commits of their own, after this record is committed. Until this
  // is true, an entry with no `snapshot` may not have got one yet. Once it is
  // true, an entry without one never wanted one.
  - complete (BOOLEAN) = false mandatory autocreated

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Child nodes:

  // What the action did, one child per resource it affected
  + * (hist:Entry) = hist:Entry

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// What one action did to one resource.
//
// Named after the subject's identifier, so the repository refuses a second
// entry for the same resource in the same action.
[hist:Entry] > data:Content
  // Attributes:

  // We can query the record. This is how one resource's history is gathered,
  // since entries are filed under their action rather than under their subject.
  query

  // Properties:

  - sling:resourceType (STRING) = "hist/Entry" mandatory autocreated protected

  // Which resource this is about, by identifier
  - subject (STRING) mandatory

  // Where it was and what type it was, at the time. Copies, since a path moves
  // and the subject may no longer exist to be asked.
  - subjectPath (STRING) mandatory
  - subjectType (STRING) mandatory

  // The part this resource played in the action, e.g. "submitted", "retired",
  // "activated". Not constrained to a list of values: the workflow definitions
  // own that vocabulary, and a constraint here would fail the commit recording
  // a change rather than the change itself.
  - role (STRING) mandatory

  // The names of the properties that changed, never their values
  - changes (STRING) multiple

  // The identifier of the JCR version holding this resource's content as it was
  // after the action. Absent when the action took no snapshot of it, which is
  // the usual case.
  - snapshot (STRING)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Child nodes:

  // Anything said about this afterwards
  + * (hist:Annotation) = hist:Annotation

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// Something somebody said about a past change, after it happened, such as
// "this is the revision the approval was granted on". A version cannot carry
// it, so it lives here. Appended, never replaced.
[hist:Annotation] > data:Content
  // Attributes:

  // We can query annotations
  query

  // Properties:

  - sling:resourceType (STRING) = "hist/Annotation" mandatory autocreated protected

  // Who said it, as a canonical user id
  - author (STRING) mandatory

  // What they said
  - note (STRING) mandatory

  // Optionally, what it amounts to: a short machine-readable verdict beside the
  // words, for annotations that are decisions rather than remarks
  - resolution (STRING)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// Marks content that remembers who has looked at it.
//
// A mixin added to the content, rather than a child declared on data:Entity.
// These types build on data:Content, so entities.cnd cannot name them: this
// bundle would have to start before the data model it builds on.
//
// IGNORE on-parent-version keeps the markers out of every snapshot. Without
// it, opening a page would change what its next snapshot holds, and restoring
// an old revision would tell people they have not seen what they have.
[hist:Watchable]
  // Attributes:

  mixin

  // Child nodes:

  + hist:lastSeen (hist:LastSeen) = hist:LastSeen AUTOCREATED IGNORE

//-----------------------------------------------------------------------------
// The markers on one piece of content, one per person who has looked at it.
// Under the content rather than under the person, since an item is looked at
// by a handful of people while a reviewer opens a great many items.
[hist:LastSeen] > data:Content
  // Attributes:

  // We can query the markers
  query

  // Properties:

  - sling:resourceType (STRING) = "hist/LastSeen" mandatory autocreated protected

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Child nodes:

  // One marker per viewer, named after their canonical user id
  + * (hist:Marker) = hist:Marker

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// How much of one item's history one person has seen.
[hist:Marker] > data:Content
  // Attributes:

  // We can query the markers
  query

  // Properties:

  - sling:resourceType (STRING) = "hist/Marker" mandatory autocreated protected

  // When they last looked, compared against the most recent action naming the
  // item. A version cannot answer that: snapshots are taken only at milestones,
  // so the newest change to an item usually has no version of its own.
  - seenAt (DATE) mandatory

  // Which action they had seen up to, when it is worth knowing precisely
  - seenAction (STRING)

  // The newest snapshot they had seen, where a "what changed since I looked"
  // comparison starts. Coarser than `seenAt`, since no snapshot may be as recent
  // as the moment they looked.
  - seenSnapshot (STRING)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured
