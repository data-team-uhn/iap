{
  "bundles": [
    {
      // Every node type here builds on data:Content, so this must start after iap-data-content-api
      // (start-order 21). It must also start before the workflow engine (26), which is what will be
      // writing the record: every data change goes through the engine, so that is where an action
      // becomes known.
      "id": "${project.groupId}:${project.artifactId}:${project.version}",
      "start-order": "25"
    }
  ],
  "configurations": {
    "org.apache.sling.serviceusermapping.impl.ServiceUserMapperImpl.amended~iaphistory": {
      "user.mapping": [
        "io.uhndata.iap.history-api:history=[iap-history]"
      ]
    }
  },
  "repoinit:TEXT|true": "@file"
}
