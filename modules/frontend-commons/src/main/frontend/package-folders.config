// Package folders a library fetches files from by name at run time, published as they are by
// webpack_script.py and webpack.config-template.js in aggregated-frontend

// What PDF.js fetches only when a document needs it: unembedded standard fonts, image decoders,
// character maps and a colour profile
'pdfjs-dist/standard_fonts'
'pdfjs-dist/wasm'
'pdfjs-dist/cmaps'
'pdfjs-dist/iccs'
