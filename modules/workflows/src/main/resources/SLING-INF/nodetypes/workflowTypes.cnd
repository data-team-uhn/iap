<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<iap = 'https://iap.uhndata.io/'>
<wf = 'https://iap.uhndata.io/wf/'>

//-----------------------------------------------------------------------------
//
// Workflow Homepage Nodes
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// Homepage node for the /WorkflowTypes root path.
// Documented: the catalogue served at /WorkflowTypes.doc.json is what populates
// the toolbars of the visual BPMN editor, so it is a UI contract, not just prose.
[wf:WorkflowTypesHomepage] > iap:EntityHomepage, iap:Documented
  - sling:resourceType (STRING) = "wf/WorkflowTypesHomepage" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "iap/EntityHomepage" mandatory autocreated protected

  // The listed entities are flow node types, not following the naming convention
  // that would derive wf:WorkflowType from the resource type.
  - childNodeType (STRING) = "wf:FlowNodeType" mandatory autocreated protected

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Contains event and activity type definitions
  + * (wf:FlowNodeType) = wf:FlowNodeType

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
//
// Workflow Type Definitions
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// A particular type of workflow node.
[wf:FlowNodeType] > iap:Entity, mix:referenceable
  query
  abstract

  // Hardcode the supertype to the parent wf/FlowNodeType type.
  - sling:resourceSuperType (STRING) = "wf/FlowNodeType" mandatory autocreated protected

  // The human-readable name of this node type, e.g. "Message Start Event". The
  // identifier used to refer to the type is the node name itself, e.g. "MessageStartEvent".
  - label (STRING) mandatory

  // What this node type means and when to use it, displayed in the documentation
  // catalogue and as the editor toolbar's tooltip
  - description (STRING)

  // The toolbar groups this type belongs to, e.g. "Events". When absent, the
  // group is derived from the concrete wf:FlowNodeType subtype.
  - category (STRING) multiple

  // Higher priorities overrule lower priorities
  - priority (LONG) mandatory


  // XML properties to be used when parsing for this type
  // The XML element that this node type matches
  - xmlElement (STRING) mandatory

  // A child XML element that (if specified) is required to match
  - xmlChildElement (STRING)


  // JCR properties that are relevant to storing this type
  // The sub-type of wf:FlowNode that this type should be translated to
  - jcrNodeType (STRING) mandatory

  // JCR properties that should be set for nodes of this type, as a JSON object
  - jcrProperties (STRING)


  //
  // Properties that should be copied from the XML element to the JCR node
  - properties (STRING) multiple

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured


//-----------------------------------------------------------------------------
// A particular type of catching workflow event.
[wf:CatchingEventType] > wf:FlowNodeType
  - sling:resourceType (STRING) = "wf/CatchingEventType" mandatory autocreated protected

//-----------------------------------------------------------------------------
// A particular type of throwing workflow event.
[wf:ThrowingEventType] > wf:FlowNodeType
  - sling:resourceType (STRING) = "wf/ThrowingEventType" mandatory autocreated protected

//-----------------------------------------------------------------------------
// A particular type of workflow activity.
[wf:ActivityType] > wf:FlowNodeType
  - sling:resourceType (STRING) = "wf/ActivityType" mandatory autocreated protected

//-----------------------------------------------------------------------------
// A particular type of routing node.
[wf:GatewayType] > wf:FlowNodeType
  - sling:resourceType (STRING) = "wf/GatewayType" mandatory autocreated protected
