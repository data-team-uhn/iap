<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<doc = 'https://iap.uhndata.io/doc/'>
<data = 'https://iap.uhndata.io/data/'>
<wf = 'https://iap.uhndata.io/wf/'>

//-----------------------------------------------------------------------------
//
// Workflow Homepage Nodes
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// Homepage node for the /WorkflowTypes root path.
// Documented: the catalogue served at /WorkflowTypes.doc.json is what populates
// the toolbars of the visual BPMN editor, so it is a UI contract, not just prose.
[wf:WorkflowTypesHomepage] > data:EntityHomepage, doc:Documented
  - sling:resourceType (STRING) = "wf/WorkflowTypesHomepage" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "data/EntityHomepage" mandatory autocreated protected

  // The listed entities are flow node types, not following the naming convention
  // that would derive wf:WorkflowType from the resource type.
  - childNodeType (STRING) = "wf:FlowNodeType" mandatory autocreated protected

  // The heading of the served documentation, overriding the empty defaults of
  // the doc:Documented mixin. Autocreated rather than hardcoded in the model
  // serving the catalogue, but still editable, so that a deployment can reword
  // the heading without touching code.
  - title (STRING) = "Workflow node types" autocreated
  - description (STRING) = "Everything a workflow can be built out of. Each entry says which BPMN element it stands for, and how that element is stored once the workflow is parsed. Adding an entry here is what makes a new kind of node available, both to the parser and in the editor's toolbars." autocreated

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Contains event and activity type definitions
  + * (wf:FlowNodeType) = wf:FlowNodeType

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
//
// Workflow Type Definitions
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// A particular type of workflow node.
[wf:FlowNodeType] > data:Entity, mix:referenceable
  query
  abstract

  // The parameters keep the order they are declared in, and only an orderable
  // type keeps that order: without this, Oak returns the children in an order of
  // its own.
  orderable

  // Hardcode the supertype to the parent wf/FlowNodeType type.
  - sling:resourceSuperType (STRING) = "wf/FlowNodeType" mandatory autocreated protected

  // The human-readable name of this node type, e.g. "Message Start Event". The
  // identifier used to refer to the type is the node name itself, e.g. "MessageStartEvent".
  - label (STRING) mandatory

  // What this node type means and when to use it, displayed in the documentation
  // catalogue and as the editor toolbar's tooltip
  - description (STRING)

  // The toolbar groups this type belongs to, e.g. "Events". When absent, the
  // group is derived from the concrete wf:FlowNodeType subtype.
  - category (STRING) multiple

  // Higher priorities overrule lower priorities
  - priority (LONG) mandatory


  // XML properties to be used when parsing for this type
  // The XML element that this node type matches
  - xmlElement (STRING) mandatory

  // A child XML element that (if specified) is required to match
  - xmlChildElement (STRING)

  // The element under bpmn:extensionElements, in the IAP namespace, that this
  // entry is written as. Required to match when specified, which is what tells
  // one service task handler from another.
  - xmlExtensionElement (STRING)


  // JCR properties that are relevant to storing this type
  // The sub-type of wf:FlowNode that this type should be translated to
  - jcrNodeType (STRING) mandatory

  // JCR properties that should be set for nodes of this type, as a JSON object
  - jcrProperties (STRING)


  //
  // Properties that should be copied from the XML element to the JCR node
  - properties (STRING) multiple

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The values a node of this type carries beyond the ones every flow node has,
  // each declaring its own type and cardinality
  + * (wf:Parameter)

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured


//-----------------------------------------------------------------------------
// A particular type of catching workflow event.
[wf:CatchingEventType] > wf:FlowNodeType
  - sling:resourceType (STRING) = "wf/CatchingEventType" mandatory autocreated protected

//-----------------------------------------------------------------------------
// A particular type of throwing workflow event.
[wf:ThrowingEventType] > wf:FlowNodeType
  - sling:resourceType (STRING) = "wf/ThrowingEventType" mandatory autocreated protected

//-----------------------------------------------------------------------------
// A particular type of workflow activity.
[wf:ActivityType] > wf:FlowNodeType
  - sling:resourceType (STRING) = "wf/ActivityType" mandatory autocreated protected

//-----------------------------------------------------------------------------
// A particular type of routing node.
[wf:GatewayType] > wf:FlowNodeType
  - sling:resourceType (STRING) = "wf/GatewayType" mandatory autocreated protected

//-----------------------------------------------------------------------------
// One value a kind of node takes: what it is called, what may be put in it, and
// how many of it there may be. Declared as content, so that adding a parameter
// to a kind of node is an edit to the vocabulary rather than a code change.
//
// The parameter's own name is the node name, which is both the JCR property it
// is stored in and the XML attribute or element it is written as
[wf:Parameter] > data:EntityPart
  orderable

  - sling:resourceType (STRING) = "wf/Parameter" mandatory autocreated protected

  // What the author sees this parameter called
  - label (STRING) mandatory

  // What the parameter means, shown to whoever is filling it in
  - description (STRING)

  // What may be put in it: text, boolean, long, reference (the path of another
  // node) or principal (the name of a user or group)
  - dataType (STRING) = 'text' mandatory autocreated
    < 'text', 'boolean', 'long', 'reference', 'principal'

  // How many values it takes.
  // A maximum of 0 is unbounded.
  // Autocreated, not merely defaulted: a default only takes effect when the
  // property is autocreated, so this is what writes the single value a parameter
  // takes unless it says otherwise. The model reads an absent maximum as 1 as
  // well, for an entry stored as a node of another type.
  - minValues (LONG) = '0' autocreated
  - maxValues (LONG) = '1' autocreated

  // For a reference, the node type every value must be of. A parameter that names
  // none accepts any node that exists.
  - referenceType (STRING)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The values this parameter offers. A parameter declaring none takes whatever
  // its dataType accepts; one declaring options takes only their values.
  + * (wf:ParameterOption)

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// One of the values a parameter offers.
//
// The value is the durable half: it is what a diagram stores and what a handler
// reads, so renaming one changes the meaning of every diagram already written
// with it. The label is only what the author reads, and can be reworded freely.
[wf:ParameterOption] > data:EntityPart
  - sling:resourceType (STRING) = "wf/ParameterOption" mandatory autocreated protected

  // What a diagram picking this option stores
  - value (STRING) mandatory

  // What the author reads; the value itself when left out
  - label (STRING)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured
