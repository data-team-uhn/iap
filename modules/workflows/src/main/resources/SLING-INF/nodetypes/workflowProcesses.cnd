<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<iap = 'https://iap.uhndata.io/'>
<wf = 'https://iap.uhndata.io/wf/'>

//-----------------------------------------------------------------------------
//
// Mixins
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// Mixin that can be added to any nodetype to let workflows run over it. The
// instances live inside the thing they drive, rather than being pointed at from
// it, so that they are found, secured and deleted along with it.
[wf:WorkflowAttachable]
  mixin

  // The workflows running over this node. A container rather than loose children:
  // it keeps them out of the way of whatever else the host stores, gives one node
  // to place an ACL on, and is the single place the IGNORE below has to be said.
  + wf:instances (wf:WorkflowInstances) = wf:WorkflowInstances AUTOCREATED IGNORE

//-----------------------------------------------------------------------------
// The container of the workflow instances running over one resource.
//
// IGNORE, on both this node and the instances inside it, is load-bearing. Hosts
// are typically versionable (every iap:Entity is), and under the default
// on-parent-version setting checking one in would copy the whole live workflow
// into version storage, and restoring an earlier version would roll the workflow
// back with it — quietly un-approving things. Verified against Oak, not assumed.
[wf:WorkflowInstances] > iap:Content, rep:AccessControllable
  - sling:resourceType (STRING) = "wf/WorkflowInstances" mandatory autocreated protected

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The workflows running over the host resource
  + * (wf:WorkflowInstance) = wf:WorkflowInstance IGNORE

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured IGNORE

//-----------------------------------------------------------------------------
//
// Workflow Runtime Instances
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// A running or completed execution of a workflow definition.
[wf:WorkflowInstance] > iap:Entity
  - sling:resourceType (STRING) = "wf/WorkflowInstance" mandatory autocreated protected

  // The definition this instance was created from
  - workflowVersion (REFERENCE) mandatory

  // e.g. active, completed, failed, cancelled
  - status (STRING) mandatory

  // When this instance started
  - startTime (DATE)

  // When this instance finished
  - endTime (DATE)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Where each branch of the execution currently rests
  + * (wf:WorkflowToken) = wf:WorkflowToken

  // The data carried along by this execution
  + * (wf:Variable) = wf:Variable

  // The user tasks this execution has reached
  + * (wf:TaskInstance) = wf:TaskInstance

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// Tracks a single execution branch's current position in a workflow instance.
// The creation date is the inherited jcr:created.
[wf:WorkflowToken] > iap:EntityPart
  - sling:resourceType (STRING) = "wf/WorkflowToken" mandatory autocreated protected

  // elementId of the flow node currently occupied by this token
  - currentNodeId (STRING) mandatory

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A running instance of a user task within a workflow instance.
[wf:TaskInstance] > iap:Entity
  - sling:resourceType (STRING) = "wf/TaskInstance" mandatory autocreated protected

  // elementId of the wf:Activity this task was created from
  - taskDefinitionId (STRING) mandatory

  // Display name for this task
  - label (STRING) mandatory

  // User currently assigned to this task
  - assignee (STRING)

  // e.g. created, claimed, completed, cancelled
  - status (STRING) mandatory

  // When this task became active
  - startTime (DATE)

  // When this task was completed or cancelled
  - endTime (DATE)

  // Optional deadline for completing this task
  - dueDate (DATE)

  // Value recorded at completion; used for downstream gateway routing
  - outcome (STRING)

  // The decisions this task may be completed with, copied from its defining
  // activity when the task was raised. Copied rather than looked up, for the same
  // reason the label is: a task is decided on the terms it was raised with, not
  // on terms the definition may have grown since, and the person doing it cannot
  // necessarily read the definition at all. A task offering none is one there is
  // nothing to decide about — it is done, or it is not.
  - offeredOutcomes (STRING) multiple

  // The principals who may complete this task, as its defining activity named
  // them when the task was raised, with "@creator" answered against the host so
  // that every entry stands on its own. Recorded so that "what is waiting for
  // me" is a question about tasks, answerable without reading the definitions —
  // which the person owing the decision cannot necessarily do. It decides
  // nothing: the definition remains the authority every completion is checked
  // against, exactly as offeredOutcomes describes rather than enforces.
  - performers (STRING) multiple

  // Optional associated iap form
  - form (REFERENCE)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A named variable stored within a workflow instance. The variable's name is the
// node name, so that looking one up does not mean scanning every sibling.
[wf:Variable] > iap:EntityPart
  - sling:resourceType (STRING) = "wf/Variable" mandatory autocreated protected

  // Declared type: string, long, double, boolean, date, reference
  - dataType (STRING) mandatory

  - stringValue (STRING)
  - longValue (LONG)
  - doubleValue (DOUBLE)
  - booleanValue (BOOLEAN)
  - dateValue (DATE)
  - referenceValue (REFERENCE)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured
