<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:iap="https://iap.uhndata.io/bpmn"
                  id="createWorkflowDefinitions"
                  targetNamespace="https://iap.uhndata.io/systemWorkflows/createWorkflow">
  <bpmn:message id="createMessage" name="create" />
  <bpmn:process id="createWorkflow" name="Create a workflow definition" isExecutable="true">
    <bpmn:startEvent id="requested" iap:performers="iap-administrators" name="Workflow requested">
      <bpmn:messageEventDefinition id="createRequested" messageRef="createMessage" />
      <bpmn:outgoing>toCreate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toCreate" sourceRef="requested" targetRef="create" />
    <bpmn:serviceTask id="create" iap:entityType="wf:WorkflowDefinition" iap:handler="createEntity" name="Create the workflow">
      <bpmn:incoming>toCreate</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toDone" sourceRef="create" targetRef="done" />
    <bpmn:endEvent id="done" name="Workflow created">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="createWorkflowDiagram">
    <bpmndi:BPMNPlane id="createWorkflowPlane" bpmnElement="createWorkflow">
      <bpmndi:BPMNShape id="requestedShape" bpmnElement="requested">
        <dc:Bounds x="160" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="137" y="223" width="83" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="createShape" bpmnElement="create">
        <dc:Bounds x="250" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doneShape" bpmnElement="done">
        <dc:Bounds x="410" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="389" y="223" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toCreateEdge" bpmnElement="toCreate">
        <di:waypoint x="196" y="198" />
        <di:waypoint x="250" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDoneEdge" bpmnElement="toDone">
        <di:waypoint x="350" y="198" />
        <di:waypoint x="410" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
