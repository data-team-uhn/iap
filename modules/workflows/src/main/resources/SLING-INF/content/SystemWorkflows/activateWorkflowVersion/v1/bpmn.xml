<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:iap="https://iap.uhndata.io/bpmn"
                  xmlns:sv="http://www.jcp.org/jcr/sv/1.0"
                  id="activateWorkflowVersionDefinitions"
                  targetNamespace="https://iap.uhndata.io/systemWorkflows/activateWorkflowVersion">
  <bpmn:message id="activateMessage" name="activate" />
  <bpmn:process id="activateWorkflowVersion" name="Activate a workflow version" isExecutable="true">
    <bpmn:startEvent id="requested" iap:performers="iap-administrators" name="Activation requested">
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name"><sv:value>cond:SingleCondition</sv:value></sv:property>
          <sv:property sv:name="comparator"><sv:value>includes any</sv:value></sv:property>
          <sv:node sv:name="operandA">
            <sv:property sv:name="jcr:primaryType" sv:type="Name"><sv:value>cond:ConditionOperand</sv:value></sv:property>
            <sv:property sv:name="source"><sv:value>tags</sv:value></sv:property>
          </sv:node>
          <sv:node sv:name="operandB">
            <sv:property sv:name="jcr:primaryType" sv:type="Name"><sv:value>cond:ConditionOperand</sv:value></sv:property>
            <sv:property sv:name="value" sv:multiple="true"><sv:value>draft</sv:value><sv:value>trial</sv:value><sv:value>retired</sv:value></sv:property>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
      <bpmn:outgoing>toRetire</bpmn:outgoing>
      <bpmn:messageEventDefinition id="activateRequested" messageRef="activateMessage" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toRetire" sourceRef="requested" targetRef="retire" />
    <bpmn:serviceTask id="retire" iap:handler="retireActiveVersions" name="Retire the version this one supersedes">
      <bpmn:incoming>toRetire</bpmn:incoming>
      <bpmn:outgoing>toPromote</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toPromote" sourceRef="retire" targetRef="promote" />
    <bpmn:serviceTask id="promote" iap:handler="addTag" iap:replaceExisting="true" iap:tag="active" name="Make this the active version">
      <bpmn:incoming>toPromote</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toDone" sourceRef="promote" targetRef="done" />
    <bpmn:endEvent id="done" name="Version activated">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="activateWorkflowVersionDiagram">
    <bpmndi:BPMNPlane id="activateWorkflowVersionPlane" bpmnElement="activateWorkflowVersion">
      <bpmndi:BPMNShape id="requestedShape" bpmnElement="requested">
        <dc:Bounds x="160" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="131" y="223" width="94" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="retireShape" bpmnElement="retire">
        <dc:Bounds x="250" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="promoteShape" bpmnElement="promote">
        <dc:Bounds x="410" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doneShape" bpmnElement="done">
        <dc:Bounds x="570" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="548" y="223" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toRetireEdge" bpmnElement="toRetire">
        <di:waypoint x="196" y="198" />
        <di:waypoint x="250" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toPromoteEdge" bpmnElement="toPromote">
        <di:waypoint x="350" y="198" />
        <di:waypoint x="410" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDoneEdge" bpmnElement="toDone">
        <di:waypoint x="510" y="198" />
        <di:waypoint x="570" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
