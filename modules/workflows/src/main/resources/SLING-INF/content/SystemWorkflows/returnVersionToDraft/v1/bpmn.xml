<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:iap="https://iap.uhndata.io/bpmn"
                  xmlns:sv="http://www.jcp.org/jcr/sv/1.0"
                  id="returnVersionToDraftDefinitions"
                  targetNamespace="https://iap.uhndata.io/systemWorkflows/returnVersionToDraft">
  <bpmn:message id="returnToDraftMessage" name="returnToDraft" />
  <bpmn:process id="returnVersionToDraft" name="Return a workflow version to a draft" isExecutable="true">
    <bpmn:startEvent id="requested" iap:performers="iap-administrators" name="Redraft requested">
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name"><sv:value>cond:SingleCondition</sv:value></sv:property>
          <sv:property sv:name="comparator"><sv:value>includes</sv:value></sv:property>
          <sv:node sv:name="operandA">
            <sv:property sv:name="jcr:primaryType" sv:type="Name"><sv:value>cond:ConditionOperand</sv:value></sv:property>
            <sv:property sv:name="source"><sv:value>property</sv:value></sv:property>
            <sv:property sv:name="value" sv:multiple="true"><sv:value>state</sv:value></sv:property>
          </sv:node>
          <sv:node sv:name="operandB">
            <sv:property sv:name="jcr:primaryType" sv:type="Name"><sv:value>cond:ConditionOperand</sv:value></sv:property>
            <sv:property sv:name="value" sv:multiple="true"><sv:value>TRIAL</sv:value></sv:property>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
      <bpmn:outgoing>toMove</bpmn:outgoing>
      <bpmn:messageEventDefinition id="returnToDraftRequested" messageRef="returnToDraftMessage" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toMove" sourceRef="requested" targetRef="move" />
    <bpmn:serviceTask id="move" iap:fromStates="TRIAL" iap:handler="setVersionState" iap:toState="DRAFT" name="Return the version to a draft">
      <bpmn:incoming>toMove</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toDone" sourceRef="move" targetRef="done" />
    <bpmn:endEvent id="done" name="Version returned to a draft">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="returnVersionToDraftDiagram">
    <bpmndi:BPMNPlane id="returnVersionToDraftPlane" bpmnElement="returnVersionToDraft">
      <bpmndi:BPMNShape id="requestedShape" bpmnElement="requested">
        <dc:Bounds x="160" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="138" y="223" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="moveShape" bpmnElement="move">
        <dc:Bounds x="250" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doneShape" bpmnElement="done">
        <dc:Bounds x="410" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="364" y="223" width="127" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toMoveEdge" bpmnElement="toMove">
        <di:waypoint x="196" y="198" />
        <di:waypoint x="250" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDoneEdge" bpmnElement="toDone">
        <di:waypoint x="350" y="198" />
        <di:waypoint x="410" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
