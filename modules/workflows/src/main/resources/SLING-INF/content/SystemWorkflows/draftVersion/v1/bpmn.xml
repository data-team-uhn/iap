<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:iap="https://iap.uhndata.io/bpmn"
                  xmlns:sv="http://www.jcp.org/jcr/sv/1.0"
                  id="draftVersionDefinitions"
                  targetNamespace="https://iap.uhndata.io/systemWorkflows/draftVersion">
  <bpmn:message id="draftMessage" name="draft" />
  <bpmn:process id="draftVersion" name="Draft a copy of a workflow version" isExecutable="true">
    <bpmn:startEvent id="requested" iap:performers="iap-administrators" name="Copy requested">
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name"><sv:value>cond:SingleCondition</sv:value></sv:property>
          <sv:property sv:name="comparator"><sv:value>excludes</sv:value></sv:property>
          <sv:node sv:name="operandA">
            <sv:property sv:name="jcr:primaryType" sv:type="Name"><sv:value>cond:ConditionOperand</sv:value></sv:property>
            <sv:property sv:name="source"><sv:value>property</sv:value></sv:property>
            <sv:property sv:name="value" sv:multiple="true"><sv:value>state</sv:value></sv:property>
          </sv:node>
          <sv:node sv:name="operandB">
            <sv:property sv:name="jcr:primaryType" sv:type="Name"><sv:value>cond:ConditionOperand</sv:value></sv:property>
            <sv:property sv:name="value" sv:multiple="true"><sv:value>DRAFT</sv:value></sv:property>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
      <bpmn:outgoing>toDraft</bpmn:outgoing>
      <bpmn:messageEventDefinition id="draftRequested" messageRef="draftMessage" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toDraft" sourceRef="requested" targetRef="draft" />
    <bpmn:serviceTask id="draft" iap:handler="draftWorkflowVersion" name="Copy the version into a new draft">
      <bpmn:incoming>toDraft</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toDone" sourceRef="draft" targetRef="done" />
    <bpmn:endEvent id="done" name="Draft created">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="draftVersionDiagram">
    <bpmndi:BPMNPlane id="draftVersionPlane" bpmnElement="draftVersion">
      <bpmndi:BPMNShape id="requestedShape" bpmnElement="requested">
        <dc:Bounds x="160" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="145" y="223" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="draftShape" bpmnElement="draft">
        <dc:Bounds x="250" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doneShape" bpmnElement="done">
        <dc:Bounds x="410" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="398" y="223" width="61" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toDraftEdge" bpmnElement="toDraft">
        <di:waypoint x="196" y="198" />
        <di:waypoint x="250" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDoneEdge" bpmnElement="toDone">
        <di:waypoint x="350" y="198" />
        <di:waypoint x="410" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
