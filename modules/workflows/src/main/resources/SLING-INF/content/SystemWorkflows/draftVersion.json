{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Draft a copy of a workflow version",
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "tags": ["active"],
    "targetResourceType": "wf/WorkflowVersion",
    "description": "What happens when a version is carried forward: a new draft is opened beside it with a copy of its diagram, and of its graph where the diagram does not own one. This is how an active or retired version is changed at all - neither may be edited where it stands, because instances are following it, so what the manager offers instead is a copy that may be. A draft is not offered this, since it can simply be edited; a version with no lifecycle tag is, since copying it is the only way left to carry its diagram forward - which is why this start event's guard excludes drafts rather than listing the tags it allows.",
    "requested": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "requested",
      "label": "Copy requested",
      "messageName": "draft",
      "performers": ["iap-administrators"],
      "jcr:reference:flowNodeType": "/WorkflowTypes/MessageStartEvent",
      "cond:condition": {
        "jcr:primaryType": "cond:SingleCondition",
        "comparator": "excludes",
        "operandA": {
          "jcr:primaryType": "cond:ConditionOperand",
          "source": "tags"
        },
        "operandB": {
          "jcr:primaryType": "cond:ConditionOperand",
          "value": ["draft"]
        }
      },
      "toDraft": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDraft",
        "targetRef": "draft"
      }
    },
    "draft": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "draft",
      "label": "Copy the version into a new draft",
      "handler": "draftWorkflowVersion",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toMarkDraft": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toMarkDraft",
        "targetRef": "markDraft"
      }
    },
    "markDraft": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "markDraft",
      "label": "Mark it as a draft",
      "handler": "addTag",
      "tag": "draft",
      "replaceExisting": true,
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "done"
      }
    },
    "done": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "done",
      "label": "Draft created",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
