{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Create a workflow",
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "state": "ACTIVE",
    "targetResourceType": "wf/WorkflowsHomepage",
    "description": "What happens when a new workflow is asked for: create the definition, then its first version as a draft carrying the starting diagram the request brought, in the same commit - so a workflow never exists without a version to edit, and nothing runs until that version is activated. Being itself a workflow, this behavior can be extended per deployment - a validation step, a notification - by editing this definition rather than the platform. Authoring workflows is an administrative act, so the start event admits only iap-administrators; a deployment that wants a wider group changes that one property.",
    "requested": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "requested",
      "label": "Workflow requested",
      "messageName": "create",
      "performers": ["iap-administrators"],
      "jcr:reference:flowNodeType": "/WorkflowTypes/MessageStartEvent",
      "toCreate": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toCreate",
        "targetRef": "create"
      }
    },
    "create": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "create",
      "label": "Create the workflow",
      "handler": "createEntity",
      "entityType": "wf:WorkflowDefinition",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toVersion": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toVersion",
        "targetRef": "version"
      }
    },
    "version": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "version",
      "label": "Create its first version",
      "handler": "createWorkflowVersion",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "done"
      }
    },
    "done": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "done",
      "label": "Workflow created",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
