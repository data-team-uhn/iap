        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toSave",
        "targetRef": "save"
      }
    },
    "save": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "save",
      "label": "Record the new properties",
      "handler": "saveProperties",
      "editable": ["title"],
      "required": ["title"],
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "done"
      }
    },
    "done": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "done",
      "label": "Workflow saved",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
