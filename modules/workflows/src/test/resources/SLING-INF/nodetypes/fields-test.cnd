<test = 'https://iap.uhndata.io/test/'>
<data = 'https://iap.uhndata.io/data/'>

// Content with fields of every kind a patch can set, declared by name, a field of a kind it cannot, and anything
// else allowed only through the residual definition
[test:Item] > data:Content, mix:versionable, mix:referenceable
  - sling:resourceType (STRING) = "test/Item" mandatory autocreated protected
  - title (STRING) mandatory
  - note (STRING)
  - link (REFERENCE)
  - weakLink (WEAKREFERENCE)
  - related (REFERENCE) multiple
  - shape (STRING)
  - count (LONG)
  - ratio (DOUBLE)
  - flag (BOOLEAN)
  - keywords (STRING) multiple
  - sizes (LONG) multiple
  - due (DATE)
  - level (LONG) = '1' autocreated
  - weight (DOUBLE) = '0.5' autocreated
  - visible (BOOLEAN) = 'true' autocreated
  - colours (STRING) = 'red', 'blue' multiple autocreated
  - * (UNDEFINED)
  + * (nt:base) = nt:unstructured

// Containers of items: one keeping its items in order, one not
[test:Box] > data:Content, mix:versionable
  orderable
  - sling:resourceType (STRING) = "test/Box" mandatory autocreated protected
  + * (test:Item)

[test:Shelf] > data:Content
  - sling:resourceType (STRING) = "test/Shelf" mandatory autocreated protected
  + * (test:Item)
