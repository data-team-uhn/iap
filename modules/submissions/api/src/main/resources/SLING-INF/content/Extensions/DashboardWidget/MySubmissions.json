{
  "jcr:primaryType": "iap:Extension",
  "iap:extensionPointId": "iap/dashboard/widget",
  "iap:extensionName": "My Submissions",
  "iap:subtitle": "The submissions you created",
  "iap:extensionRenderURL": "asset:iap-submissions.MySubmissionsWidget.js",
  "iap:defaultOrder": 1,
  "iap:widgetWidth": "full",
  // The widget draws its own header, so that the action for raising a submission can sit on the
  // title's line rather than floating above the table. It still takes the title and subtitle from
  // this node, so they are declared in exactly one place.
  "iap:widgetHideHeader": true
}
