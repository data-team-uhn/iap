{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Save a submission's answers",
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "tags": ["active"],
    "targetResourceType": "sub/Submission",
    "requested": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "requested",
      "label": "Answers submitted",
      "messageName": "save",
      "performers": ["everyone"],
      "jcr:reference:flowNodeType": "/WorkflowTypes/MessageStartEvent",
      "toSave": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toSave",
        "targetRef": "save"
      }
    },
    "save": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "save",
      "label": "Record the answers",
      "handler": "saveAnswers",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toMark": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toMark",
        "targetRef": "mark"
      }
    },
    "mark": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "mark",
      "label": "Record whether anything is still missing",
      "handler": "markCompleteness",
      "jcr:reference:flowNodeType": "/WorkflowTypes/ServiceTask",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "done"
      }
    },
    "done": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "done",
      "label": "Answers saved",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
