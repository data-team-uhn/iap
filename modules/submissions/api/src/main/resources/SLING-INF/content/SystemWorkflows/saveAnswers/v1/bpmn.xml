<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="saveAnswersDefinitions"
                  targetNamespace="https://iap.uhndata.io/systemWorkflows/saveAnswers">
  <bpmn:message id="saveMessage" name="save" />
  <bpmn:process id="saveAnswers" name="Save a submission's answers" isExecutable="true">
    <bpmn:startEvent id="requested" name="Answers submitted">
      <bpmn:messageEventDefinition id="saveRequested" messageRef="saveMessage" />
      <bpmn:outgoing>toSave</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toSave" sourceRef="requested" targetRef="save" />
    <bpmn:serviceTask id="save" name="Record the answers">
      <bpmn:incoming>toSave</bpmn:incoming>
      <bpmn:outgoing>toValidate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toValidate" sourceRef="save" targetRef="validate" />
    <bpmn:serviceTask id="validate" name="Check what the answers say">
      <bpmn:incoming>toValidate</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toDone" sourceRef="validate" targetRef="done" />
    <bpmn:endEvent id="done" name="Answers saved">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="saveAnswersDiagram">
    <bpmndi:BPMNPlane id="saveAnswersPlane" bpmnElement="saveAnswers">
      <bpmndi:BPMNShape id="requestedShape" bpmnElement="requested">
        <dc:Bounds x="160" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="136" y="223" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="saveShape" bpmnElement="save">
        <dc:Bounds x="250" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="validateShape" bpmnElement="validate">
        <dc:Bounds x="410" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doneShape" bpmnElement="done">
        <dc:Bounds x="570" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="552" y="223" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toSaveEdge" bpmnElement="toSave">
        <di:waypoint x="196" y="198" />
        <di:waypoint x="250" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toValidateEdge" bpmnElement="toValidate">
        <di:waypoint x="350" y="198" />
        <di:waypoint x="410" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDoneEdge" bpmnElement="toDone">
        <di:waypoint x="510" y="198" />
        <di:waypoint x="570" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
