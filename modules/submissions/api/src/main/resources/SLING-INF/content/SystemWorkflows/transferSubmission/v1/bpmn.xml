<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:iap="https://iap.uhndata.io/bpmn"
                  xmlns:sv="http://www.jcp.org/jcr/sv/1.0"
                  id="transferSubmissionDefinitions"
                  targetNamespace="https://iap.uhndata.io/systemWorkflows/transferSubmission">
  <bpmn:message id="transferMessage" name="transfer" />
  <bpmn:process id="transferSubmission" name="Transfer a submission to another site" isExecutable="true">
    <bpmn:startEvent id="requested" iap:performers="iap-administrators" name="Transfer requested">
      <bpmn:extensionElements>
        <sv:node sv:name="cond:condition">
          <sv:property sv:name="jcr:primaryType" sv:type="Name"><sv:value>cond:SingleCondition</sv:value></sv:property>
          <sv:property sv:name="comparator"><sv:value>excludes</sv:value></sv:property>
          <sv:node sv:name="operandA">
            <sv:property sv:name="jcr:primaryType" sv:type="Name"><sv:value>cond:ConditionOperand</sv:value></sv:property>
            <sv:property sv:name="source"><sv:value>tags</sv:value></sv:property>
          </sv:node>
          <sv:node sv:name="operandB">
            <sv:property sv:name="jcr:primaryType" sv:type="Name"><sv:value>cond:ConditionOperand</sv:value></sv:property>
            <sv:property sv:name="value" sv:multiple="true"><sv:value>transferred</sv:value></sv:property>
          </sv:node>
        </sv:node>
      </bpmn:extensionElements>
      <bpmn:outgoing>toSend</bpmn:outgoing>
      <bpmn:messageEventDefinition id="transferRequested" messageRef="transferMessage" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toSend" sourceRef="requested" targetRef="send" />
    <bpmn:serviceTask id="send" iap:handler="transferSubmission" name="Send it to the other site">
      <bpmn:incoming>toSend</bpmn:incoming>
      <bpmn:outgoing>toMark</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toMark" sourceRef="send" targetRef="mark" />
    <bpmn:serviceTask id="mark" iap:handler="addTag" iap:replaceExisting="true" iap:tag="transferred" name="Mark it as transferred">
      <bpmn:incoming>toMark</bpmn:incoming>
      <bpmn:outgoing>toArchive</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toArchive" sourceRef="mark" targetRef="archive" />
    <bpmn:serviceTask id="archive" iap:handler="delete" name="Archive this copy">
      <bpmn:incoming>toArchive</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toDone" sourceRef="archive" targetRef="done" />
    <bpmn:endEvent id="done" name="Submission transferred">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="transferSubmissionDiagram">
    <bpmndi:BPMNPlane id="transferSubmissionPlane" bpmnElement="transferSubmission">
      <bpmndi:BPMNShape id="requestedShape" bpmnElement="requested">
        <dc:Bounds x="160" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="135" y="223" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sendShape" bpmnElement="send">
        <dc:Bounds x="250" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="markShape" bpmnElement="mark">
        <dc:Bounds x="410" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="archiveShape" bpmnElement="archive">
        <dc:Bounds x="570" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doneShape" bpmnElement="done">
        <dc:Bounds x="730" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="700" y="223" width="96" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toSendEdge" bpmnElement="toSend">
        <di:waypoint x="196" y="198" />
        <di:waypoint x="250" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toMarkEdge" bpmnElement="toMark">
        <di:waypoint x="350" y="198" />
        <di:waypoint x="410" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toArchiveEdge" bpmnElement="toArchive">
        <di:waypoint x="510" y="198" />
        <di:waypoint x="570" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDoneEdge" bpmnElement="toDone">
        <di:waypoint x="670" y="198" />
        <di:waypoint x="730" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
