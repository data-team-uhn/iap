<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:iap="https://iap.uhndata.io/bpmn"
                  id="createSubmissionDefinitions"
                  targetNamespace="https://iap.uhndata.io/systemWorkflows/createSubmission">
  <bpmn:message id="createMessage" name="create" />
  <bpmn:process id="createSubmission" name="Raise a submission" isExecutable="true">
    <bpmn:startEvent id="requested" name="Submission requested">
      <bpmn:messageEventDefinition id="createRequested" messageRef="createMessage" />
      <bpmn:outgoing>toCreate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toCreate" sourceRef="requested" targetRef="create" />
    <bpmn:serviceTask id="create" iap:handler="createSubmission" name="Create the submission">
      <bpmn:incoming>toCreate</bpmn:incoming>
      <bpmn:outgoing>toMark</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toMark" sourceRef="create" targetRef="markCompleteness" />
    <bpmn:serviceTask id="markCompleteness" iap:handler="markCompleteness" name="Record what it still asks for">
      <bpmn:incoming>toMark</bpmn:incoming>
      <bpmn:outgoing>toStart</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toStart" sourceRef="markCompleteness" targetRef="start" />
    <bpmn:serviceTask id="start" iap:handler="startWorkflow" name="Put it under its workflow">
      <bpmn:incoming>toStart</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toDone" sourceRef="start" targetRef="done" />
    <bpmn:endEvent id="done" name="Submission created">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="createSubmissionDiagram">
    <bpmndi:BPMNPlane id="createSubmissionPlane" bpmnElement="createSubmission">
      <bpmndi:BPMNShape id="requestedShape" bpmnElement="requested">
        <dc:Bounds x="160" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="133" y="223" width="91" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="createShape" bpmnElement="create">
        <dc:Bounds x="250" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="markCompletenessShape" bpmnElement="markCompleteness">
        <dc:Bounds x="410" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="startShape" bpmnElement="start">
        <dc:Bounds x="570" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doneShape" bpmnElement="done">
        <dc:Bounds x="730" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="706" y="223" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toCreateEdge" bpmnElement="toCreate">
        <di:waypoint x="196" y="198" />
        <di:waypoint x="250" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toMarkEdge" bpmnElement="toMark">
        <di:waypoint x="350" y="198" />
        <di:waypoint x="410" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toStartEdge" bpmnElement="toStart">
        <di:waypoint x="510" y="198" />
        <di:waypoint x="570" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDoneEdge" bpmnElement="toDone">
        <di:waypoint x="670" y="198" />
        <di:waypoint x="730" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
