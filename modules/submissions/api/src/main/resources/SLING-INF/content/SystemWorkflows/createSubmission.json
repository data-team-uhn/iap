{
  "jcr:primaryType": "wf:WorkflowDefinition",
  "title": "Create a submission",
  "v1": {
    "jcr:primaryType": "wf:WorkflowVersion",
    "version": "1.0",
    "tags": ["active"],
    "targetResourceType": "sub/SubmissionsHomepage",
    "requested": {
      "jcr:primaryType": "wf:StartEvent",
      "elementId": "requested",
      "label": "Submission requested",
      "messageName": "create",
      "performers": ["everyone"],
      "jcr:reference:flowNodeType": "/WorkflowTypes/MessageStartEvent",
      "toCreate": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toCreate",
        "targetRef": "create"
      }
    },
    "create": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "create",
      "label": "Create the submission",
      "handler": "createSubmission",
      "jcr:reference:flowNodeType": "/WorkflowTypes/CreateSubmission",
      "toParts": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toParts",
        "targetRef": "parts"
      }
    },
    "parts": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "parts",
      "label": "Give each item asked for a part of its own",
      "handler": "createParts",
      "jcr:reference:flowNodeType": "/WorkflowTypes/CreateParts",
      "toMark": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toMark",
        "targetRef": "mark"
      }
    },
    "mark": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "mark",
      "label": "Record whether anything is still missing",
      "handler": "markCompleteness",
      "jcr:reference:flowNodeType": "/WorkflowTypes/MarkCompleteness",
      "toStart": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toStart",
        "targetRef": "start"
      }
    },
    "start": {
      "jcr:primaryType": "wf:Activity",
      "elementId": "start",
      "label": "Put it under its workflow",
      "handler": "startWorkflow",
      "workflowFrom": "schemaVersion/workflow",
      "jcr:reference:flowNodeType": "/WorkflowTypes/StartWorkflow",
      "toDone": {
        "jcr:primaryType": "wf:SequenceFlow",
        "elementId": "toDone",
        "targetRef": "done"
      }
    },
    "done": {
      "jcr:primaryType": "wf:EndEvent",
      "elementId": "done",
      "label": "Submission created",
      "jcr:reference:flowNodeType": "/WorkflowTypes/EndEvent"
    }
  }
}
