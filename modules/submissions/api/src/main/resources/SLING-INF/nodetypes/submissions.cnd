<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<tag = 'https://iap.uhndata.io/tag/'>
<data = 'https://iap.uhndata.io/data/'>
<wf = 'https://iap.uhndata.io/wf/'>
<sub = 'https://iap.uhndata.io/sub/'>

//-----------------------------------------------------------------------------
//
// Submissions: what submitters file.
//
// A submission is filed against one sch:SchemaVersion, and holds what that
// version asks for: answers to its questions, documents for its document
// requirements, and reviews of its approval requirements. Only the submitted
// values are stored here. How a part is shown and checked is read from the
// schema part it references.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// The /Submissions homepage.
[sub:SubmissionsHomepage] > data:EntityHomepage
  - sling:resourceType (STRING) = "sub/SubmissionsHomepage" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "data/EntityHomepage" mandatory autocreated protected

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The submissions. They are filed in the sling:Folder buckets of a prefix
  // tree, and one can also be placed here directly.
  + * (sub:Submission) = sub:Submission

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// What a submitter files against one schema version. The workflow instances
// it goes through live inside it, in the wf:instances child that the
// wf:WorkflowAttachable mixin autocreates.
[sub:Submission] > data:Entity, wf:WorkflowAttachable, tag:Boundary
  - sling:resourceType (STRING) = "sub/Submission" mandatory autocreated protected

  // The submission's title, as people read it
  - title (STRING) mandatory

  // The sch:SchemaVersion this submission answers
  - schemaVersion (REFERENCE) mandatory

  // The sch:Schema that version belongs to. It repeats the version's parent,
  // so that finding every submission against a schema needs no join.
  - schema (REFERENCE) mandatory

  // Its state is its `lifecycle` tag, such as `draft`, `submitted`,
  // `in-review`, `approved` or `rejected`. A submission is created as a
  // draft, and its workflow moves it on.

  // How far reading answers out of the attached documents has got: running,
  // done or failed, and a short message for the person looking at it.
  // Set by the extraction module's steps and its reading job.
  - extractionStatus (STRING)
  - extractionMessage (STRING)

  // Which reading job has the reading, so only one job pays a model to read
  // the documents: the claim, and the Sling job id that holds it
  - extractionReadingClaimed (BOOLEAN)
  - extractionReadingClaimedBy (STRING)

  // Whether the last reading ended with the request unable to go on, such as
  // a document that is not what the request asks for; extractionMessage says
  // why. Removed when a new reading starts
  - extractionBlocked (BOOLEAN)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The submitter's answers to the schema's questions
  + * (sub:Answer) = sub:Answer

  // The attached documents, such as the signed patient consent
  + * (sub:Document) = sub:Document

  // Feedback on the submission: reviews, AI screenings and discussions
  + * (sub:Feedback)

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// The answer to one question of the schema. The question says what type the
// value has and what it means. Comments reference it.
[sub:Answer] > data:EntityPart, mix:referenceable, mix:lastModified
  // The extraction runs are kept in the order they ran, the newest last
  orderable

  - sling:resourceType (STRING) = "sub/Answer" mandatory autocreated protected

  // The sch:Question this answers
  - question (REFERENCE) mandatory

  // The value or values the submitter typed or accepted. An extracted answer
  // stays in its extraction until the submitter accepts or edits it, so no
  // answer is attributed to a submitter who never saw it.
  - value (UNDEFINED)
  - value (UNDEFINED) multiple

  // What extraction made of this question, one child per run
  + * (sub:Extraction) = sub:Extraction

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// One extraction run against one answer: what a model read out of the submitted
// documents, and what it read to get there. The run's own existence is the
// record that extraction happened, so a run that found nothing is a node
// without an extractedAnswer rather than a flag, and jcr:created is when it ran.
[sub:Extraction] > data:EntityPart
  - sling:resourceType (STRING) = "sub/Extraction" mandatory autocreated protected

  // The document revisions this run read, whether or not it found an answer in
  // them. A newer revision of one of them makes the run stale.
  - sources (REFERENCE) multiple

  // The values the model read out of the documents: one for a question taking
  // one, one per item for a list. Absent when the run found nothing
  - extractedAnswer (STRING) multiple

  // How sure the model is, from 0 to 1
  - confidence (DOUBLE)

  // The model's explanation of how it got there
  - reasoning (STRING)

  // Whether the submitter said the quoted passage does not support the
  // answer. A note about the evidence only: it does not accept or reject the answer
  - evidenceRejected (BOOLEAN)

  // How far the submitter's own value ended up from extractedAnswer: the raw
  // edit distance, and that distance as a percentage of the extracted answer's
  // length. Both are written when the submitter accepts or edits the extracted
  // answer, and are absent until then.
  - editDistance (LONG)
  - percentageDistance (DOUBLE)

  // The context backing the extracted answer
  + * (sub:Context) = sub:Context

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A quote, and where it comes from: a passage of a document, or an answer. It
// backs an extracted answer or a comment, or marks where a section's passage
// starts or ends. The quote stays linked to its source, so a reader can be
// sent to that spot.
[sub:Context] > data:EntityPart
  - sling:resourceType (STRING) = "sub/Context" mandatory autocreated protected

  // The document revision or the answer the quote comes from. Weak, so either
  // can be removed without first deleting every quote taken from it.
  - source (WEAKREFERENCE)

  // The quoted text. Every stored quote was found in the document. A quote that
  // was not found is not evidence, so it is dropped, and the answer's
  // confidence goes down instead.
  - quote (STRING)

  // A little of the text just before and after the quote, so the passage can
  // still be found when the same words occur more than once
  - prefix (STRING)
  - suffix (STRING)

  // The nearest heading above the quoted text
  - header (STRING)

  // The page the model gave for the quote; it is not checked. Absent for documents
  // that carry no page markers, e.g. anything that came in as DOCX.
  - page (LONG)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A document of the submission, such as the signed patient consent. It is
// empty until something is uploaded into it. Comments reference it.
[sub:Document] > data:EntityPart, mix:referenceable, mix:lastModified
  // The versions are kept in the order they were uploaded
  orderable

  - sling:resourceType (STRING) = "sub/Document" mandatory autocreated protected

  // The document's name, as people read it
  - title (STRING)

  // What the document contains
  - description (STRING)

  // The sch:Requirement this document fulfills, usually a
  // sch:DocumentRequirement
  - fulfills (REFERENCE)

  // The revisions of this document, each holding one upload
  + * (sub:DocumentVersion) = sub:DocumentVersion

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// One revision of a document: one uploaded file, and everything parsing made
// of it. Uploading a replacement adds a version, and leaves the file a
// reviewer has already read as it was. A revision's number is its position
// among the document's versions, and is not stored.
[sub:DocumentVersion] > data:EntityPart, mix:referenceable, mix:lastModified
  - sling:resourceType (STRING) = "sub/DocumentVersion" mandatory autocreated protected

  // The file this revision consists of. It is not mandatory, so the version
  // can be created before the upload is stored.
  + file (sub:File) = sub:File

  // Where the sections the requirement expects are found in this revision
  + * (sub:Section) = sub:Section

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// One uploaded file, and everything parsing derived from it.
[sub:File] > data:EntityPart, mix:referenceable, mix:lastModified
  - sling:resourceType (STRING) = "sub/File" mandatory autocreated protected

  // Where the parse got to: queued, completed or failed. Only the parse job
  // record uses "active". Kept here as well as on the job, so that a file that
  // failed parsing does not look like one that was never parsed.
  - parseStatus (STRING)
  - parseError (STRING)
  // The parse job the file was queued under, and where the upload was put on
  // the shared volume for the daemon. The job record is deleted once its
  // outcome has been read in, so these are what is left to trace a parse.
  - parseJobId (STRING)
  - sharedPath (STRING)

  // The token count of the Markdown, estimated as its length in characters
  // divided by 4
  - tokens (LONG)

  // The upload, exactly as it was received
  + uploadedFile (nt:file) = nt:file

  // What the parse produced that is kept: the Markdown the extraction reads,
  // and the PDF of this document. pdfFile exists only when LibreOffice made a
  // PDF from an office file; a PDF upload is kept once, as uploadedFile. The
  // .docx and anything else made along the way is not kept.
  + markdownFile (nt:file) = nt:file
  + pdfFile (nt:file) = nt:file

  // Allowed for other renditions; the pipeline stores none today
  + * (nt:file) = nt:file

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// Where a section a document is expected to contain is found in one revision
// of it, such as the funding section of a study protocol. Each upload is
// parsed into Markdown of its own, so sections are kept per revision. A
// section that was looked for and not found has no passages. One that was
// never looked for has no node.
[sub:Section] > data:EntityPart, mix:referenceable
  // The passages are kept in the order the document presents them
  orderable
  - sling:resourceType (STRING) = "sub/Section" mandatory autocreated protected

  // The sch:SectionRequirement this section fulfills
  - fulfills (REFERENCE)

  // How the passages were found: "heading" when one of the requirement's
  // headings matched, "model" when an LLM located them, "pickedHeading" when a
  // person named the heading that holds the section, "selectedText" when a
  // person selected the text itself. A selection follows no heading, so the
  // document may not follow the expected protocol.
  - method (STRING)

  // How sure the model that found the section is, from 0 to 1; set only with
  // "model"
  - confidence (DOUBLE)

  // The person who checked where the section is: who picked or selected it,
  // or who confirmed that a section not found is indeed missing
  - checkedBy (STRING)

  // The stretches of the document the section consists of: usually one, and
  // several when it is split, such as a budget table moved to an appendix
  + * (sub:Passage) = sub:Passage

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// One stretch of a document's Markdown, from where it starts to where it ends.
[sub:Passage] > data:EntityPart
  - sling:resourceType (STRING) = "sub/Passage" mandatory autocreated protected

  // Its first words, usually a heading
  + start (sub:Context) = sub:Context mandatory

  // Its last words, included in the passage
  + end (sub:Context) = sub:Context mandatory

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// Feedback on a submission, of one of three kinds: a reviewer's binding
// sub:Review, the AI's sub:Screening, or a sub:Discussion that binds nothing.
// Comments reference it. It is abstract, and concrete node types extend it.
[sub:Feedback] > data:EntityPart, mix:referenceable, mix:lastModified
  abstract

  // The comments and assessments are kept in the order they were added
  orderable

  - sling:resourceSuperType (STRING) = "sub/Feedback" mandatory autocreated protected

  // Whether this feedback decides anything. Each kind sets it, so a new
  // binding kind counts without code naming it.
  - binding (BOOLEAN) = 'false' mandatory autocreated protected

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Questions and comments raised in this feedback
  + * (sub:Comment) = sub:Comment

  // The assessments of the topics the approval requirement lists
  + * (sub:Assessment) = sub:Assessment

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A reviewer's binding feedback: it addresses a requirement, and can grant it.
[sub:Review] > sub:Feedback
  - sling:resourceType (STRING) = "sub/Review" mandatory autocreated protected

  - binding (BOOLEAN) = 'true' mandatory autocreated protected

  // The reviewer's user id
  - reviewer (STRING) mandatory

  // The sch:Requirement this review addresses, usually a
  // sch:ApprovalRequirement
  - requirement (REFERENCE)

  // Its state is its `review` tag: `in-progress`, `changes-requested`,
  // `approved` or `rejected`. A review that is neither approved nor rejected
  // is still open.

//-----------------------------------------------------------------------------
// The AI's feedback: a first look at what the submission says, for the
// submitter while the request is being written and for the reviewers beside
// their own. It is a guide, never a decision. jcr:created is when it ran.
[sub:Screening] > sub:Feedback
  - sling:resourceType (STRING) = "sub/Screening" mandatory autocreated protected

  // A short summary of the whole screening
  - summary (STRING)

//-----------------------------------------------------------------------------
// A person's feedback that binds nothing: a question or a remark from someone
// who is not deciding.
[sub:Discussion] > sub:Feedback
  - sling:resourceType (STRING) = "sub/Discussion" mandatory autocreated protected

//-----------------------------------------------------------------------------
// One assessment of one sch:Topic, in a reviewer's review or in the AI's
// screening. Comments reference it.
[sub:Assessment] > data:EntityPart, mix:referenceable, mix:lastModified
  // The comments are kept in the order they were raised
  orderable

  - sling:resourceType (STRING) = "sub/Assessment" mandatory autocreated protected

  // The sch:Topic this assesses
  - topic (REFERENCE) mandatory

  // The verdict on the topic
  - value (STRING)

  // A short summary of this assessment
  - summary (STRING)

  // What the assessment read: document revisions and answers. A newer revision
  // or a changed answer makes it stale. Weak, so a source can be removed
  // without first deleting the assessments that read it.
  - sources (WEAKREFERENCE) multiple

  // How sure an automated assessment is, from 0 to 1
  - confidence (DOUBLE)

  // The comments raised about this topic, the AI's concerns among them
  + * (sub:Comment) = sub:Comment

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A comment or a question raised in some feedback, such as a concern the AI
// found, with what it is about and the context that shows it. Either may be
// empty, since something missing quotes nothing.
[sub:Comment] > data:EntityPart, mix:lastModified
  // The replies and the context are kept in the order they were added
  orderable

  - sling:resourceType (STRING) = "sub/Comment" mandatory autocreated protected

  // The comment text
  - text (STRING) mandatory

  // Who wrote this comment. It can differ from jcr:createdBy: a comment or a
  // reply can come from an external site, created here by a service user on
  // the author's behalf.
  - author (STRING) mandatory

  // What this comment is about: answers or documents of the submission, or
  // the questions and requirements of its schema. A comment about something
  // missing points at the question or requirement that asks for it. Weak, so
  // a part can be removed without first unlinking it from every comment.
  - subjects (WEAKREFERENCE) multiple

  // What kind of point it makes, such as a gap, a conflict or a concern
  - kind (STRING)

  // What would address it, when the author can say
  - suggestion (STRING)

  // Whether the submitter has addressed this comment
  - resolved (BOOLEAN) = false

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The discussion thread attached to this comment: the reviewer and the
  // submitter replying back and forth
  + * (sub:Reply) = sub:Reply

  // The context that shows what this comment is about
  + * (sub:Context) = sub:Context

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// One message in the discussion thread attached to a comment, such as the
// submitter answering a reviewer's question, or the reviewer following up.
[sub:Reply] > data:EntityPart, mix:lastModified
  - sling:resourceType (STRING) = "sub/Reply" mandatory autocreated protected

  // The reply text
  - text (STRING) mandatory

  // Who wrote this reply. It can differ from jcr:createdBy, as a comment's
  // author can.
  - author (STRING) mandatory

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured
