<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<tag = 'https://iap.uhndata.io/tag/'>
<data = 'https://iap.uhndata.io/data/'>
<wf = 'https://iap.uhndata.io/wf/'>
<sub = 'https://iap.uhndata.io/sub/'>

//-----------------------------------------------------------------------------
//
// Submissions: what submitters file.
//
// A submission is created against a specific sch:SchemaVersion, and its
// content mirrors what that schema version asks for: answers referencing
// the schema's questions, documents fulfilling the schema's document
// requirements, and reviews addressing the schema's approval requirements.
// Only the submitted values are stored here; the display and validation
// metadata is read live from the referenced schema parts.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// Homepage node for the /Submissions root path.
[sub:SubmissionsHomepage] > data:EntityHomepage
  - sling:resourceType (STRING) = "sub/SubmissionsHomepage" mandatory autocreated protected
  - sling:resourceSuperType (STRING) = "data/EntityHomepage" mandatory autocreated protected

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Contains submissions
  + * (sub:Submission) = sub:Submission

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A submission filed by a submitter against a specific schema version. The
// workflow instances driving its lifecycle live inside it, in the wf:instances
// child that the wf:WorkflowAttachable mixin autocreates.
[sub:Submission] > data:Entity, wf:WorkflowAttachable, tag:Boundary
  - sling:resourceType (STRING) = "sub/Submission" mandatory autocreated protected

  // Title of the submission
  - title (STRING) mandatory

  // The sch:SchemaVersion this submission answers
  - schemaVersion (REFERENCE) mandatory

  // The lifecycle state (draft, submitted, in-review, approved, rejected) is not a dedicated
  // property: it is a `lifecycle`-category tag in the inherited `tags` property, defined under
  // /Tags and managed by the attached user workflow. Whoever creates a submission is expected
  // to tag it `draft`.

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The submitter's answers to the schema questions
  + * (sub:Answer) = sub:Answer

  // Attached documents, e.g. the signed patient consent
  + * (sub:Document) = sub:Document

  // Feedback on the submission: binding reviews, AI screenings and discussions
  + * (sub:Feedback)

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// The answer to a single schema question. Only simple storage: the value's
// expected type and meaning are dictated by the referenced question.
// Referenceable so that comments can target it.
[sub:Answer] > data:EntityPart, mix:referenceable, mix:lastModified
  // The extraction runs are orderable, so they are presented in the order they
  // ran, the newest last.
  orderable

  - sling:resourceType (STRING) = "sub/Answer" mandatory autocreated protected

  // The sch:Question this answers
  - question (REFERENCE) mandatory

  // The submitted value(s): only what the submitter typed or approved. An
  // extracted answer stays in its extraction until they accept or edit it, so
  // that no answer is ever attributed to a submitter who never saw it.
  - value (UNDEFINED)
  - value (UNDEFINED) multiple

  // What extraction made of this question, one child per run
  + * (sub:Extraction) = sub:Extraction

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility;
  // file-type answers store their upload as nt:file children
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// One extraction run against one answer: what a model read out of the submitted
// documents, and what it read to get there. The run's own existence is the
// record that extraction happened, so a run that found nothing is a node
// without an extractedAnswer rather than a flag, and jcr:created is when it ran.
[sub:Extraction] > data:EntityPart
  - sling:resourceType (STRING) = "sub/Extraction" mandatory autocreated protected

  // The document revisions this run read, whether or not it found an answer in
  // them. A revision is what a submitter replaces, so this is what tells a
  // later reader that an extraction is stale.
  - sources (REFERENCE) multiple

  // The answer the model read out of the documents, absent when the run found
  // nothing
  - extractedAnswer (STRING)

  // How sure the model is, 0..1
  - confidence (DOUBLE)

  // The model's explanation of how it got there
  - reasoning (STRING)

  // How far the submitter's own value ended up from extractedAnswer: the raw
  // edit distance, and that distance as a percentage of the extracted answer's
  // own length. Written when the submitter accepts or edits the extracted
  // answer, and absent until then, since an extraction nobody has acted on has
  // nothing to be compared against.
  - editDistance (LONG)
  - percentageDistance (DOUBLE)

  // The context backing the extracted answer
  + * (sub:Context) = sub:Context

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// The context a quote comes from, backing an extracted answer or a comment: a
// passage of a document, or an answer. A node rather than a plain string, so
// the quote stays linked to where it came from and the UI can send the reader
// to that spot.
[sub:Context] > data:EntityPart
  - sling:resourceType (STRING) = "sub/Context" mandatory autocreated protected

  // The document revision or the answer the quote comes from. Weak, so either
  // can be removed without first deleting every quote taken from it.
  - source (WEAKREFERENCE)

  // The quoted text
  - quote (STRING)

  // A little of the text just before and after the quote, so the passage can
  // still be found when the same words occur more than once
  - prefix (STRING)
  - suffix (STRING)

  // The nearest detected header of the quoted text
  - header (STRING)

  // Page in the source PDF, when known. Absent for documents that carry no
  // page markers, e.g. anything that came in as DOCX.
  - page (LONG)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A document attached to the submission, e.g. the signed patient consent.
// Referenceable so that comments can target it.
[sub:Document] > data:EntityPart, mix:referenceable, mix:lastModified
  // The list of versions is orderable, so the history is presented in a
  // deliberate (chronological) sequence.
  orderable

  - sling:resourceType (STRING) = "sub/Document" mandatory autocreated protected

  // Human-readable name for this document
  - title (STRING)

  // Optional description of what this document contains
  - description (STRING)

  // The sch:Requirement (typically a sch:DocumentRequirement) this document fulfills
  - fulfills (REFERENCE)

  // The revisions of this document; the uploads themselves live under a version
  + * (sub:DocumentVersion) = sub:DocumentVersion

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// One revision of a document: exactly one uploaded file, and everything the
// parsing pipeline made of it. Uploading a replacement adds a version instead
// of overwriting the file a reviewer has already read. A revision's number is
// its position in the document's ordered list of versions, so it is not stored.
[sub:DocumentVersion] > data:EntityPart, mix:referenceable, mix:lastModified
  - sling:resourceType (STRING) = "sub/DocumentVersion" mandatory autocreated protected

  // The one file this revision consists of. Not declared mandatory, so the
  // version node can be created before the upload lands, but a version without
  // it is incomplete.
  + file (sub:File) = sub:File

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A single uploaded file plus everything the parsing pipeline derived from it.
// Referenceable so that comments and extracted answers can point at the
// document they were read from.
[sub:File] > data:EntityPart, mix:referenceable, mix:lastModified
  - sling:resourceType (STRING) = "sub/File" mandatory autocreated protected

  // Where the parse got to: queued, active, completed or failed. Kept here as
  // well as on the parse job so that a file that failed parsing does not look
  // like one that was never parsed.
  - parseStatus (STRING)
  - parseError (STRING)

  // Token count of the Markdown. A cheap character heuristic, len(md) // 4;
  // no ML tokenizer is involved.
  - tokens (LONG)

  // The upload, exactly as it was received
  + uploadedFile (nt:file) = nt:file

  // The renditions LibreOffice and Docling produced: the .md and other
  // versions of the document created during the parsing process
  + * (nt:file) = nt:file

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// Feedback on a submission, of one of three kinds: a reviewer's binding
// sub:Review, the AI's sub:Screening, or a sub:Discussion that binds nothing.
// Referenceable so that comments can target it.
[sub:Feedback] > data:EntityPart, mix:referenceable, mix:lastModified
  abstract

  // The comments and assessments are orderable, so the feedback is presented
  // in a deliberate (chronological) sequence.
  orderable

  - sling:resourceSuperType (STRING) = "sub/Feedback" mandatory autocreated protected

  // Whether this feedback decides anything. Each kind sets it, so that a new
  // binding kind counts without code naming it.
  - binding (BOOLEAN) = 'false' mandatory autocreated protected

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Questions and comments raised in this feedback
  + * (sub:Comment) = sub:Comment

  // The assessments of the criteria the approval requirement lists
  + * (sub:Assessment) = sub:Assessment

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A reviewer's binding feedback: it addresses a requirement, and can grant it.
[sub:Review] > sub:Feedback
  - sling:resourceType (STRING) = "sub/Review" mandatory autocreated protected

  - binding (BOOLEAN) = 'true' mandatory autocreated protected

  // Principal name of the reviewer
  - reviewer (STRING) mandatory

  // The sch:Requirement (typically a sch:ApprovalRequirement) this review addresses
  - requirement (REFERENCE)

  // The review's state (in-progress, changes-requested, approved, rejected) is not a dedicated
  // property: it is a `review`-category tag in the inherited `tags` property, defined under
  // /Tags. Whoever opens a review is expected to tag it `in-progress`; a review whose tags name
  // no final decision (approved/rejected) counts as still open.

//-----------------------------------------------------------------------------
// The AI's feedback: a first look at what the submission says, shown to the
// submitter while the request is being written and to the reviewers beside
// their own. It is a guide, never a decision. jcr:created is when it ran.
[sub:Screening] > sub:Feedback
  - sling:resourceType (STRING) = "sub/Screening" mandatory autocreated protected

  // A short summary of the whole screening
  - summary (STRING)

//-----------------------------------------------------------------------------
// A person's feedback that binds nothing: a question or a remark from someone
// who is not deciding.
[sub:Discussion] > sub:Feedback
  - sling:resourceType (STRING) = "sub/Discussion" mandatory autocreated protected

//-----------------------------------------------------------------------------
// One assessment of a single sch:AssessmentCriteria, in a reviewer's review or
// in the AI's feedback. Referenceable so that comments can target it.
[sub:Assessment] > data:EntityPart, mix:referenceable, mix:lastModified
  // The comments are orderable, so they are shown in the order they were
  // raised.
  orderable

  - sling:resourceType (STRING) = "sub/Assessment" mandatory autocreated protected

  // The sch:AssessmentCriteria this assesses
  - assessmentCriteria (REFERENCE) mandatory

  // Has the reviewer looked at the criteria for this assessment?
  - value (STRING)

  // A short summary of this assessment
  - summary (STRING)

  // What the assessment read: document revisions and answers. A newer revision
  // or a changed answer makes it stale. Weak, so a source can be removed
  // without first deleting the assessments that read it.
  - sources (WEAKREFERENCE) multiple

  // How sure an automated assessment is, 0..1
  - confidence (DOUBLE)

  // The comments raised about these criteria, the AI's concerns among them
  + * (sub:Comment) = sub:Comment

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A comment or question raised in some feedback, a concern the AI found among
// them, with what it is about and the context that shows it. Either may be
// empty: something missing quotes nothing.
[sub:Comment] > data:EntityPart, mix:lastModified
  // The replies and the context are orderable, so they are presented in a
  // deliberate (chronological) sequence.
  orderable

  - sling:resourceType (STRING) = "sub/Comment" mandatory autocreated protected

  // The comment text
  - text (STRING) mandatory

  // Identifies who wrote this comment. Not necessarily the
  // same as jcr:createdBy: comments and replies can originate from an
  // external site, created here by an integration service user on the
  // actual author's behalf.
  - author (STRING) mandatory

  // What this comment is about: answers or documents of the submission, or
  // the questions and requirements of its schema. Something missing points at
  // the question or requirement where it belongs. Weak, so a part can be
  // removed without first unlinking it from every comment.
  - subjects (WEAKREFERENCE) multiple

  // What kind of point it makes, e.g. a gap, a conflict or a concern
  - kind (STRING)

  // What would address it, when the author can say
  - suggestion (STRING)

  // Whether the submitter has addressed this comment
  - resolved (BOOLEAN) = false

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The discussion thread attached to this comment: the reviewer and the
  // submitter replying back and forth
  + * (sub:Reply) = sub:Reply

  // The context that shows what this comment is about
  + * (sub:Context) = sub:Context

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A single message in the discussion thread attached to a comment,
// e.g. the submitter responding to a reviewer's question, or the reviewer
// following up.
[sub:Reply] > data:EntityPart, mix:lastModified
  - sling:resourceType (STRING) = "sub/Reply" mandatory autocreated protected

  // The reply text
  - text (STRING) mandatory

  // Identifies who wrote this reply (the reviewer or the submitter). Not
  // necessarily the same as jcr:createdBy: see sub:Comment.author.
  - author (STRING) mandatory

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured
