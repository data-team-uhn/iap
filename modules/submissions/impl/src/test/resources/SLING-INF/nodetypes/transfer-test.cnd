<test = 'https://iap.uhndata.io/test/'>
<wf = 'https://iap.uhndata.io/wf/'>

// The shapes a submission is made of, without the rest of the platform's types: a referenceable,
// versionable entity whose type stamps a protected property of its own, requires a reference, and
// gives itself a child on creation.
[test:Submission] > nt:unstructured, mix:referenceable, mix:versionable, mix:created, mix:lastModified
  - kind (STRING) = 'submission' mandatory autocreated protected
  - schema (REFERENCE) mandatory
  + meta (nt:unstructured) = nt:unstructured autocreated

// Orderable, as sub:Document is, so that the order of its versions means something
[test:Part] > nt:unstructured, mix:referenceable, mix:created, mix:lastModified
  orderable

[test:Marker]
  mixin

// Lets a node whose own type takes no properties of its own, such as nt:file, take some anyway
[test:Annotated]
  mixin
  - * (UNDEFINED)
