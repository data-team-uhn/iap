{
  "bundles": [
    {
      "id": "${project.groupId}:iap-submissions-api:${project.version}",
      "start-order": "28"
    },
    {
      "id": "${project.groupId}:${project.artifactId}:${project.version}",
      "start-order": "28"
    }
  ],
  "configurations": {
    // Serves a submission at /Submissions/by-id/<uuid>, without the prefix tree it is filed in. Mounted beside the
    // tree, so that creating a submission never reaches this provider, which cannot store anything.
    "io.uhndata.iap.utils.internal.PrefixTreeResourceProvider~submissions": {
      "provider.root": "/Submissions/by-id",
      "provider.mode": "overlay"
    },
    "org.apache.sling.jcr.repoinit.RepositoryInitializer~submissions": {
      "service.ranking:Integer": 300,
      "scripts": [
        "create path (sub:SubmissionsHomepage) /Submissions",
        // Everyone may read the homepage node, and nothing below it. Sling resolves the resource a POST is sent to
        // before it dispatches, so an unreadable /Submissions would answer 404 before the workflow engine could
        // decide. Who may read a submission is the workflow's to grant. A grant on a submission reaches it by path
        // without one on the prefix tree's buckets above it.
        "set ACL on /Submissions \n allow jcr:read for everyone restriction(rep:ntNames,sub:SubmissionsHomepage) \n end"
      ]
    }
  }
}
