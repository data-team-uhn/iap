<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.uhndata.iap</groupId>
    <artifactId>iap-submissions</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>iap-submissions-impl</artifactId>
  <packaging>bundle</packaging>
  <name>IAP - Submissions - Implementation</name>
  <description>The submissions UI, and the handlers and endpoints serving it.</description>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>iap-submissions-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>iap-schemas-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The save workflow records whether a submission is still missing an answer by tagging it, and the
         handlers read its lifecycle state through the same model -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>iap-tags-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The form projection leaves out whatever does not currently apply, which the schema's
         conditions decide -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>iap-conditions</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>iap-data-model-content-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- A Submission is an Entity, so reading one back through the model needs the hierarchy on the
         compile classpath even where this code never names Entity itself -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>iap-data-model-entities-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The handlers are service tasks the workflow engine calls, and a submission is raised and
         filled in by a workflow rather than by writing to it -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>iap-workflows</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Submissions are filed under a prefix tree, so that no single parent holds every one -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>iap-java-utils</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.sling</groupId>
      <artifactId>org.apache.sling.api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.sling</groupId>
      <artifactId>org.apache.sling.servlets.annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.json</groupId>
      <artifactId>jakarta.json-api</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
    </dependency>
    <dependency>
      <groupId>javax.jcr</groupId>
      <artifactId>jcr</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.sling</groupId>
      <artifactId>org.apache.sling.testing.sling-mock.junit5</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.parsson</groupId>
      <artifactId>parsson</artifactId>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.framework</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
