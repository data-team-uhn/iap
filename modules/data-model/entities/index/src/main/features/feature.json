{
  "bundles":[
    {
      "id":"${project.groupId}:${project.artifactId}:${project.version}",
      "start-order":"25"
    }
  ],
  "configurations":{
    "org.apache.sling.jcr.repoinit.RepositoryInitializer~entityindex":{
      "service.ranking:Integer":300,
      "scripts": [
        // In certain environments, this script gets executed before the main forms repoinit does, so we must make sure the paths we reference are created.
        "create path (iap:EntitysHomepage) /Submissions \n create path (iap:SchemasHomepage) /Schemas \n create path (iap:SubjectsHomepage) /Subjects",
        // The index maintenance service only needs to read the indexed content
        "create service user entity-index \n set ACL for entity-index \n allow jcr:read on /Submissions,/Schemas,/Subjects \n end"
      ]
    },
    "org.apache.sling.serviceusermapping.impl.ServiceUserMapperImpl.amended~entityindex":{
      "user.mapping":[
        "io.uhndata.iap.entities-index:indexer=[entity-index]"
      ]
    }
  }
}
