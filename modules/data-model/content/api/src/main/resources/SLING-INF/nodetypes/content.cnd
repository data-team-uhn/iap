<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<iap = 'https://iap.uhndata.io/'>

//-----------------------------------------------------------------------------
//
// Content: the base node type for all things IAP.
//
// This is an abstract node type which isn't supposed to be used directly,
// only as a helper for other concrete node types.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// Marks content that can carry tags: named markers defined by iap:TagDefinition
// nodes under /Tags; see the tags module. The mixin declares the tagging
// properties once — every iap:Content node carries it through its supertypes,
// and other node types, e.g. nt:file, become taggable by adding the mixin.
// All the properties are unversioned (IGNORE): tags are living metadata
// describing the current status of the content, so changing them must neither
// require a checkout nor be reverted by a restore.
[iap:Taggable]
  mixin

  // Tags explicitly placed on this content, e.g. "incomplete" or "sensitive",
  // each value the name of a tag defined under /Tags.
  - tags (STRING) multiple IGNORE

  // Tags derived from this content's surroundings — copied from its
  // descendants (`aggregated` tags) or from its ancestors (`inheritable`
  // tags) — or computed from its own content, all materialized here at commit
  // time by the tag propagation editor so that queries and status displays can
  // read them without walking the tree. One property per processing phase.
  // System-maintained, do not write manually.
  - aggregatedTags (STRING) multiple IGNORE
  - inheritedTags (STRING) multiple IGNORE
  - computedTags (STRING) multiple IGNORE

  // Set while the derived tags above cannot be trusted, and absent when they
  // can. Two values, and the difference is who wrote it:
  //   failed       a tag processor threw, so the values are the last ones
  //                computed successfully and may be out of date
  //   recomputing  something determined the values are untrustworthy and asked
  //                for them to be redone
  // Whichever it is, the next commit reaching the node recomputes it in full
  // and removes this property. `recomputing` should therefore never be seen at
  // rest: if it is, a commit was interrupted between the request and the
  // recomputation.
  // Deliberately NOT constrained to those two values. A CND value constraint is
  // enforced against commit hooks too, and failing a commit is exactly what the
  // tagging code must never do -- a wrong value here would stop users saving
  // their work. The writers share constants instead.
  // System-maintained, do not write manually.
  - tagComputationState (STRING) IGNORE

//-----------------------------------------------------------------------------
// Marks a container that `aggregated` tags travel up to and no further: it
// carries the aggregate of everything beneath it, and contributes nothing to
// its own ancestors.
//
// Aggregation needs a top, and the top has to be declared rather than
// discovered. Without one, an aggregated tag placed anywhere climbs to the
// repository root, which has two consequences: the value stops answering any
// question anybody can ask — the root's aggregate is the union of every
// aggregated tag in the repository — and every session that writes such
// content has to hold property-write permission on every ancestor up to the
// root, which no deployment grants and none should. A boundary bounds both.
//
// Placed where the aggregate has a reader: an entity homepage, which is what
// lists and filters its entities on the derived properties. Anything else that
// contains content but is not an entity homepage — an archive, say — may
// declare itself one too.
[iap:TagBoundary]
  mixin

[iap:Content] > sling:Folder, sling:Resource, sling:ResourceSuperType, iap:Taggable
  // Attributes:

  // This is an abstract node type
  abstract

  // Properties

  - sling:resourceSuperType (STRING) = "iap/Content" mandatory autocreated protected
