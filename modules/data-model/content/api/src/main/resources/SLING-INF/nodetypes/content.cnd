<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<iap = 'https://iap.uhndata.io/'>

//-----------------------------------------------------------------------------
//
// Content: the base node type for all things IAP.
//
// This is an abstract node type which isn't supposed to be used directly,
// only as a helper for other concrete node types.
//
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// Marks content that can carry tags: named markers defined by iap:TagDefinition
// nodes under /Tags; see the tags module. The mixin declares the tagging
// properties once — every iap:Content node carries it through its supertypes,
// and other node types, e.g. nt:file, become taggable by adding the mixin.
// All the properties are unversioned (IGNORE): tags are living metadata
// describing the current status of the content, so changing them must neither
// require a checkout nor be reverted by a restore.
[iap:Taggable]
  mixin

  // Tags explicitly placed on this content, e.g. "incomplete" or "sensitive",
  // each value the name of a tag defined under /Tags.
  - tags (STRING) multiple IGNORE

  // Tags derived from this content's surroundings — copied from its
  // descendants (`aggregated` tags) or from its ancestors (`inheritable`
  // tags) — or computed from its own content, all materialized here at commit
  // time by the tag propagation editor so that queries and status displays can
  // read them without walking the tree. One property per processing phase.
  // System-maintained, do not write manually.
  - aggregatedTags (STRING) multiple IGNORE
  - inheritedTags (STRING) multiple IGNORE
  - computedTags (STRING) multiple IGNORE

  // Set when the derived tags above could not be recomputed, e.g. because a
  // tag processor failed: they are then the last ones successfully computed,
  // and may be out of date until the computation is run again. Never fails a
  // commit, so that user data is saved even when tagging misbehaves.
  // System-maintained, do not write manually.
  - tagComputationFailed (BOOLEAN) IGNORE

[iap:Content] > sling:Folder, sling:Resource, sling:ResourceSuperType, iap:Taggable
  // Attributes:

  // This is an abstract node type
  abstract

  // Properties

  - sling:resourceSuperType (STRING) = "iap/Content" mandatory autocreated protected
