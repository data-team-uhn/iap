<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<metric = 'https://iap.uhndata.io/metric/'>
<data = 'https://iap.uhndata.io/data/'>
<oak = 'http://jackrabbit.apache.org/oak/ns/1.0'>

//-----------------------------------------------------------------------------
// Homepage node for the /Metrics root path.
[metric:Homepage] > data:Content, rep:AccessControllable
  - sling:resourceType (STRING) = "metric/Homepage" mandatory autocreated protected

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Contains the tracked metrics
  + * (metric:Metric) = metric:Metric

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A single tracked metric.
//
// The current count is kept in the protected oak:counter property, maintained
// by the repository itself: committing an oak:increment value on a node with
// the mix:atomicCounter mixin atomically adds it to oak:counter, without
// concurrent updates conflicting or getting lost.
//
// Do NOT add mix:atomicCounter to the supertypes below, tempting as it looks:
// the editor maintaining the counter reads the jcr:mixinTypes *property* and
// looks for the literal name in it, so a supertype declaration does not enable
// it -- and it makes matters worse, because isNodeType() then already answers
// true, which turns addMixin() into a no-op, so nothing can ever write the
// property. The counter would silently never count. The mixin has to be listed
// in jcr:mixinTypes when the node is created, which is what MetricsManager does.
[metric:Metric] > data:Content
  - sling:resourceType (STRING) = "metric/Metric" mandatory autocreated protected

  // Human-readable name for this metric
  - label (STRING) mandatory

  // Optional description of what this metric counts
  - description (STRING)

  // Optional category used to group related metrics in reports
  - category (STRING)

  // The order this metric appears in, among the metrics of its own category
  - defaultOrder (LONG) = "0" mandatory autocreated

  // Who may see this metric: everyone, or only administrators
  - accessLevel (STRING) = 'public' mandatory autocreated < 'public', 'admin'

  // Snapshot of the counter taken at the last roll-over, the base for delta computations
  - previousValue (LONG) = '0' mandatory autocreated

  // The amount accumulated during the last closed period, frozen at the last roll-over
  - lastDelta (LONG)

  // When the counter was last incremented
  - lastUpdated (DATE)

  // When the last roll-over happened
  - lastRollover (DATE)

  // Quartz cron expression for automatic periodic roll-overs, e.g. '0 0 0 * * ?' for nightly
  - rolloverSchedule (STRING)

  // Transient increment request, consumed by the repository when committed
  - oak:increment (LONG)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured
