<sling = 'http://sling.apache.org/jcr/sling/1.0'>
<metric = 'https://iap.uhndata.io/metric/'>
<data = 'https://iap.uhndata.io/data/'>
<oak = 'http://jackrabbit.apache.org/oak/ns/1.0'>

//-----------------------------------------------------------------------------
// The node that holds every metric, at /Metrics.
[metric:Homepage] > data:Content, rep:AccessControllable
  - sling:resourceType (STRING) = "metric/Homepage" mandatory autocreated protected

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // The metrics
  + * (metric:Metric) = metric:Metric

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured

//-----------------------------------------------------------------------------
// A metric: a named count, and the reporting periods that roll-overs close.
//
// Oak keeps the count in the protected oak:counter property. Saving an
// oak:increment value on a node that lists mix:atomicCounter in its
// jcr:mixinTypes adds the value to oak:counter.
//
// Do not declare mix:atomicCounter as a supertype below. Oak looks for its
// name in the jcr:mixinTypes property, where a supertype is not listed. The
// supertype also makes addMixin() do nothing, since the node is then already
// of that type, and the count never changes. The mixin is listed when the
// node is created instead.
[metric:Metric] > data:Content
  - sling:resourceType (STRING) = "metric/Metric" mandatory autocreated protected

  // The name of this metric as people read it, such as "Submitted proposals"
  - label (STRING) mandatory

  // What this metric counts
  - description (STRING)

  // The category that groups related metrics in reports, such as "Submissions"
  - category (STRING)

  // Where this metric is shown among the metrics of its category, lower first
  - defaultOrder (LONG) = "0" mandatory autocreated

  // Who may see this metric: everyone, or only the admin user
  - accessLevel (STRING) = 'public' mandatory autocreated < 'public', 'admin'

  // The count at the last roll-over, where the current period started
  - previousValue (LONG) = '0' mandatory autocreated

  // The amount counted in the last closed period
  - lastDelta (LONG)

  // When the count was last incremented
  - lastUpdated (DATE)

  // When the last roll-over happened
  - lastRollover (DATE)

  // When to roll over, as a Quartz cron expression, such as '0 0 0 * * ?' for
  // every midnight; none if the metric is rolled over only on request
  - rolloverSchedule (STRING)

  // An amount to add to the count; Oak removes it as it saves the change
  - oak:increment (LONG)

  // Allow any other properties for extensibility
  - * (UNDEFINED)
  - * (UNDEFINED) multiple

  // Allow any other children for extensibility
  + * (nt:base) = nt:unstructured
