{
  // IDE/typecheck configuration for the per-module frontend sources. The runtime build
  // does not use this file: modules are aggregated by aggregated-frontend/webpack_script.py
  // into aggregated-frontend/src/main/frontend/src/<module>/ and compiled there with the
  // aggregated tsconfig.json, which this file extends so the compiler options stay defined
  // in exactly one place. Only the module mappings differ: the aggregated build flattens
  // every module under a single "@iap/*" -> "./src/*" mapping, while here each namespace has
  // to point at the module's real source tree.
  //
  // Resolving the dependencies those sources import (react, @mui/material, ...) needs a
  // node_modules reachable from the project root, because TypeScript looks packages up by
  // walking parent directories of the importing *file*, not of this config. Mapping them
  // through "paths" instead does not work: a "paths" target is resolved as a plain file path,
  // so packages that declare their types only through package.json "exports" (react-router,
  // for one) are reported as missing. webpack_script.py therefore maintains a ./node_modules
  // symlink to the aggregated frontend's real one; run a build (or `yarn aggregate`) once
  // before typechecking a fresh clone.
  "extends": "./aggregated-frontend/src/main/frontend/tsconfig.json",
  "compilerOptions": {
    // One entry per module with frontend sources. webpack_script.py fails the build if a
    // module it aggregated is missing here, so this list cannot silently fall behind.
    "paths": {
      "@iap/deletion/*": ["./modules/deletion/src/main/frontend/src/*"],
      "@iap/frontend-commons/*": ["./modules/frontend-commons/src/main/frontend/src/*"],
      "@iap/homepage/*": ["./modules/homepage/src/main/frontend/src/*"],
      "@iap/login/*": ["./modules/login/src/main/frontend/src/*"],
      "@iap/submissions/*": ["./modules/submissions/src/main/frontend/src/*"],
      "@iap/test-data/*": ["./test-data/src/main/frontend/src/*"],
      "@iap/ui-extension/*": ["./modules/ui-extension/src/main/frontend/src/*"],
      "@iap/workflows/*": ["./modules/workflows/src/main/frontend/src/*"]
    }
  },
  "include": [
    "modules/*/src/main/frontend/src/**/*",
    "modules/*/src/test/frontend/src/**/*",
    "test-data/src/main/frontend/src/**/*",
    "test-data/src/test/frontend/src/**/*"
  ],
  "exclude": ["node_modules"]
}
